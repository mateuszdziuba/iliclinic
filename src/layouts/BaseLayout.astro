---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import locationsData from '../data/locations.json';

interface Props {
  title: string;
  description?: string;
  location?: 'pruszkow' | 'ostroleka';
  canonical?: string;
  robots?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  hideCookieBanner?: boolean;
  enableClientRouter?: boolean;
  enableSmoothScroll?: boolean;
  jsonLd?: object | object[];
  ogImage?: string;
}

const {
  title,
  description = 'ili Clinic — gabinety medycyny estetycznej w Pruszkowie i Ostrołęce. Botoks, kwas hialuronowy, depilacja laserowa, dermapen i więcej.',
  location,
  canonical,
  robots = 'index, follow',
  hideHeader = false,
  hideFooter = false,
  hideCookieBanner = false,
  enableClientRouter = true,
  enableSmoothScroll = true,
  jsonLd,
  ogImage = '/images/pruszkow-clinic-hero.jpg',
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = 'https://iliclinic.pl';
const canonicalUrl = canonical ?? `${siteUrl}${currentPath}`;
const fullTitle = /ili clinic/i.test(title) ? title : `${title} | ili Clinic`;
const locationData = location ? locationsData[location] : null;
const baseSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "ili Clinic",
    "url": siteUrl,
    "email": "kontakt@iliclinic.pl",
    "telephone": "+48 660 176 464",
    "sameAs": [
      "https://www.facebook.com/ili.clinic",
      "https://www.instagram.com/patricia.kosmetolog/"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "name": "ili Clinic",
    "url": siteUrl,
    "inLanguage": "pl-PL",
    "publisher": {
      "@id": `${siteUrl}/#organization`
    }
  }
];
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!DOCTYPE html>
<html lang="pl" data-location={location || 'ostroleka'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:site_name" content="ili Clinic" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:image:alt" content={fullTitle} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
  <meta name="twitter:image:alt" content={fullTitle} />

  <!-- Geo meta (local SEO) -->
  {locationData && (
    <>
      <meta name="geo.region" content="PL" />
      <meta name="geo.placename" content={(locationData as any).address?.city} />
      <meta name="geo.position" content={`${(locationData as any).geo?.lat};${(locationData as any).geo?.lng}`} />
      <meta name="ICBM" content={`${(locationData as any).geo?.lat}, ${(locationData as any).geo?.lng}`} />
    </>
  )}

  <!-- Robots -->
  <meta name="robots" content={robots} />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify([...baseSchemas, ...pageSchemas])} />

  <!-- Cinematic Fonts -->
  <Font
    cssVariable="--font-ili-heading"
    preload={[
      { weight: 300, style: 'normal', subset: 'latin-ext' },
    ]}
  />
  <Font
    cssVariable="--font-ili-body"
    preload={[
      { weight: 300, style: 'normal', subset: 'latin-ext' },
      { weight: 400, style: 'normal', subset: 'latin-ext' },
    ]}
  />

  <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function gtag() {
      window.dataLayer.push(arguments);
    };

    window.gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });

    try {
      if (localStorage.getItem('ili_cookie_consent') === 'accepted') {
        window.gtag('consent', 'update', {
          analytics_storage: 'granted',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
      }
    } catch {}
  </script>
  <script type="text/partytown">
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-P85B9F3');
  </script>
  {enableClientRouter && <ClientRouter />}
</head>
<body class="min-h-screen flex flex-col font-body selection:bg-accent/20 selection:text-primary">
  {!hideHeader && <Header location={location} currentPath={currentPath} />}

  <main class="flex-1">
    <slot />
  </main>

  {!hideFooter && <Footer location={location} />}
  {!hideCookieBanner && <CookieBanner />}

  {enableSmoothScroll && (
    <script>
      import Lenis from '@studio-freight/lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      let lenis: InstanceType<typeof Lenis> | null = null;
      let lenisTicker: ((time: number) => void) | null = null;

      function initLenis() {
        if (lenisTicker) gsap.ticker.remove(lenisTicker);
        lenis?.destroy();

        lenis = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 1,
          touchMultiplier: 2,
        });

        lenis.on('scroll', ScrollTrigger.update);

        lenisTicker = (time: number) => lenis!.raf(time * 1000);
        gsap.ticker.add(lenisTicker);
        gsap.ticker.lagSmoothing(0);
      }

      document.addEventListener('astro:before-swap', () => {
        ScrollTrigger.getAll().forEach(st => st.kill());
      });

      document.addEventListener('astro:page-load', initLenis);
      initLenis();
    </script>
  )}
</body>
</html>
