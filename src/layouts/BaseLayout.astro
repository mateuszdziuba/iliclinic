---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import locationsData from '../data/locations.json';

interface Props {
  title: string;
  description?: string;
  location?: 'pruszkow' | 'ostroleka';
  canonical?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  jsonLd?: object | object[];
  ogImage?: string;
}

const {
  title,
  description = 'Ili Clinic — gabinet medycyny estetycznej w Pruszkowie i Ostrołęce. Botoks, kwas hialuronowy, depilacja laserowa, dermapen i więcej.',
  location,
  canonical,
  hideHeader = false,
  hideFooter = false,
  jsonLd,
  ogImage = '/images/hero-clinic.jpg',
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = 'https://iliclinic.pl';
const canonicalUrl = canonical ?? `${siteUrl}${currentPath}`;
const fullTitle = `${title} | Ili Clinic`;
const locationData = location ? locationsData[location] : null;
---

<!DOCTYPE html>
<html lang="pl" data-location={location || 'ostroleka'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:site_name" content="Ili Clinic" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

  <!-- Geo meta (local SEO) -->
  {locationData && (
    <>
      <meta name="geo.region" content="PL" />
      <meta name="geo.placename" content={(locationData as any).address?.city} />
      <meta name="geo.position" content={`${(locationData as any).geo?.lat};${(locationData as any).geo?.lng}`} />
      <meta name="ICBM" content={`${(locationData as any).geo?.lat}, ${(locationData as any).geo?.lng}`} />
    </>
  )}

  <!-- Robots -->
  <meta name="robots" content="index, follow" />

  <!-- JSON-LD Structured Data -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])} />
  )}

  <!-- Cinematic Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <ClientRouter />
</head>
<body class="min-h-screen flex flex-col font-body selection:bg-accent/20 selection:text-primary">
  {!hideHeader && <Header location={location} currentPath={currentPath} />}

  <main class="flex-1">
    <slot />
  </main>

  {!hideFooter && <Footer location={location} />}
  <CookieBanner />

  <script>
    import Lenis from '@studio-freight/lenis';
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    let lenis: InstanceType<typeof Lenis> | null = null;
    let lenisTicker: ((time: number) => void) | null = null;

    function initLenis() {
      // Clean up previous instance before re-initializing
      if (lenisTicker) gsap.ticker.remove(lenisTicker);
      lenis?.destroy();

      lenis = new Lenis({
        duration: 1.2,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1,
        touchMultiplier: 2,
      });

      lenis.on('scroll', ScrollTrigger.update);

      lenisTicker = (time: number) => lenis!.raf(time * 1000);
      gsap.ticker.add(lenisTicker);
      gsap.ticker.lagSmoothing(0);
    }

    // Kill all ScrollTrigger instances before each page swap
    document.addEventListener('astro:before-swap', () => {
      ScrollTrigger.getAll().forEach(st => st.kill());
    });

    // Re-init Lenis after each page transition and on first load
    document.addEventListener('astro:page-load', initLenis);
    initLenis();
  </script>
</body>
</html>
