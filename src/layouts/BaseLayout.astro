---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  location?: 'pruszkow' | 'ostroleka';
  canonical?: string;
}

const { 
  title, 
  description = 'Iliclinic - Gabinet Medycyny Estetycznej w Pruszkowie i Ostrołęce', 
  location,
  canonical 
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
  
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} | Iliclinic</title>
</head>
<body class="min-h-screen flex flex-col">
  <Header location={location} currentPath={currentPath} />
  
  <main class="flex-1">
    <slot />
  </main>
  
  <Footer location={location} />
</body>
</html>
