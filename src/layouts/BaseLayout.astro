---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import locationsData from '../data/locations.json';

interface Props {
  title: string;
  description?: string;
  location?: 'pruszkow' | 'ostroleka';
  canonical?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  hideCookieBanner?: boolean;
  enableClientRouter?: boolean;
  enableSmoothScroll?: boolean;
  jsonLd?: object | object[];
  ogImage?: string;
}

const {
  title,
  description = 'ili Clinic — gabinety medycyny estetycznej w Pruszkowie i Ostrołęce. Botoks, kwas hialuronowy, depilacja laserowa, dermapen i więcej.',
  location,
  canonical,
  hideHeader = false,
  hideFooter = false,
  hideCookieBanner = false,
  enableClientRouter = true,
  enableSmoothScroll = true,
  jsonLd,
  ogImage = '/images/hero-clinic.jpg',
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = 'https://iliclinic.pl';
const fontStylesheet = 'https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,300;0,400;1,300&family=Work+Sans:wght@300;400;500;600&display=swap';
const canonicalUrl = canonical ?? `${siteUrl}${currentPath}`;
const fullTitle = /ili clinic/i.test(title) ? title : `${title} | ili Clinic`;
const locationData = location ? locationsData[location] : null;
const baseSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "ili Clinic",
    "url": siteUrl,
    "email": "kontakt@iliclinic.pl",
    "telephone": "+48 660 176 464",
    "sameAs": [
      "https://www.facebook.com/ili.clinic",
      "https://www.instagram.com/patricia.kosmetolog/"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "name": "ili Clinic",
    "url": siteUrl,
    "inLanguage": "pl-PL",
    "publisher": {
      "@id": `${siteUrl}/#organization`
    }
  }
];
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!DOCTYPE html>
<html lang="pl" data-location={location || 'ostroleka'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:site_name" content="ili Clinic" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${ogImage}`} />
  <meta property="og:image:alt" content={fullTitle} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
  <meta name="twitter:image:alt" content={fullTitle} />

  <!-- Geo meta (local SEO) -->
  {locationData && (
    <>
      <meta name="geo.region" content="PL" />
      <meta name="geo.placename" content={(locationData as any).address?.city} />
      <meta name="geo.position" content={`${(locationData as any).geo?.lat};${(locationData as any).geo?.lng}`} />
      <meta name="ICBM" content={`${(locationData as any).geo?.lat}, ${(locationData as any).geo?.lng}`} />
    </>
  )}

  <!-- Robots -->
  <meta name="robots" content="index, follow" />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify([...baseSchemas, ...pageSchemas])} />

  <!-- Cinematic Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href={fontStylesheet} as="style" />
  <link rel="stylesheet" href={fontStylesheet} media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href={fontStylesheet} /></noscript>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {enableClientRouter && <ClientRouter />}
</head>
<body class="min-h-screen flex flex-col font-body selection:bg-accent/20 selection:text-primary">
  {!hideHeader && <Header location={location} currentPath={currentPath} />}

  <main class="flex-1">
    <slot />
  </main>

  {!hideFooter && <Footer location={location} />}
  {!hideCookieBanner && <CookieBanner />}

  {enableSmoothScroll && (
    <script>
      import Lenis from '@studio-freight/lenis';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      let lenis: InstanceType<typeof Lenis> | null = null;
      let lenisTicker: ((time: number) => void) | null = null;

      function initLenis() {
        if (lenisTicker) gsap.ticker.remove(lenisTicker);
        lenis?.destroy();

        lenis = new Lenis({
          duration: 1.2,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          gestureOrientation: 'vertical',
          smoothWheel: true,
          wheelMultiplier: 1,
          touchMultiplier: 2,
        });

        lenis.on('scroll', ScrollTrigger.update);

        lenisTicker = (time: number) => lenis!.raf(time * 1000);
        gsap.ticker.add(lenisTicker);
        gsap.ticker.lagSmoothing(0);
      }

      document.addEventListener('astro:before-swap', () => {
        ScrollTrigger.getAll().forEach(st => st.kill());
      });

      document.addEventListener('astro:page-load', initLenis);
      initLenis();
    </script>
  )}
</body>
</html>
