---
import locations from '../data/locations.json';

interface Props {
  location?: 'pruszkow' | 'ostroleka';
  currentPath: string;
}

const { location, currentPath } = Astro.props;

const basePath = location ? `/${location}` : '';

const navLinks = [
  { label: 'O nas', href: `${basePath}/o-nas` },
  { label: 'Zabiegi', href: `${basePath}/zabiegi` },
  { label: 'Sklep', href: 'https://ilishop.pl', external: true },
  { label: 'Kontakt', href: `${basePath}/kontakt` },
];

const otherLocation = location === 'pruszkow' ? 'ostroleka' : '';
const otherLocationData = otherLocation ? locations[otherLocation as keyof typeof locations] : null;

// Determine if we need to show the location switch (only if we have a valid location)
const validLocation = location === 'pruszkow' || location === 'ostroleka';
---

<header 
  id="cinematic-nav" 
  class="fixed top-6 left-1/2 -translate-x-1/2 z-50 w-[95%] max-w-5xl rounded-full transition-all duration-700 bg-surface/0 text-text-main border border-text-main/0"
>
  <div class="px-6 py-4">
    <div class="flex items-center justify-between">
      <!-- Logo Image -->
      <a href={validLocation ? `/${location}` : '/'} class="flex items-center gap-3 group">
        <img 
          src="/images/logo-black.png" 
          alt="Ili Clinic" 
          class="h-10 w-auto"
        />
        {validLocation && (
          <span class="hidden sm:inline-block font-body text-[10px] tracking-widest uppercase opacity-60 border border-current rounded-full px-2 py-0.5">
            {locations[location as keyof typeof locations]?.name}
          </span>
        )}
      </a>

      <!-- Desktop Navigation -->
      {validLocation && (
        <nav class="hidden md:flex items-center gap-8 absolute left-1/2 -translate-x-1/2">
          {navLinks.map(link => (
            <a 
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener' : undefined}
              class="font-body text-xs tracking-wider uppercase opacity-70 hover:opacity-100 transition-opacity"
            >
              {link.label}
            </a>
          ))}
        </nav>
      )}

      <!-- Right Side / CTA -->
      <div class="flex items-center gap-4">
        {validLocation && otherLocationData && (
          <a 
            href={`/${otherLocation}`}
            class="hidden lg:block font-body text-[10px] uppercase tracking-widest opacity-50 hover:opacity-100 transition-opacity"
          >
            Gabinet w {otherLocationData.name}
          </a>
        )}
        
        {validLocation && (
          <a 
            href={`${basePath}/kontakt`}
            target={otherLocation ? undefined : '_self'}
            class="hidden sm:inline-flex items-center justify-center bg-primary text-surface px-6 py-2.5 rounded-full text-xs tracking-wider uppercase font-medium hover-lift transition-transform"
          >
            Umów wizytę
          </a>
        )}

        <!-- Mobile Menu Button -->
        {validLocation && (
          <button 
            type="button"
            id="mobile-menu-btn"
            class="md:hidden p-2 opacity-80 hover:opacity-100 transition-opacity"
            aria-label="Menu"
          >
            <svg class="w-5 h-5 menu-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg class="w-5 h-5 close-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        )}
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  {validLocation && (
    <div 
      id="mobile-menu" 
      class="hidden md:hidden absolute top-[calc(100%+0.5rem)] left-0 w-full bg-surface/95 backdrop-blur-xl rounded-3xl border border-primary/5 shadow-2xl overflow-hidden origin-top transition-all"
    >
      <nav class="px-6 py-8 flex flex-col gap-6 text-text-main">
        {navLinks.map(link => (
          <a 
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener' : undefined}
            class="font-heading text-2xl"
          >
            {link.label}
          </a>
        ))}
        
        {otherLocationData && (
          <a 
            href={`/${otherLocation}`}
            class="font-body text-xs tracking-widest uppercase opacity-60 pt-4 border-t border-primary/10"
          >
            Gabinet w {otherLocationData.name}
          </a>
        )}
        
        <div class="pt-4 mt-2">
          <a 
            href={`${basePath}/kontakt`}
            class="flex items-center justify-center w-full bg-primary text-surface px-6 py-4 rounded-full text-sm font-medium tracking-wide uppercase"
          >
            Umów wizytę
          </a>
        </div>
      </nav>
    </div>
  )}
</header>

<script>
  // Cinematic scroll morphing
  const nav = document.getElementById('cinematic-nav');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = menuBtn?.querySelector('.menu-icon');
  const closeIcon = menuBtn?.querySelector('.close-icon');

  const checkScroll = () => {
    if (!nav) return;
    if (window.scrollY > 80) {
      nav.classList.remove('bg-surface/0', 'border-text-main/0');
      nav.classList.add('bg-surface/90', 'backdrop-blur-xl', 'border-primary/10', 'shadow-[0_8px_30px_rgb(0,0,0,0.04)]');
    } else {
      nav.classList.add('bg-surface/0', 'border-text-main/0');
      nav.classList.remove('bg-surface/90', 'backdrop-blur-xl', 'border-primary/10', 'shadow-[0_8px_30px_rgb(0,0,0,0.04)]');
    }
  };

  window.addEventListener('scroll', checkScroll, { passive: true });
  checkScroll();

  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden', !isOpen);
    closeIcon?.classList.toggle('hidden', isOpen);
    
    if (!isOpen && nav) {
      nav.classList.remove('bg-surface/95');
      if (window.scrollY <= 80) {
        nav.classList.add('bg-surface/0');
        nav.classList.remove('backdrop-blur-xl', 'border-primary/10');
      }
    } else if (nav) {
      nav.classList.remove('bg-surface/0');
      nav.classList.add('bg-surface/95', 'backdrop-blur-xl', 'border-primary/10');
    }
  });
</script>
