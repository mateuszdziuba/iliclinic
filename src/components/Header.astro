---
import { Image } from 'astro:assets';
import locations from '../data/locations.json';
import logoBlack from '../assets/logo-black.png';

interface Props {
  location?: 'pruszkow' | 'ostroleka';
  currentPath: string;
}

const { location, currentPath } = Astro.props;

const basePath = location ? `/${location}` : '';

const navLinks = [
  { label: 'O nas', href: `${basePath}/o-nas` },
  { label: 'Zabiegi', href: `${basePath}/zabiegi` },
  ...(location === 'pruszkow' ? [{ label: 'Cennik', href: `${basePath}/cennik` }] : []),
  { label: 'Sklep', href: 'https://ilishop.pl', external: true },
  { label: 'Kontakt', href: `${basePath}/kontakt` },
];

const otherLocation = location === 'pruszkow' ? 'ostroleka' : location === 'ostroleka' ? 'pruszkow' : '';
const otherLocationData = otherLocation ? locations[otherLocation as keyof typeof locations] : null;
const currentLocationData = location ? locations[location as keyof typeof locations] : null;
const booksyUrl = (currentLocationData as any)?.booksy as string | undefined;

// Determine if we need to show the location switch (only if we have a valid location)
const validLocation = location === 'pruszkow' || location === 'ostroleka';
---

<header
  id="cinematic-nav"
  class="fixed top-7 left-1/2 -translate-x-1/2 z-50 w-[92%] max-w-5xl rounded-full transition-all duration-500 bg-white/75 backdrop-blur-md border border-white/40 shadow-[0_8px_24px_rgba(0,0,0,0.06)] text-text-main"
>
  <div class="px-7 py-3.5">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href={validLocation ? `/${location}` : '/'} class="flex items-center gap-3 group">
        <Image
          src={logoBlack}
          alt="ili Clinic"
          class="h-9 w-auto"
          width={156}
          height={48}
          loading="eager"
        />
        {validLocation && (
          <span class="hidden sm:inline-block font-body text-[9px] tracking-[0.2em] uppercase opacity-50 border border-current rounded-full px-2 py-0.5">
            {locations[location as keyof typeof locations]?.name}
          </span>
        )}
      </a>

      <!-- Desktop Navigation -->
      {validLocation && (
        <nav class="hidden md:flex items-center gap-7 absolute left-1/2 -translate-x-1/2">
          {navLinks.map(link => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener' : undefined}
              data-astro-prefetch={link.label === 'Cennik' ? 'load' : undefined}
              class="font-body text-[9px] tracking-[0.18em] uppercase text-text-main/60 hover:text-primary transition-colors"
            >
              {link.label}
            </a>
          ))}
        </nav>
      )}

      <!-- Right Side / CTA -->
      <div class="flex items-center gap-4">
        {validLocation && otherLocationData && (
          <a
            href={`/${otherLocation}`}
            class="hidden md:block font-body text-[9px] uppercase tracking-widest opacity-40 hover:opacity-80 transition-opacity"
          >
            {otherLocationData.name}
          </a>
        )}

        {validLocation && (
          <a
            href={booksyUrl || `${basePath}/kontakt`}
            target={booksyUrl ? '_blank' : undefined}
            rel={booksyUrl ? 'noopener' : undefined}
            class="hidden sm:inline-flex items-center justify-center bg-primary text-surface px-6 py-2 rounded-full text-[9px] tracking-[0.18em] uppercase font-body font-medium hover:brightness-110 transition-all active:scale-95"
          >
            Umów wizytę
          </a>
        )}

        <!-- Mobile Menu Button -->
        {validLocation && (
          <button
            type="button"
            id="mobile-menu-btn"
            class="md:hidden p-2 opacity-70 hover:opacity-100 transition-opacity"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg class="w-5 h-5 menu-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg class="w-5 h-5 close-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        )}
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  {validLocation && (
    <div
      id="mobile-menu" 
      class="hidden md:hidden absolute top-[calc(100%+0.5rem)] left-0 w-full bg-surface/95 backdrop-blur-xl rounded-3xl border border-primary/5 shadow-2xl overflow-hidden origin-top transition-all"
    >
      <nav class="px-6 py-8 flex flex-col gap-6 text-text-main">
        {otherLocationData && (
          <a
            href={`/${otherLocation}`}
            class="self-start inline-flex items-center gap-2 bg-surface-dim border border-primary/20 text-text-muted px-4 py-2 rounded-full font-body text-[9px] tracking-[0.15em] uppercase hover:border-primary hover:text-text-main transition-all"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-primary/40 shrink-0"></span>
            Gabinet · {otherLocationData.name}
          </a>
        )}

        {navLinks.map(link => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener' : undefined}
            data-astro-prefetch={link.label === 'Cennik' ? 'load' : undefined}
            class="font-heading text-2xl"
          >
            {link.label}
          </a>
        ))}

        <div class="pt-4 mt-2">
          <a
            href={booksyUrl || `${basePath}/kontakt`}
            target={booksyUrl ? '_blank' : undefined}
            rel={booksyUrl ? 'noopener' : undefined}
            class="flex items-center justify-center w-full bg-primary text-surface px-6 py-4 rounded-full text-sm font-medium tracking-wide uppercase"
          >
            Umów wizytę
          </a>
        </div>
      </nav>
    </div>
  )}
</header>

<script>
  function initMobileMenu() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = menuBtn?.querySelector('.menu-icon');
    const closeIcon = menuBtn?.querySelector('.close-icon');

    if (!menuBtn || !mobileMenu || menuBtn.dataset.menuBound === 'true') return;

    const syncMenuState = (open) => {
      mobileMenu.classList.toggle('hidden', !open);
      menuIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
      menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    syncMenuState(false);

    menuBtn.addEventListener('click', () => {
      const open = mobileMenu.classList.contains('hidden');
      syncMenuState(open);
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => syncMenuState(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') syncMenuState(false);
    });

    menuBtn.dataset.menuBound = 'true';
  }

  document.addEventListener('astro:page-load', initMobileMenu);
  initMobileMenu();
</script>
