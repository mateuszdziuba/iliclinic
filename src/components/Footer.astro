---
import locations from '../data/locations.json';

interface Props {
  location?: 'pruszkow' | 'ostroleka';
}

const { location } = Astro.props;

const currentLocationData = location ? locations[location as keyof typeof locations] : null;
const otherLocation = location === 'pruszkow' ? 'ostroleka' : 'pruszkow';
const otherLocationData = locations[otherLocation as keyof typeof locations];

const allLocations = Object.values(locations);
---

<footer class="bg-surface-dark text-text-light">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-primary-medical-light rounded-sm flex items-center justify-center">
            <span class="text-text-light font-heading font-bold text-xl">i</span>
          </div>
          <span class="font-heading text-2xl">Iliclinic</span>
        </div>
        <p class="text-text-light/70 text-sm leading-relaxed">
          Profesjonalna medycyna estetyczna w Pruszkowie i Ostrołęce. 
          Zaufaj ekspertom i odkryj piękniejszą wersję siebie.
        </p>
      </div>

      <!-- Current Location -->
      {currentLocationData && (
        <div>
          <h3 class="font-heading text-lg mb-4">{currentLocationData.name}</h3>
          <address class="not-italic text-text-light/70 text-sm space-y-2">
            <p>{currentLocationData.address.street}</p>
            <p>{currentLocationData.address.postalCode} {currentLocationData.address.city}</p>
            <p class="pt-2">
              <a href={`tel:${currentLocationData.phone.replace(/\s/g, '')}`} class="hover:text-accent-gold transition-colors">
                {currentLocationData.phone}
              </a>
            </p>
            <p>
              <a href={`mailto:${currentLocationData.email}`} class="hover:text-accent-gold transition-colors">
                {currentLocationData.email}
              </a>
            </p>
          </address>
        </div>
      )}

      <!-- Other Location / All Locations -->
      <div>
        <h3 class="font-heading text-lg mb-4">
          {location ? `Gabinet w ${otherLocationData.name}` : 'Nasze lokalizacje'}
        </h3>
        {location ? (
          <div class="text-text-light/70 text-sm space-y-2">
            <p>{otherLocationData.address.street}</p>
            <p>{otherLocationData.address.postalCode} {otherLocationData.address.city}</p>
            <a 
              href={`/${otherLocation}`}
              class="inline-block mt-4 text-accent-gold hover:text-accent-rose transition-colors"
            >
              Przejdź do strony →
            </a>
          </div>
        ) : (
          <ul class="space-y-3">
            {allLocations.map(loc => (
              <li>
                <a 
                  href={`/${loc.slug}`}
                  class="text-text-light/70 hover:text-accent-gold transition-colors text-sm"
                >
                  {loc.name} →
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-heading text-lg mb-4">Szybkie linki</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={location ? `/${location}/zabiegi` : '#'} class="text-text-light/70 hover:text-accent-gold transition-colors">
              Zabiegi
            </a>
          </li>
          <li>
            <a href={location ? `/${location}/o-nas` : '#'} class="text-text-light/70 hover:text-accent-gold transition-colors">
              O nas
            </a>
          </li>
          <li>
            <a href={location ? `/${location}/kontakt` : '#'} class="text-text-light/70 hover:text-accent-gold transition-colors">
              Kontakt
            </a>
          </li>
          <li>
            <a href="/polityka-prywatnosci" class="text-text-light/70 hover:text-accent-gold transition-colors">
              Polityka prywatności
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-text-light/10 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-text-light/50 text-sm">
        © {new Date().getFullYear()} Iliclinic. Wszelkie prawa zastrzeżone.
      </p>
      {currentLocationData?.social && (
        <div class="flex items-center gap-4">
          <a 
            href={currentLocationData.social.facebook} 
            target="_blank" 
            rel="noopener"
            class="text-text-light/50 hover:text-accent-gold transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a 
            href={currentLocationData.social.instagram} 
            target="_blank" 
            rel="noopener"
            class="text-text-light/50 hover:text-accent-gold transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        </div>
      )}
    </div>
  </div>
</footer>
