---
import locations from '../data/locations.json';

interface Props {
  location?: 'pruszkow' | 'ostroleka';
}

const { location } = Astro.props;

const currentLocationData = location ? locations[location as keyof typeof locations] : null;
const otherLocation = location === 'pruszkow' ? 'ostroleka' : 'pruszkow';
const otherLocationData = locations[otherLocation as keyof typeof locations];

const allLocations = Object.values(locations);
---

<footer class="bg-[#0a0a0a] text-surface rounded-t-[3rem] sm:rounded-t-[5rem] px-4 pt-24 lg:pt-32 pb-8 mt-12 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    
    <!-- Large Branding / Contact Intro -->
    <div class="mb-24 md:flex md:justify-between md:items-end">
      <div class="max-w-2xl">
        <h2 class="font-heading text-5xl sm:text-7xl lg:text-[7rem] leading-[0.9] tracking-[-0.03em] mb-6">
          Zacznijmy <br/><span class="italic text-primary-light">rozmowę.</span>
        </h2>
        {currentLocationData ? (
          <a href={`mailto:${currentLocationData.email}`} class="font-body text-lg sm:text-xlg opacity-80 hover:opacity-100 transition-opacity flex items-center gap-4">
            {currentLocationData.email}
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
        ) : (
          <a href="mailto:kontakt@iliclinic.pl" class="font-body text-lg sm:text-xlg opacity-80 hover:opacity-100 transition-opacity flex items-center gap-4">
            kontakt@iliclinic.pl
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
        )}
      </div>

      <div class="mt-12 md:mt-0 text-left md:text-right">
        <div class="font-heading text-2xl tracking-widest uppercase mb-2">Ili Clinic</div>
        <div class="font-body text-[10px] tracking-widest uppercase opacity-50 flex items-center md:justify-end gap-2">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
          </span>
          System Aktywny
        </div>
      </div>
    </div>

    <!-- Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8 border-t border-surface/10 pt-16 pb-16">
      
      <!-- Locations -->
      <div class="lg:col-span-4 pr-8">
        <h3 class="font-body text-[10px] uppercase tracking-[0.2em] opacity-40 mb-8">Lokalizacje</h3>
        
        {currentLocationData ? (
          <div class="mb-10">
            <h4 class="font-heading text-2xl mb-4">{currentLocationData.name}</h4>
            <address class="not-italic font-body text-sm opacity-70 space-y-1">
              <p>{currentLocationData.address.street}</p>
              <p>{currentLocationData.address.postalCode} {currentLocationData.address.city}</p>
              <p class="pt-4">
                <a href={`tel:${currentLocationData.phone.replace(/\s/g, '')}`} class="hover:text-primary-light transition-colors">
                  {currentLocationData.phone}
                </a>
              </p>
            </address>
          </div>
        ) : null}

        <div>
          <h4 class="font-body text-[10px] uppercase tracking-[0.2em] opacity-40 mb-4">
            {location ? `Inne kliniki` : 'Wybierz klinikę'}
          </h4>
          {location ? (
            <div class="font-body text-sm opacity-70 hover:opacity-100 transition-opacity">
              <p>{otherLocationData.name}</p>
              <a href={`/${otherLocation}`} class="inline-block mt-2 text-primary-light text-xs tracking-wider uppercase">
                Przejdź &rarr;
              </a>
            </div>
          ) : (
            <ul class="space-y-4">
              {allLocations.map(loc => (
                <li>
                  <a href={`/${loc.slug}`} class="font-body text-sm opacity-70 hover:opacity-100 hover:text-primary-light transition-all flex items-center justify-between group">
                    <span>{loc.name}</span>
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity">&rarr;</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>

      <!-- Quick Links -->
      <div class="lg:col-span-4">
        <h3 class="font-body text-[10px] uppercase tracking-[0.2em] opacity-40 mb-8">Nawigacja</h3>
        <ul class="space-y-4 font-body text-sm opacity-70">
          <li>
            <a href={location ? `/${location}/zabiegi` : '#'} class="hover:text-surface hover:opacity-100 transition-all flex items-center group">
              <span class="w-0 group-hover:w-4 group-hover:mr-2 h-px bg-current transition-all duration-300"></span>
              Protokoły
            </a>
          </li>
          <li>
            <a href={location ? `/${location}/o-nas` : '#'} class="hover:text-surface hover:opacity-100 transition-all flex items-center group">
              <span class="w-0 group-hover:w-4 group-hover:mr-2 h-px bg-current transition-all duration-300"></span>
              Filozofia
            </a>
          </li>
          <li>
            <a href={location ? `/${location}/kontakt` : '#'} class="hover:text-surface hover:opacity-100 transition-all flex items-center group">
              <span class="w-0 group-hover:w-4 group-hover:mr-2 h-px bg-current transition-all duration-300"></span>
              Rezerwacja
            </a>
          </li>
          <li>
            <a href="https://ilishop.pl" target="_blank" rel="noopener" class="hover:text-surface hover:opacity-100 transition-all flex items-center group">
              <span class="w-0 group-hover:w-4 group-hover:mr-2 h-px bg-current transition-all duration-300"></span>
              Sklep Online &nearr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal & Social -->
      <div class="lg:col-span-4">
        <h3 class="font-body text-[10px] uppercase tracking-[0.2em] opacity-40 mb-8">Informacje</h3>
        <ul class="space-y-4 font-body text-sm opacity-70 mb-12">
          <li>
            <a href="/polityka-prywatnosci" class="hover:text-surface hover:opacity-100 transition-colors">Polityka prywatności</a>
          </li>
          <li>
            <a href="/regulamin" class="hover:text-surface hover:opacity-100 transition-colors">Regulamin</a>
          </li>
        </ul>

        {currentLocationData?.social && (
          <div>
            <h3 class="font-body text-[10px] uppercase tracking-[0.2em] opacity-40 mb-6">Społeczność</h3>
            <div class="flex items-center gap-6">
              <a href={currentLocationData.social.facebook} target="_blank" rel="noopener" class="opacity-70 hover:opacity-100 hover:-translate-y-1 transition-all" aria-label="Facebook">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href={currentLocationData.social.instagram} target="_blank" rel="noopener" class="opacity-70 hover:opacity-100 hover:-translate-y-1 transition-all" aria-label="Instagram">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              </a>
            </div>
          </div>
        )}
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 border-t border-surface/5">
      <p class="font-body text-[10px] opacity-40 tracking-widest uppercase">
        © {new Date().getFullYear()} Ili Clinic. Wszelkie prawa zastrzeżone.
      </p>
      <div class="font-body text-[10px] opacity-20 tracking-widest uppercase flex items-center gap-2">
        AURA / ANTIGRAVITY ENGINE
      </div>
    </div>
  </div>
</footer>
