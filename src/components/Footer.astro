---
import locations from '../data/locations.json';

interface Props {
  location?: 'pruszkow' | 'ostroleka';
}

const { location } = Astro.props;

const currentLocationData = location ? locations[location as keyof typeof locations] : null;
const otherLocation = location === 'pruszkow' ? 'ostroleka' : 'pruszkow';
const otherLocationData = locations[otherLocation as keyof typeof locations];
const allLocations = Object.values(locations);
---

<footer class="bg-primary text-white py-24 px-6">
  <div class="max-w-7xl mx-auto">

    <!-- Top: brand + tagline + social -->
    <div class="flex flex-col md:flex-row justify-between items-start gap-16 mb-20">
      <div>
        <div class="text-3xl font-heading text-white mb-6 font-light tracking-tight">ili Clinic</div>
        <p class="text-white/60 max-w-xs font-light leading-relaxed text-sm font-body mb-10">
          Miejsce, w którym profesjonalizm medyczny łączy się z wizją nowoczesnego piękna.
        </p>
        {currentLocationData?.social && (
          <div class="flex gap-6">
            <a href={currentLocationData.social.facebook} target="_blank" rel="noopener"
               class="text-accent hover:text-white transition-colors text-[9px] uppercase tracking-[0.2em] font-body">
              Instagram
            </a>
            <a href={currentLocationData.social.instagram} target="_blank" rel="noopener"
               class="text-accent hover:text-white transition-colors text-[9px] uppercase tracking-[0.2em] font-body">
              Facebook
            </a>
          </div>
        )}
      </div>

      <!-- Links grid -->
      <div class="grid grid-cols-2 gap-16 md:gap-24">
        <div>
          <span class="text-accent block mb-7 text-[9px] uppercase tracking-[0.3em] font-body font-semibold">Menu</span>
          <ul class="space-y-4">
            <li><a href={location ? `/${location}/o-nas` : '#'} class="text-white/60 hover:text-white transition-colors text-sm font-light font-body">O nas</a></li>
            <li><a href={location ? `/${location}/zabiegi` : '#'} class="text-white/60 hover:text-white transition-colors text-sm font-light font-body">Zabiegi</a></li>
            <li><a href={location ? `/${location}/kontakt` : '#'} class="text-white/60 hover:text-white transition-colors text-sm font-light font-body">Kontakt</a></li>
            <li><a href="https://ilishop.pl" target="_blank" rel="noopener" class="text-white/60 hover:text-white transition-colors text-sm font-light font-body">Sklep ↗</a></li>
          </ul>
        </div>

        <div>
          <span class="text-accent block mb-7 text-[9px] uppercase tracking-[0.3em] font-body font-semibold">
            {location ? 'Lokalizacja' : 'Kliniki'}
          </span>
          <ul class="space-y-4">
            {location ? (
              <>
                <li class="text-white/60 text-sm font-light font-body">{currentLocationData?.address.street}</li>
                <li class="text-white/60 text-sm font-light font-body">{currentLocationData?.address.postalCode} {currentLocationData?.address.city}</li>
                <li>
                  <a href={`tel:${currentLocationData?.phone.replace(/\s/g, '')}`}
                     class="text-white/60 hover:text-white transition-colors text-sm font-light font-body">
                    {currentLocationData?.phone}
                  </a>
                </li>
                <li class="pt-2">
                  <a href={`/${otherLocation}`} class="text-accent hover:text-white transition-colors text-[9px] uppercase tracking-[0.2em] font-body">
                    Gabinet {otherLocationData.name} →
                  </a>
                </li>
              </>
            ) : (
              allLocations.map(loc => (
                <li>
                  <a href={`/${loc.slug}`} class="text-white/60 hover:text-white transition-colors text-sm font-light font-body">{loc.name}</a>
                </li>
              ))
            )}
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-10 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-[9px] tracking-[0.2em] font-body text-white/30 uppercase">
      <p>© {new Date().getFullYear()} ili Clinic. Wszelkie prawa zastrzeżone.</p>
      <div class="flex gap-8">
        <a href="/polityka-prywatnosci" class="hover:text-white/60 transition-colors">Polityka Prywatności</a>
        <a href="/regulamin" class="hover:text-white/60 transition-colors">Regulamin</a>
      </div>
    </div>

  </div>
</footer>
