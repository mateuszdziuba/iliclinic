---
interface Props {
  location: 'pruszkow' | 'ostroleka';
  locationName: string;
  title?: string;
  description?: string;
  tone?: 'surface' | 'primary';
}

const {
  location,
  locationName,
  title = 'Zostaw numer, oddzwonimy',
  description = 'Jeśli wolisz szybki telefon zamiast długiego formularza, zostaw kontakt. Oddzwonimy i pomożemy przejść do kolejnego kroku.',
  tone = 'surface',
} = Astro.props;

const isPrimary = tone === 'primary';
---

<div class:list={[
  'rounded-[32px] border p-8 lg:p-10',
  isPrimary ? 'border-white/10 bg-primary text-white' : 'border-white/10 bg-primary text-white',
]}>
  <div class:list={[
    'flex flex-col gap-2 border-b pb-6',
    isPrimary ? 'border-white/10' : 'border-white/10',
  ]}>
    <p class:list={[
      'font-body text-[9px] uppercase tracking-[0.3em]',
      isPrimary ? 'text-white/55' : 'text-white/55',
    ]}>Kontakt telefoniczny</p>
    <h3 class="font-heading text-3xl font-light">{title}</h3>
    <p class:list={[
      'font-body text-sm leading-relaxed font-light',
      isPrimary ? 'text-white/68' : 'text-white/68',
    ]}>
      {description}
    </p>
  </div>

  <form class="mt-8 space-y-4" data-callback-form>
    <input type="hidden" name="location" value={location} />
    <input type="hidden" name="locationName" value={locationName} />
    <input type="hidden" name="inquiryType" value="callback" />

    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class:list={[
          'mb-2 block font-body text-[10px] uppercase tracking-[0.18em]',
          isPrimary ? 'text-white/55' : 'text-white/55',
        ]}>Imię</span>
        <input
          type="text"
          name="name"
          autocomplete="name"
          required
          class:list={[
            'w-full rounded-2xl border px-4 py-3 font-body text-sm outline-none transition-colors',
            isPrimary
              ? 'border-white/12 bg-white/8 text-white placeholder:text-white/35 focus:border-white/30'
              : 'border-white/12 bg-white/8 text-white placeholder:text-white/35 focus:border-white/30',
          ]}
          placeholder="Jak mamy się do Ciebie zwracać?"
        />
      </label>

      <label class="block">
        <span class:list={[
          'mb-2 block font-body text-[10px] uppercase tracking-[0.18em]',
          isPrimary ? 'text-white/55' : 'text-white/55',
        ]}>Telefon</span>
        <input
          type="tel"
          name="phone"
          autocomplete="tel"
          inputmode="numeric"
          maxlength="15"
          required
          class:list={[
            'w-full rounded-2xl border px-4 py-3 font-body text-sm outline-none transition-colors',
            isPrimary
              ? 'border-white/12 bg-white/8 text-white placeholder:text-white/35 focus:border-white/30'
              : 'border-white/12 bg-white/8 text-white placeholder:text-white/35 focus:border-white/30',
          ]}
          placeholder="+48 500 600 700"
          pattern="^(\+48 )?\d{3} \d{3} \d{3}$"
        />
      </label>
    </div>

    <label class="block">
      <span class:list={[
        'mb-2 block font-body text-[10px] uppercase tracking-[0.18em]',
        isPrimary ? 'text-white/55' : 'text-white/55',
      ]}>Najlepsza pora na telefon</span>
      <textarea
        name="message"
        rows="3"
        class:list={[
          'w-full rounded-[24px] border px-4 py-3 font-body text-sm leading-relaxed outline-none transition-colors',
          isPrimary
            ? 'border-white/12 bg-white/8 text-white placeholder:text-white/35 focus:border-white/30'
            : 'border-white/12 bg-white/8 text-white placeholder:text-white/35 focus:border-white/30',
        ]}
        placeholder="Opcjonalnie: np. dziś po 16:00."
      ></textarea>
    </label>

    <button
      type="submit"
      class:list={[
        'inline-flex items-center justify-center rounded-full px-6 py-3 font-body text-[10px] uppercase tracking-[0.22em] transition-colors',
        isPrimary
          ? 'bg-white text-black hover:bg-white/88'
          : 'bg-white text-black hover:bg-white/88',
      ]}
      data-callback-submit
    >
      Zostaw numer
    </button>

    <p class:list={[
      'min-h-[1.5rem] font-body text-sm',
      isPrimary ? 'text-white/68' : 'text-white/68',
    ]} data-callback-status aria-live="polite"></p>
  </form>
</div>

<script>
  import { actions } from 'astro:actions';

  const PHONE_MAX_LENGTH = 15;
  const POLISH_PHONE_PATTERN = /^(\+48 )?\d{3} \d{3} \d{3}$/;

  function formatPolishPhoneInput(value) {
    const raw = String(value || '').replace(/[^\d+]/g, '');
    const hasInternationalPrefix = raw.startsWith('+48');
    const digits = raw.replace(/\D/g, '');
    const useCountryCode = hasInternationalPrefix || (digits.startsWith('48') && digits.length > 9);
    const trimmedDigits = useCountryCode ? digits.slice(0, 11) : digits.slice(0, 9);
    const localDigits = useCountryCode ? trimmedDigits.slice(2) : trimmedDigits;

    const groups = [];
    for (let index = 0; index < localDigits.length; index += 3) {
      groups.push(localDigits.slice(index, index + 3));
    }

    const prefix = useCountryCode ? '+48' : '';
    const formatted = [prefix, ...groups].filter(Boolean).join(' ').trim();
    return formatted.slice(0, PHONE_MAX_LENGTH);
  }

  function validateFormFields(form, status) {
    const nameInput = form.querySelector('input[name="name"]');
    const phoneInput = form.querySelector('input[name="phone"]');

    if (!nameInput || !phoneInput) return true;

    const name = String(nameInput.value || '').trim();
    const phone = formatPolishPhoneInput(String(phoneInput.value || ''));
    phoneInput.value = phone;

    if (name.length < 2) {
      status.textContent = 'Podaj imię i nazwisko.';
      nameInput.focus();
      return false;
    }

    if (!POLISH_PHONE_PATTERN.test(phone)) {
      status.textContent = 'Podaj poprawny polski numer telefonu, np. 500 600 700 lub +48 500 600 700.';
      phoneInput.focus();
      return false;
    }

    status.textContent = '';
    return true;
  }

  function initCallbackForms() {
    document.querySelectorAll('[data-callback-form]').forEach((formElement) => {
      const form = formElement;
      const status = form.querySelector('[data-callback-status]');
      const submit = form.querySelector('[data-callback-submit]');
      const phoneInput = form.querySelector('input[name="phone"]');

      if (!status || !submit || form.dataset.callbackBound === 'true') return;
      form.dataset.callbackBound = 'true';

      phoneInput?.addEventListener('input', () => {
        phoneInput.value = formatPolishPhoneInput(phoneInput.value);
      });

      phoneInput?.addEventListener('blur', () => {
        phoneInput.value = formatPolishPhoneInput(phoneInput.value);
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        if (!validateFormFields(form, status)) {
          return;
        }

        const formData = new FormData(form);
        formData.set('pageUrl', window.location.href);

        submit.disabled = true;
        status.textContent = 'Przygotowujemy zgłoszenie oddzwonienia...';

        try {
          const { error } = await actions.contact(formData);

          if (!error) {
            form.reset();
            status.textContent = 'Numer został zapisany. Oddzwonimy możliwie szybko.';
            return;
          }

          status.textContent = error.message || 'Nie udało się wysłać zgłoszenia. Spróbuj ponownie.';
        } catch {
          status.textContent = 'Wystąpił problem z wysyłką. Spróbuj ponownie.';
        } finally {
          submit.disabled = false;
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initCallbackForms);
  initCallbackForms();
</script>
