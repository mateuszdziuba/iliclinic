---
import { Image } from 'astro:assets';
import { resolveCmsImage } from '../lib/cms-images';

interface Props {
  src: string;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  quality?: number;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto' | 'low';
}

const {
  src,
  alt,
  class: className,
  widths,
  sizes,
  quality = 72,
  loading = 'lazy',
  fetchpriority = 'auto',
} = Astro.props;

const imageAsset = resolveCmsImage(src);
---

{imageAsset ? (
  <Image
    src={imageAsset}
    alt={alt}
    class={className}
    widths={widths}
    sizes={sizes}
    quality={quality}
    loading={loading}
    fetchpriority={fetchpriority}
    format="webp"
  />
) : (
  <img
    src={src}
    alt={alt}
    class={className}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
)}
