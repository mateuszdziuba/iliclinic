---
import BaseLayout from '../layouts/BaseLayout.astro';
import locations from '../data/locations.json';

const locationList = Object.values(locations);
---

<BaseLayout
  title="Nie znaleziono strony"
  description="Strona, której szukasz, nie jest dostępna. Wróć do wyboru lokalizacji ili Clinic lub przejdź do najważniejszych sekcji serwisu."
  canonical="https://iliclinic.pl/404"
  robots="noindex, follow"
  enableClientRouter={false}
  enableSmoothScroll={false}
>
  <section class="bg-surface min-h-[100svh] pt-36 pb-20 px-6">
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[minmax(0,1.15fr)_24rem]">
      <div class="border border-primary/10 bg-white/70 p-8 shadow-[0_18px_60px_rgba(0,0,0,0.06)] sm:p-10 lg:p-12">
        <p class="font-body text-xs uppercase tracking-[0.28em] text-text-muted">Błąd 404</p>
        <h1 class="mt-6 max-w-3xl text-4xl font-light text-text-main sm:text-5xl lg:text-6xl">
          Ta strona nie istnieje albo jej adres został zmieniony.
        </h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-text-muted sm:text-lg">
          Najszybciej wrócisz do właściwego miejsca przez wybór gabinetu, listę zabiegów albo kontakt. Jeśli trafiłaś tu z zapisanego linku, adres mógł być już nieaktualny.
        </p>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
          <a
            href="/"
            class="inline-flex items-center justify-center border border-primary bg-primary px-6 py-3 text-sm uppercase tracking-[0.18em] text-surface transition-colors hover:bg-primary-light"
          >
            Wróć na start
          </a>
          <a
            href="/pruszkow/zabiegi"
            class="inline-flex items-center justify-center border border-primary/20 px-6 py-3 text-sm uppercase tracking-[0.18em] text-text-main transition-colors hover:border-primary hover:text-primary"
          >
            Zobacz zabiegi
          </a>
          <a
            href="/pruszkow/kontakt"
            class="inline-flex items-center justify-center border border-primary/20 px-6 py-3 text-sm uppercase tracking-[0.18em] text-text-main transition-colors hover:border-primary hover:text-primary"
          >
            Kontakt
          </a>
        </div>
      </div>

      <aside class="border border-primary/10 bg-primary px-6 py-8 text-white shadow-[0_18px_60px_rgba(0,0,0,0.08)] sm:px-8">
        <h2 class="text-2xl font-light">Wybierz gabinet</h2>
        <div class="mt-8 space-y-4">
          {locationList.map((location) => (
            <a
              href={`/${location.slug}`}
              class="block border border-white/12 px-5 py-5 transition-colors hover:border-accent hover:bg-white/5"
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="text-2xl font-light">{location.name}</p>
                  <p class="mt-2 text-sm leading-6 text-white/65">
                    {location.address.street}<br />
                    {location.address.postalCode} {location.address.city}
                  </p>
                </div>
                <span class="pt-1 text-xs uppercase tracking-[0.22em] text-accent">Wejdź</span>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-8 border-t border-white/12 pt-6">
          <p class="text-sm leading-7 text-white/65">
            Możesz też wrócić do strony głównej i wybrać lokalizację od nowa.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
