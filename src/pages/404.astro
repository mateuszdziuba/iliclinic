---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import heroClinic from '../assets/pruszkow-clinic-hero.jpg';
import locations from '../data/locations.json';
---

<BaseLayout
  title="Nie znaleziono strony"
  description="Strona, której szukasz, nie jest dostępna. Wróć do ili Clinic i przejdź do właściwej lokalizacji."
  canonical="https://iliclinic.pl/404"
  robots="noindex, follow"
  hideHeader={true}
  hideFooter={true}
  hideCookieBanner={true}
  enableClientRouter={false}
  enableSmoothScroll={false}
>
  <section class="relative min-h-[100svh] overflow-hidden bg-primary text-white">
    <Image
      src={heroClinic}
      alt="ili Clinic"
      class="absolute inset-0 h-full w-full object-cover"
      widths={[768, 1280, 1600]}
      sizes="100vw"
      quality={60}
      loading="eager"
      fetchpriority="high"
      format="webp"
    />

    <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(8,8,8,0.36)_0%,rgba(12,12,12,0.48)_38%,rgba(12,12,12,0.72)_100%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.12),transparent_38%)]"></div>

    <div class="relative z-10 flex min-h-[100svh] flex-col px-6 py-8 sm:px-8 lg:px-12">
      <div class="flex justify-center">
        <img
          src="/images/logo-white.png"
          alt="ili Clinic"
          class="h-10 w-auto sm:h-11"
          width="174"
          height="56"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="mx-auto flex w-full max-w-6xl flex-1 items-center justify-center">
        <div class="w-full max-w-4xl rounded-[32px] border border-white/12 bg-black/20 px-8 py-10 shadow-[0_24px_60px_rgba(0,0,0,0.2)] backdrop-blur-[10px] sm:px-12 sm:py-14">
          <p class="font-body text-[10px] uppercase tracking-[0.34em] text-white/45">Błąd 404</p>
          <h1 class="mt-6 font-heading text-4xl font-light leading-[0.94] text-white sm:text-5xl lg:text-6xl">
            Ta strona nie jest już dostępna.
          </h1>
          <p class="mt-6 max-w-2xl font-body text-sm leading-7 text-white/68 sm:text-base">
            Adres mógł zostać zmieniony albo link prowadzi do nieaktualnej podstrony. Wróć do głównego wejścia lub przejdź bezpośrednio do jednego z gabinetów.
          </p>

          <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a
              href="/"
              class="inline-flex items-center justify-center rounded-full border border-white/18 bg-white px-6 py-3 text-[10px] uppercase tracking-[0.22em] text-black transition-colors hover:bg-white/88"
            >
              Wróć na start
            </a>
            <a
              href="/pruszkow/zabiegi"
              class="inline-flex items-center justify-center rounded-full border border-white/18 bg-white/8 px-6 py-3 text-[10px] uppercase tracking-[0.22em] text-white transition-colors hover:bg-white/14"
            >
              Zobacz zabiegi
            </a>
          </div>

          <div class="mt-12 grid gap-4 sm:grid-cols-2">
            <a
              href={`/${locations.pruszkow.slug}`}
              class="group flex h-full flex-col justify-between rounded-[28px] border border-white/10 bg-black/18 px-6 py-6 transition-colors hover:bg-black/28"
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-body text-[9px] uppercase tracking-[0.3em] text-white/42">Gabinet</p>
                  <h2 class="mt-3 font-heading text-2xl font-light text-white">{locations.pruszkow.name}</h2>
                  <p class="mt-3 font-body text-sm leading-6 text-white/58">
                    {locations.pruszkow.address.street}<br />
                    {locations.pruszkow.address.postalCode} {locations.pruszkow.address.city}
                  </p>
                </div>
              </div>
              <div class="mt-8 flex items-center justify-between border-t border-white/10 pt-4">
                <span class="font-body text-[10px] uppercase tracking-[0.22em] text-white/46 transition-colors group-hover:text-white/78">
                  Zobacz gabinet
                </span>
                <span class="flex h-8 w-8 items-center justify-center rounded-full border border-white/20 text-white/78 transition-colors group-hover:bg-white group-hover:text-black">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </span>
              </div>
            </a>

            <a
              href={`/${locations.ostroleka.slug}`}
              class="group flex h-full flex-col justify-between rounded-[28px] border border-white/10 bg-black/18 px-6 py-6 transition-colors hover:bg-black/28"
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-body text-[9px] uppercase tracking-[0.3em] text-white/42">Gabinet</p>
                  <h2 class="mt-3 font-heading text-2xl font-light text-white">{locations.ostroleka.name}</h2>
                  <p class="mt-3 font-body text-sm leading-6 text-white/58">
                    {locations.ostroleka.address.street}<br />
                    {locations.ostroleka.address.postalCode} {locations.ostroleka.address.city}
                  </p>
                </div>
              </div>
              <div class="mt-8 flex items-center justify-between border-t border-white/10 pt-4">
                <span class="font-body text-[10px] uppercase tracking-[0.22em] text-white/46 transition-colors group-hover:text-white/78">
                  Zobacz gabinet
                </span>
                <span class="flex h-8 w-8 items-center justify-center rounded-full border border-white/20 text-white/78 transition-colors group-hover:bg-white group-hover:text-black">
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </span>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
