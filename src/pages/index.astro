---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import locations from '../data/locations.json';
import settings from '../data/settings.json';
import heroClinic from '../assets/pruszkow-clinic-hero.jpg';
import heroOstroleka from '../assets/ostroleka-clinic-hero.jpg';

const allLocations = Object.entries(locations);

const locationConfig = {
  pruszkow: {
    image: heroClinic,
    video: '/1.mp4',
    color: 'oklch(0.32 0.06 55)',
    alt: 'Gabinet ili Clinic Studio w Pruszkowie',
  },
  ostroleka: {
    image: heroOstroleka,
    video: '/2.mp4',
    color: 'oklch(0.22 0.07 258)',
    alt: 'Gabinet ili Clinic w Ostrołęce',
  },
} as const;

const [pruszkowPoster, ostrolekaPoster] = await Promise.all([
  getImage({ src: heroClinic, width: 1280, format: 'webp', quality: 68 }),
  getImage({ src: heroOstroleka, width: 1280, format: 'webp', quality: 68 }),
]);

const panelPosters = {
  pruszkow: pruszkowPoster,
  ostroleka: ostrolekaPoster,
} as const;
---

<BaseLayout
  title={settings.seo?.homeTitle ?? 'Medycyna estetyczna Pruszków i Ostrołęka'}
  description={settings.seo?.homeDescription ?? settings.siteDescription}
  hideHeader={true}
  hideFooter={true}
  hideCookieBanner={true}
  enableClientRouter={false}
  enableSmoothScroll={false}
>
  <script is:inline>
    const savedLocation = localStorage.getItem('ili-location');
    if (savedLocation === 'pruszkow' || savedLocation === 'ostroleka') {
      window.location.replace(`/${savedLocation}`);
    }
  </script>

  <section class="split-root relative h-screen flex flex-col sm:flex-row overflow-hidden">

    <div class="absolute top-6 left-1/2 -translate-x-1/2 z-30 flex justify-center pointer-events-none sm:hidden">
      <p class="font-body text-white/30 text-[8px] uppercase tracking-[0.35em] whitespace-nowrap">
        Wybierz najbliższy gabinet
      </p>
    </div>

    <!-- Logo centered at top -->
    <div class="absolute top-12 left-1/2 -translate-x-1/2 z-40 flex flex-col items-center gap-2 pointer-events-none sm:top-7">
      <img
        src="/images/logo-white.png"
        alt="ili Clinic"
        class="h-9 sm:h-11 w-auto drop-shadow-lg"
        width="174"
        height="56"
        loading="eager"
        decoding="async"
      />
    </div>

    <!-- Vertical/horizontal divider -->
    <div class="split-divider absolute sm:left-1/2 sm:top-0 sm:bottom-0 sm:w-px sm:h-auto
                left-0 right-0 top-1/2 h-px sm:transform-none
                bg-white/20 z-20 pointer-events-none"></div>

    {allLocations.map(([key, location], i) => {
      const cfg = locationConfig[key as keyof typeof locationConfig];
      const poster = panelPosters[key as keyof typeof panelPosters];
      return (
        <a
          href={`/${key}`}
          class="location-panel group relative flex-1 overflow-hidden"
          data-location={key}
        >
          <Image
            src={cfg.image}
            alt={cfg.alt}
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.4s] ease-out scale-[1.06] group-hover:scale-100"
            widths={[640, 960, 1280]}
            sizes="(min-width: 640px) 50vw, 100vw"
            quality={60}
            loading="eager"
            fetchpriority={i === 0 ? 'high' : 'auto'}
            format="webp"
          />

          <!-- Hover video -->
          <video
            class="split-video absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 ease-out pointer-events-none"
            data-hover-video
            muted
            loop
            playsinline
            preload="none"
            poster={poster.src}
          >
            <source src={cfg.video} type="video/mp4" />
          </video>

          <!-- Color wash + gradient -->
          <div
            class="absolute inset-0"
            style={`background: linear-gradient(to top, ${cfg.color} 0%, color-mix(in srgb, ${cfg.color} 70%, transparent) 50%, color-mix(in srgb, ${cfg.color} 30%, transparent) 100%); opacity: 0.82;`}
          ></div>
          <div class="absolute inset-0 bg-black/15 group-hover:bg-black/5 transition-colors duration-700"></div>

          <!-- Panel content -->
          <div class="relative h-full flex flex-col justify-between p-8 sm:p-10 md:p-14 lg:p-16">

            <!-- Top: decorative number -->
            <div class="self-start mt-14 sm:mt-16">
              <span class="font-heading text-white/10 text-8xl sm:text-[10rem] font-light leading-none select-none">
                0{i + 1}
              </span>
            </div>

            <!-- Bottom: city info -->
            <div class="translate-y-2 group-hover:translate-y-0 transition-transform duration-500 ease-out">
              <p class="font-body text-white/40 text-[9px] uppercase tracking-[0.45em] mb-4">
                ili Clinic
              </p>
              <h2 class="font-heading text-white font-light leading-[0.88] mb-5
                          text-4xl sm:text-5xl md:text-6xl lg:text-7xl">
                {location.name}
              </h2>
              <p class="font-body text-white/55 text-sm font-light leading-relaxed mb-7 sm:mb-9">
                {location.address.street}<br />
                {location.address.postalCode} {location.address.city}
              </p>

              <!-- CTA row -->
              <div class="flex items-center gap-3 sm:gap-4 max-w-[12rem] sm:max-w-none">
                <span class="min-w-0 font-body text-white/70 group-hover:text-white text-[8px] sm:text-[9px] uppercase tracking-[0.2em] sm:tracking-[0.25em] leading-tight transition-colors duration-300">
                  Wejdź do gabinetu
                </span>
                <div class="w-8 h-8 shrink-0 rounded-full border border-white/30 flex items-center justify-center
                            group-hover:bg-white group-hover:border-white transition-all duration-400">
                  <svg class="w-3 h-3 text-white group-hover:text-black/60 transition-colors duration-300"
                       fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </div>
              </div>
            </div>

          </div>
        </a>
      );
    })}

    <!-- Bottom hint -->
    <div class="absolute bottom-5 left-0 right-0 z-30 hidden justify-center pointer-events-none sm:flex">
      <p class="font-body text-white/25 text-[8px] uppercase tracking-[0.35em]">
        Wybierz najbliższy gabinet
      </p>
    </div>

  </section>
</BaseLayout>

<style>
  .location-panel {
    transition: flex-grow 0.65s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .location-panel:hover .split-video,
  .location-panel:focus-within .split-video {
    opacity: 1;
  }

  /* Expand hovered panel, shrink other — desktop only */
  @media (min-width: 640px) {
    .split-divider {
      left: 50%;
      transition: left 0.65s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .split-root:has(.location-panel:hover) .location-panel {
      flex-grow: 0.8;
    }
    .split-root:has(.location-panel:hover) .location-panel:hover {
      flex-grow: 1.2;
    }

    .split-root:has(.location-panel[data-location="pruszkow"]:hover) .split-divider {
      left: 60%;
    }

    .split-root:has(.location-panel[data-location="ostroleka"]:hover) .split-divider {
      left: 40%;
    }
  }
</style>

<script>
  // Save chosen location
  document.querySelectorAll('[data-location]').forEach(el => {
    el.addEventListener('click', () => {
      const loc = (el as HTMLElement).dataset.location;
      if (loc) localStorage.setItem('ili-location', loc);
    });
  });

  document.querySelectorAll('[data-location]').forEach(panel => {
    const video = panel.querySelector('[data-hover-video]') as HTMLVideoElement | null;
    if (!video) return;

    let pendingPlay = false;

    const startPlayback = () => {
      video.currentTime = 0;
      video.play().catch(() => {});
    };

    const primeVideo = () => {
      if (video.dataset.primed === 'true') return;

      video.dataset.primed = 'true';
      video.preload = 'auto';
      video.load();
    };

    const playVideo = () => {
      pendingPlay = true;
      primeVideo();

      if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
        startPlayback();
        return;
      }

      video.addEventListener(
        'loadeddata',
        () => {
          if (pendingPlay) startPlayback();
        },
        { once: true }
      );
    };

    const stopVideo = () => {
      pendingPlay = false;
      video.pause();
      video.currentTime = 0;
    };

    panel.addEventListener('mouseenter', playVideo);
    panel.addEventListener('mouseleave', stopVideo);
    panel.addEventListener('focusin', playVideo);
    panel.addEventListener('focusout', stopVideo);
  });
</script>
