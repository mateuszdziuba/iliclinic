---
import BaseLayout from '../../layouts/BaseLayout.astro';
import locations from '../../data/locations.json';

export function getStaticPaths() {
  return [
    { params: { location: 'pruszkow' } },
    { params: { location: 'ostroleka' } },
  ];
}

const { location } = Astro.params;
const locationData = locations[location as keyof typeof locations];
const otherLocation = location === 'pruszkow' ? 'ostroleka' : 'pruszkow';
const otherLocationData = locations[otherLocation as keyof typeof locations];
---

<BaseLayout 
  title={`Kontakt - ${locationData.name}`}
  description={`Skontaktuj się z gabinetem Iliclinic w ${locationData.name}. Telefon: ${locationData.phone}. Adres: ${locationData.address.street}, ${locationData.address.city}.`}
  location={location as 'pruszkow' | 'ostroleka'}
>
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-16">
        <p class="text-primary-medical font-medium mb-4 tracking-wide uppercase text-sm">
          Kontakt
        </p>
        <h1 class="font-heading text-4xl lg:text-5xl text-text-deep mb-6">
          Gabinet w {locationData.name}
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          Umów wizytę telefonicznie lub odwiedź nas osobiście. 
          Chętnie odpowiemy na wszystkie pytania.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Contact Info -->
        <div>
          <h2 class="font-heading text-2xl text-text-deep mb-8">
            Dane kontaktowe
          </h2>
          
          <div class="space-y-6">
            <!-- Address -->
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-primary-medical/10 rounded-sm flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-medical" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-text-deep mb-1">Adres</p>
                <p class="text-text-muted">
                  {locationData.address.street}<br />
                  {locationData.address.postalCode} {locationData.address.city}
                </p>
                <a 
                  href={locationData.googleMapsUrl}
                  target="_blank"
                  rel="noopener"
                  class="text-primary-medical text-sm hover:underline mt-2 inline-block"
                >
                  Zobacz na mapie →
                </a>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-primary-medical/10 rounded-sm flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-medical" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-text-deep mb-1">Telefon</p>
                <a 
                  href={`tel:${locationData.phone.replace(/\s/g, '')}`}
                  class="text-primary-medical text-lg font-medium hover:text-primary-medical-dark"
                >
                  {locationData.phone}
                </a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-primary-medical/10 rounded-sm flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-medical" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-text-deep mb-1">Email</p>
                <a 
                  href={`mailto:${locationData.email}`}
                  class="text-primary-medical hover:text-primary-medical-dark"
                >
                  {locationData.email}
                </a>
              </div>
            </div>

            <!-- Opening Hours -->
            <div class="flex gap-4">
              <div class="w-12 h-12 bg-primary-medical/10 rounded-sm flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-medical" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="font-medium text-text-deep mb-1">Godziny otwarcia</p>
                <div class="text-text-muted text-sm space-y-1">
                  <p>Pon-Pt: {locationData.openingHours.weekdays}</p>
                  <p>Sobota: {locationData.openingHours.saturday}</p>
                  <p>Niedziela: {locationData.openingHours.sunday}</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Other location -->
          <div class="mt-12 p-6 bg-surface-cream">
            <h3 class="font-heading text-lg text-text-deep mb-3">
              Gabinet w {otherLocationData.name}
            </h3>
            <p class="text-text-muted text-sm mb-4">
              {otherLocationData.address.street}, {otherLocationData.address.city}
            </p>
            <a 
              href={`/${otherLocation}/kontakt`}
              class="text-primary-medical text-sm font-medium hover:underline"
            >
              Zobacz dane kontaktowe →
            </a>
          </div>
        </div>

        <!-- Map placeholder -->
        <div>
          <h2 class="font-heading text-2xl text-text-deep mb-8">
            Lokalizacja
          </h2>
          <div class="aspect-square bg-gradient-to-br from-primary-medical/10 to-accent-gold/10 rounded-sm flex items-center justify-center">
            <div class="text-center">
              <svg class="w-12 h-12 text-primary-medical/50 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <p class="text-text-muted text-sm">Mapa Google</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
