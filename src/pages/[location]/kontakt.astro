---
import BaseLayout from '../../layouts/BaseLayout.astro';
import locations from '../../data/locations.json';

export function getStaticPaths() {
  return [
    { params: { location: 'pruszkow' } },
    { params: { location: 'ostroleka' } },
  ];
}

const { location } = Astro.params;
const locationData = locations[location as keyof typeof locations];
const salonName = (locationData as any).salonName || `ili Clinic ${locationData.name}`;
const locationSeo = (locationData as any).seo ?? {};
const otherLocation = location === 'pruszkow' ? 'ostroleka' : 'pruszkow';
const otherLocationData = locations[otherLocation as keyof typeof locations];

const mapsQuery = encodeURIComponent(`${salonName} ${locationData.address.street} ${locationData.address.city}`);
const mapsEmbedUrl = `https://maps.google.com/maps?q=${mapsQuery}&output=embed&hl=pl`;

const siteUrl = 'https://iliclinic.pl';
const pageUrl = `${siteUrl}/${location}/kontakt`;
const contactSchema = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  "@id": `${pageUrl}#contact`,
  "name": salonName,
  "description": `${salonName} w ${(locationData as any).locative}. Kontakt, mapa dojazdu, godziny otwarcia i dane rejestracji wizyt.`,
  "url": pageUrl,
  "telephone": locationData.phone,
  "email": locationData.email,
  "image": `${siteUrl}/${location === 'pruszkow' ? 'images/pruszkow-clinic-hero.jpg' : 'images/ostroleka-clinic-hero.jpg'}`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": locationData.address.street,
    "addressLocality": locationData.address.city,
    "postalCode": locationData.address.postalCode,
    "addressCountry": "PL"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": (locationData as any).geo?.lat,
    "longitude": (locationData as any).geo?.lng
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "10:00",
      "closes": "20:00"
    }
  ],
  "hasMap": locationData.googleMapsUrl,
  "areaServed": {
    "@type": "City",
    "name": locationData.address.city
  },
  "mainEntityOfPage": pageUrl,
  "sameAs": [
    locationData.social.facebook,
    locationData.social.instagram,
    ...(location === 'pruszkow' ? [(locationData as any).booksy] : [])
  ].filter(Boolean),
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": locationData.phone,
    "contactType": "customer service",
    "availableLanguage": "Polish"
  }
};
---

<BaseLayout
  title={locationSeo.contactTitle ?? `Kontakt — Gabinet w ${(locationData as any).locative} | ${salonName}`}
  description={locationSeo.contactDescription ?? `Skontaktuj się z ${salonName} w ${locationData.name}. Telefon: ${locationData.phone}. Adres: ${locationData.address.street}, ${locationData.address.city}. Godziny otwarcia: ${locationData.openingHours.weekdays}.`}
  location={location as 'pruszkow' | 'ostroleka'}
  jsonLd={contactSchema}
>

  <!-- ─── HERO ──────────────────────────────────────────────── -->
  <section class="pt-44 lg:pt-44 pb-20 bg-surface">
    <div class="max-w-7xl mx-auto px-6">
      <span class="text-primary font-body tracking-[0.4em] uppercase text-[10px] mb-8 block font-medium" data-hero-label>Kontakt</span>
      <h1 class="font-heading text-3xl sm:text-5xl lg:text-7xl text-text-main leading-[0.95] tracking-[-0.02em] mb-6" data-hero-title>
        Gabinet<br /><em class="not-italic text-primary">w {(locationData as any).locative ?? locationData.name}</em>
      </h1>
      <p class="font-body text-text-muted text-lg leading-relaxed max-w-md font-light mt-8" data-hero-desc>
        Umów wizytę telefonicznie lub odwiedź nas osobiście.
        Chętnie odpowiemy na wszystkie pytania.
      </p>
    </div>
  </section>

  <!-- ─── MAIN CONTENT ──────────────────────────────────────── -->
  <section class="pb-32 bg-surface">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">

        <!-- Contact Info -->
        <div data-scroll-fade>
          <div class="space-y-0 border-t border-primary/10">

            <!-- Address -->
            <div class="group py-8 border-b border-primary/10 flex items-start gap-6 hover:bg-surface-dim transition-colors px-4 -mx-4 rounded-lg">
              <div class="w-10 h-10 rounded-full border border-primary/20 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-primary group-hover:border-primary transition-all">
                <svg class="w-4 h-4 text-primary group-hover:text-surface transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="flex-1">
                <p class="font-body text-[9px] uppercase tracking-[0.3em] text-text-muted mb-2">Adres</p>
                <p class="font-heading text-xl text-text-main font-light leading-snug">
                  {locationData.address.street}<br />
                  {locationData.address.postalCode} {locationData.address.city}
                </p>
                <a
                  href={locationData.googleMapsUrl}
                  target="_blank"
                  rel="noopener"
                  class="mt-3 inline-block font-body text-[10px] uppercase tracking-widest text-primary border-b border-primary/30 pb-0.5 hover:border-primary transition-colors"
                >
                  Otwórz w mapach →
                </a>
              </div>
            </div>

            <!-- Phone -->
            <a
              href={`tel:${locationData.phone.replace(/\s/g, '')}`}
              class="group py-8 border-b border-primary/10 flex items-start gap-6 hover:bg-surface-dim transition-colors px-4 -mx-4 rounded-lg block"
            >
              <div class="w-10 h-10 rounded-full border border-primary/20 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-primary group-hover:border-primary transition-all">
                <svg class="w-4 h-4 text-primary group-hover:text-surface transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <p class="font-body text-[9px] uppercase tracking-[0.3em] text-text-muted mb-2">Telefon</p>
                <p class="font-heading text-2xl text-text-main group-hover:text-primary transition-colors font-light">
                  {locationData.phone}
                </p>
              </div>
            </a>

            <!-- Email -->
            <a
              href={`mailto:${locationData.email}`}
              class="group py-8 border-b border-primary/10 flex items-start gap-6 hover:bg-surface-dim transition-colors px-4 -mx-4 rounded-lg block"
            >
              <div class="w-10 h-10 rounded-full border border-primary/20 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-primary group-hover:border-primary transition-all">
                <svg class="w-4 h-4 text-primary group-hover:text-surface transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="font-body text-[9px] uppercase tracking-[0.3em] text-text-muted mb-2">Email</p>
                <p class="font-heading text-2xl text-text-main group-hover:text-primary transition-colors font-light">
                  {locationData.email}
                </p>
              </div>
            </a>

            <!-- Opening Hours -->
            <div class="group py-8 border-b border-primary/10 flex items-start gap-6 hover:bg-surface-dim transition-colors px-4 -mx-4 rounded-lg">
              <div class="w-10 h-10 rounded-full border border-primary/20 flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-primary group-hover:border-primary transition-all">
                <svg class="w-4 h-4 text-primary group-hover:text-surface transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div class="flex-1">
                <p class="font-body text-[9px] uppercase tracking-[0.3em] text-text-muted mb-4">Godziny otwarcia</p>
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="font-body text-sm text-text-muted">Pon – Pt</span>
                    <span class="font-heading text-lg text-text-main font-light">{locationData.openingHours.weekdays}</span>
                  </div>
                  <div class="flex items-center justify-between border-t border-primary/5 pt-2">
                    <span class="font-body text-sm text-text-muted">Sobota</span>
                    <span class="font-heading text-base text-text-main font-light">{locationData.openingHours.saturday}</span>
                  </div>
                  <div class="flex items-center justify-between border-t border-primary/5 pt-2">
                    <span class="font-body text-sm text-text-muted">Niedziela</span>
                    <span class="font-body text-sm text-text-muted/60">{locationData.openingHours.sunday}</span>
                  </div>
                </div>
              </div>
            </div>

          </div>

          <div class="mt-8 rounded-[32px] border border-primary/10 bg-surface-dim p-8 lg:p-10" data-scroll-fade>
            <div class="flex flex-col gap-2 border-b border-primary/10 pb-6">
              <p class="font-body text-[9px] uppercase tracking-[0.3em] text-primary">Wiadomość</p>
              <h3 class="font-heading text-3xl text-text-main font-light">Napisz do nas</h3>
              <p class="font-body text-sm leading-relaxed text-text-muted font-light">
                Wyślij wiadomość do gabinetu, a wrócimy do Ciebie z odpowiedzią tak szybko, jak to możliwe.
              </p>
            </div>

            <form class="mt-8 space-y-5" data-contact-form data-contact-mode="message">
              <input type="hidden" name="location" value={location} />
              <input type="hidden" name="locationName" value={locationData.name} />
              <input type="hidden" name="inquiryType" value="message" />

              <div class="grid gap-5 sm:grid-cols-2">
                <label class="block">
                  <span class="mb-2 block font-body text-[10px] uppercase tracking-[0.18em] text-text-muted">Imię i nazwisko</span>
                  <input
                    type="text"
                    name="name"
                    autocomplete="name"
                    required
                    class="w-full rounded-2xl border border-primary/12 bg-surface px-4 py-3 font-body text-sm text-text-main outline-none transition-colors placeholder:text-text-muted/55 focus:border-primary"
                    placeholder="Jak mamy się do Ciebie zwracać?"
                  />
                </label>

                <label class="block">
                  <span class="mb-2 block font-body text-[10px] uppercase tracking-[0.18em] text-text-muted">Telefon</span>
                  <input
                    type="tel"
                    name="phone"
                    autocomplete="tel"
                    required
                    class="w-full rounded-2xl border border-primary/12 bg-surface px-4 py-3 font-body text-sm text-text-main outline-none transition-colors placeholder:text-text-muted/55 focus:border-primary"
                    placeholder="+48 000 000 000"
                  />
                </label>
              </div>

              <label class="block">
                <span class="mb-2 block font-body text-[10px] uppercase tracking-[0.18em] text-text-muted">E-mail</span>
                <input
                  type="email"
                  name="email"
                  autocomplete="email"
                  class="w-full rounded-2xl border border-primary/12 bg-surface px-4 py-3 font-body text-sm text-text-main outline-none transition-colors placeholder:text-text-muted/55 focus:border-primary"
                  placeholder="Opcjonalnie, jeśli mamy odpisać mailowo"
                />
              </label>

              <label class="block">
                <span class="mb-2 block font-body text-[10px] uppercase tracking-[0.18em] text-text-muted">Wiadomość</span>
                <textarea
                  name="message"
                  rows="6"
                  required
                  class="w-full rounded-[24px] border border-primary/12 bg-surface px-4 py-3 font-body text-sm leading-relaxed text-text-main outline-none transition-colors placeholder:text-text-muted/55 focus:border-primary"
                  placeholder="Opisz krótko, czego dotyczy wiadomość albo jaki zabieg Cię interesuje."
                ></textarea>
              </label>

              <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <button
                  type="submit"
                  class="inline-flex items-center justify-center gap-3 rounded-full bg-primary px-8 py-4 font-body text-xs uppercase tracking-widest text-surface transition-all duration-300 hover:brightness-110"
                  data-contact-submit
                >
                  Wyślij wiadomość
                </button>
                <a
                  href={`tel:${locationData.phone.replace(/\s/g, '')}`}
                  class="inline-flex items-center justify-center gap-3 rounded-full border border-primary/18 px-8 py-4 font-body text-xs uppercase tracking-widest text-text-main transition-colors hover:bg-surface"
                >
                  Zadzwoń: {locationData.phone}
                </a>
              </div>

              <p class="min-h-[1.5rem] font-body text-sm text-text-muted" data-contact-status aria-live="polite"></p>
            </form>
          </div>
        </div>

        <!-- Map -->
        <div data-scroll-fade>
          <p class="font-body text-[9px] uppercase tracking-[0.3em] text-text-muted mb-6">Lokalizacja</p>
          <div class="aspect-square rounded-[40px] overflow-hidden shadow-xl border border-primary/10">
            <iframe
              src={mapsEmbedUrl}
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`Mapa - ${salonName}`}
            ></iframe>
          </div>

          <div class="mt-8 p-8 border border-primary/10 rounded-3xl bg-surface-dim" data-scroll-fade>
            <p class="font-body text-[9px] uppercase tracking-[0.3em] text-text-muted mb-4">Drugi gabinet</p>
            <h3 class="font-heading text-2xl text-text-main font-light mb-2">{(otherLocationData as any).salonName || `ili Clinic ${otherLocationData.name}`}</h3>
            <p class="font-body text-text-muted text-sm mb-6">
              {otherLocationData.address.street}, {otherLocationData.address.postalCode} {otherLocationData.address.city}
            </p>
            <a
              href={`/${otherLocation}/kontakt`}
              class="font-body text-[10px] uppercase tracking-widest text-primary border-b border-primary/30 pb-0.5 hover:border-primary transition-colors inline-flex items-center gap-2"
            >
              Zobacz dane kontaktowe
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Safety: scroll-fade elements start visible; JS animates from partial opacity only when off-screen */
  [data-scroll-fade] { opacity: 1; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initAnimations() {
    const safetyTimeout = setTimeout(() => {
      document.querySelectorAll('[data-hero-label],[data-hero-title],[data-hero-desc],[data-scroll-fade]').forEach(el => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 2000);

    gsap.fromTo('[data-hero-label]', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', delay: 0.1 });
    gsap.fromTo('[data-hero-title]', { opacity: 0, y: 50 }, { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out', delay: 0.2 });
    gsap.fromTo('[data-hero-desc]',  { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 1.0, ease: 'power3.out', delay: 0.5,
      onComplete: () => clearTimeout(safetyTimeout) });

    document.querySelectorAll('[data-scroll-fade]').forEach(el => {
      const rect = el.getBoundingClientRect();
      const inView = rect.top < window.innerHeight && rect.bottom > 0;
      if (inView) {
        gsap.fromTo(el, { opacity: 0.3, y: 15 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' });
      } else {
        gsap.set(el, { opacity: 0, y: 35 });
        gsap.to(el, { opacity: 1, y: 0, duration: 1.1, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 88%' } });
      }
    });
  }

  function initContactForm() {
    document.querySelectorAll('[data-contact-form]').forEach((formElement) => {
      const form = formElement as HTMLFormElement;
      const status = form.querySelector('[data-contact-status]') as HTMLParagraphElement | null;
      const submit = form.querySelector('[data-contact-submit]') as HTMLButtonElement | null;

      if (!status || !submit || form.dataset.contactBound === 'true') return;
      form.dataset.contactBound = 'true';

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const formData = new FormData(form);
        const inquiryType = String(formData.get('inquiryType') || 'message');
        const payload = {
          location: String(formData.get('location') || ''),
          locationName: String(formData.get('locationName') || ''),
          name: String(formData.get('name') || '').trim(),
          phone: String(formData.get('phone') || '').trim(),
          email: String(formData.get('email') || '').trim(),
          message: String(formData.get('message') || '').trim(),
          callbackRequested: inquiryType === 'callback',
          inquiryType,
          pageUrl: window.location.href,
        };

        submit.disabled = true;
        status.textContent = inquiryType === 'callback' ? 'Przygotowujemy zgłoszenie oddzwonienia...' : 'Przygotowujemy wiadomość...';

        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          const result = await response.json().catch(() => null);

          if (response.ok) {
            form.reset();
            status.textContent = inquiryType === 'callback'
              ? 'Numer został zapisany. Skontaktujemy się możliwie szybko.'
              : 'Wiadomość została wysłana. Skontaktujemy się możliwie szybko.';
            return;
          }

          if (result?.code === 'delivery_not_configured') {
            const subject = encodeURIComponent(
              inquiryType === 'callback'
                ? `Prośba o kontakt telefoniczny (${payload.locationName})`
                : `Nowa wiadomość ze strony ili Clinic (${payload.locationName})`
            );
            const body = encodeURIComponent(
              [
                `Lokalizacja: ${payload.locationName}`,
                `Typ zgłoszenia: ${inquiryType === 'callback' ? 'prośba o oddzwonienie' : 'wiadomość kontaktowa'}`,
                `Imię i nazwisko: ${payload.name}`,
                `Telefon: ${payload.phone}`,
                `E-mail: ${payload.email || 'nie podano'}`,
                '',
                inquiryType === 'callback' ? 'Dodatkowe informacje:' : 'Wiadomość:',
                payload.message || 'brak',
                '',
                `Źródło: ${payload.pageUrl}`,
              ].join('\n')
            );

            window.location.href = `mailto:kontakt@iliclinic.pl?subject=${subject}&body=${body}`;
            status.textContent = 'Otworzyliśmy gotową wiadomość e-mail do wysłania.';
            return;
          }

          status.textContent = result?.error || 'Nie udało się wysłać formularza. Spróbuj ponownie lub zadzwoń do gabinetu.';
        } catch {
          status.textContent = 'Wystąpił problem z wysyłką. Spróbuj ponownie lub skontaktuj się telefonicznie.';
        } finally {
          submit.disabled = false;
        }
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    initAnimations();
    initContactForm();
  });
  initAnimations();
  initContactForm();
</script>
