---
import BaseLayout from '../../layouts/BaseLayout.astro';
import locations from '../../data/locations.json';
import BooksyIcon from '../../components/BooksyIcon.astro';

export const prerender = false;

const { location } = Astro.params;
const locationData = locations[location as keyof typeof locations];
const salonName = (locationData as any).salonName || `ili Clinic ${locationData.name}`;
const locationSeo = (locationData as any).seo ?? {};
if (!locationData || location !== 'pruszkow') {
  return Astro.redirect('/');
}

Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=60, stale-while-revalidate=300');
const booksyUrl = (locationData as any).booksy as string;

// ── Fetch Booksy pricing on request ─────────────────────────────
interface ServiceVariant {
  duration?: number;
  price?: number | null;
  label?: string;
}
interface BooksyService {
  name: string;
  variants?: ServiceVariant[];
}
interface BooksyCategory {
  name: string;
  services: BooksyService[];
}
interface PricingRow {
  name: string;
  duration?: number;
  price?: number | null;
}
interface PricingCategory {
  name: string;
  services: PricingRow[];
}

let categories: PricingCategory[] = [];
try {
  const res = await fetch('https://pl.booksy.com/api/pl/2/customer_api/businesses/113463', {
    headers: { 'X-Api-Key': 'widget-efab2853-7166-492f-b78f-925d33698cd4' },
    cache: 'no-store',
  });
  if (res.ok) {
    const data = await res.json();
    categories = (data?.business?.service_categories ?? [])
      .map((category: BooksyCategory) => ({
        name: category.name,
        services: (category.services ?? []).flatMap((service) => {
          const variants = service.variants ?? [];

          if (variants.length <= 1) {
            const variant = variants[0];
            return [{
              name: service.name,
              duration: variant?.duration,
              price: variant?.price ?? null,
            }];
          }

          return variants.map((variant) => ({
            name: variant.label?.trim()
              ? `${service.name} — ${variant.label.trim()}`
              : service.name,
            duration: variant.duration,
            price: variant.price ?? null,
          }));
        }),
      }))
      .filter((category: PricingCategory) => category.services.length > 0);
  } else {
    console.warn('[cennik] Booksy returned', res.status);
  }
} catch (e) {
  console.warn('[cennik] Booksy fetch failed at build time:', e);
}

// ── Helpers ──────────────────────────────────────────────────────
function slugify(str: string) {
  const map: Record<string, string> = { ą:'a',ć:'c',ę:'e',ł:'l',ń:'n',ó:'o',ś:'s',ź:'z',ż:'z' };
  return str.toLowerCase()
    .replace(/[ąćęłńóśźż]/g, c => map[c] ?? c)
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

function getCatId(name: string, i: number) {
  return `cat-${slugify(name)}-${i}`;
}

function pluralServices(n: number) {
  if (n === 1) return '1 usługa';
  if (n < 5) return `${n} usługi`;
  return `${n} usług`;
}
---

<BaseLayout
  title={locationSeo.pricingTitle ?? `Cennik — ${salonName}`}
  description={locationSeo.pricingDescription ?? `Aktualny cennik zabiegów ${salonName}. Medycyna estetyczna, pielęgnacja twarzy, depilacja laserowa, trychologia i wiele więcej.`}
  location={location as 'pruszkow' | 'ostroleka'}
>

  <!-- ─── HERO ──────────────────────────────────────────────── -->
  <section class="pt-44 lg:pt-44 pb-16 bg-surface">
    <div class="max-w-7xl mx-auto px-6">
      <span class="text-primary font-body tracking-[0.4em] uppercase text-[10px] mb-8 block font-medium" data-hero-label>Cennik</span>
      <h1 class="font-heading text-3xl sm:text-5xl lg:text-7xl text-text-main leading-[0.95] tracking-[-0.02em] mb-6" data-hero-title>
        Przejrzyste<br /><em class="not-italic text-primary">ceny zabiegów</em>
      </h1>
      <p class="font-body text-text-muted text-lg leading-relaxed max-w-md font-light mt-8" data-hero-desc>
        Ceny pobrane z systemu rezerwacji Booksy.
        Odświeżane na bieżąco przy wejściu na stronę.
      </p>
    </div>
  </section>

  {categories.length > 0 ? (
    <>
      <!-- ─── FLOATING CATEGORY NAV ────────────────────────────── -->
      <div id="category-nav-wrapper" class="fixed bottom-0 left-0 right-0 z-40 px-0 pointer-events-none transition-opacity duration-200 ease-out md:bottom-6 md:px-6">
        <div class="max-w-none mx-auto md:max-w-4xl">
          <div class="bg-white/80 backdrop-blur-xl border border-white/40 shadow-[0_8px_24px_rgba(0,0,0,0.10)] rounded-t-[28px] rounded-b-none px-3 py-3 w-full pointer-events-auto md:bg-white/85 md:backdrop-blur-lg md:rounded-[32px] md:px-5">
            <div class="category-nav-row">
              <button
                type="button"
                id="category-nav-prev"
                class="category-nav-arrow"
                aria-label="Przewiń kategorie w lewo"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
              <div id="category-nav" class="category-nav-track scrollbar-hide">
                {categories.map((cat, i) => (
                  <button
                    class={`category-pill filter-btn px-3 py-1 text-[8px] font-body tracking-[0.1em] uppercase rounded-full transition-all border whitespace-nowrap shrink-0${i === 0 ? ' active bg-primary text-surface border-primary' : ' bg-transparent text-text-muted border-primary/20 hover:border-primary hover:text-text-main'}`}
                    data-target={getCatId(cat.name, i)}
                  >
                    {cat.name}
                  </button>
                ))}
              </div>
              <button
                type="button"
                id="category-nav-next"
                class="category-nav-arrow"
                aria-label="Przewiń kategorie w prawo"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ─── PRICE LIST ────────────────────────────────────────── -->
      <section id="price-list-area" class="pb-48 bg-surface">
        <div class="max-w-7xl mx-auto px-6 pt-12 space-y-0">
          {categories.map((cat, i) => {
            const id = getCatId(cat.name, i);
            const num = String(i + 1).padStart(2, '0');
            return (
              <div class="category-section" id={id}>
                <div class="category-header">
                  <span class="category-number">{num}</span>
                  <h2 class="category-title">{cat.name}</h2>
                </div>
                <span class="category-count">{pluralServices(cat.services.length)}</span>
                <div class="services-table">
                  {cat.services.map(s => {
                    const duration = s.duration ? `${s.duration} min` : '';
                    const price = s.price;
                    return (
                      <div class="service-row">
                        <span class="service-name">{s.name}</span>
                        <div class="service-meta">
                          <span class="service-duration">{duration}</span>
                          {price != null
                            ? <span class="service-price">{price.toLocaleString('pl-PL')} zł</span>
                            : <span class="service-price free">Darmowa</span>
                          }
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    </>
  ) : (
    <!-- ─── FALLBACK (request-time fetch failed) ───────────────── -->
    <section class="py-32 bg-surface">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="font-body text-text-muted text-sm mb-6">Cennik jest dostępny bezpośrednio na Booksy.</p>
        <a
          href={booksyUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 bg-primary text-surface px-8 py-3 rounded-full font-body text-[10px] tracking-widest uppercase hover:brightness-110 transition-all"
        >
          <span>Otwórz Booksy</span>
          <BooksyIcon class="w-4 h-4" />
        </a>
      </div>
    </section>
  )}

  <!-- ─── BOTTOM CTA ────────────────────────────────────────── -->
  <section id="cennik-consultation" class="py-20 bg-surface-dim border-t border-primary/10" data-scroll-fade>
    <div class="max-w-3xl mx-auto px-6 text-center">
      <span class="font-body text-[10px] uppercase tracking-[0.4em] text-primary mb-6 block font-medium">Rezerwacja</span>
      <h2 class="font-heading text-3xl sm:text-5xl text-text-main font-light mb-6 leading-tight">
        Gotowa na zabieg?
      </h2>
      <p class="font-body text-text-muted text-base mb-10 font-light">
        Umów się przez Booksy lub zadzwoń — bezpłatna konsultacja w cenie.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={booksyUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 bg-primary text-surface px-10 py-4 rounded-full font-body text-[10px] tracking-widest uppercase hover:brightness-110 transition-all active:scale-95 w-full sm:w-auto"
        >
          <span>Zarezerwuj przez Booksy</span>
          <BooksyIcon class="w-4 h-4" />
        </a>
        <a
          href={`tel:${locationData.phone.replace(/\s/g, '')}`}
          class="inline-flex items-center justify-center gap-2 border border-primary/20 text-text-main px-10 py-4 rounded-full font-body text-[10px] tracking-widest uppercase hover:bg-surface-dim transition-all w-full sm:w-auto"
        >
          {locationData.phone}
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .scrollbar-hide { scrollbar-width: none; }
  .scrollbar-hide::-webkit-scrollbar { display: none; }

  [data-hero-label],[data-hero-title],[data-hero-desc],[data-scroll-fade] { opacity: 1; }

  .category-nav-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.375rem;
  }
  .category-nav-track {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    min-width: 0;
  }
  .category-nav-arrow {
    width: 1.75rem;
    height: 1.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(var(--color-primary) / 0.2);
    border-radius: 9999px;
    color: rgb(var(--color-text-muted));
    background: rgb(255 255 255 / 0.42);
    backdrop-filter: blur(10px);
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease, opacity 0.18s ease;
    flex-shrink: 0;
  }
  .category-nav-arrow svg {
    width: 0.95rem;
    height: 0.95rem;
  }
  .category-nav-arrow:hover:not(:disabled) {
    border-color: rgb(var(--color-primary));
    color: rgb(var(--color-text-main));
    background: rgb(255 255 255 / 0.68);
  }
  .category-nav-arrow:disabled {
    opacity: 0.38;
    cursor: default;
  }
  .service-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0.75rem;
    margin: 0 -0.75rem;
    border-bottom: 1px solid rgb(var(--color-primary) / 0.07);
    border-radius: 8px;
    transition: background 0.18s ease;
    cursor: default;
  }
  .service-row:hover {
    background: rgb(var(--color-primary) / 0.04);
  }
  .service-row:last-child { border-bottom: none; }
  .service-name {
    font-family: var(--font-body, sans-serif);
    font-size: 0.875rem;
    color: rgb(var(--color-text-main));
    font-weight: 300;
    flex: 1;
    min-width: 0;
    line-height: 1.4;
  }
  .service-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-shrink: 0;
  }
  .service-duration {
    font-family: var(--font-body, sans-serif);
    font-size: 0.7rem;
    color: rgb(var(--color-text-muted));
    min-width: 3.5rem;
    text-align: right;
    letter-spacing: 0.05em;
  }
  .service-price {
    font-family: var(--font-heading, serif);
    font-size: 1.125rem;
    color: rgb(var(--color-text-main));
    font-weight: 300;
    min-width: 5.5rem;
    text-align: right;
    letter-spacing: -0.01em;
  }
  .service-price.free {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body, sans-serif);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgb(var(--color-primary));
    border: 1px solid rgb(var(--color-primary) / 0.3);
    border-radius: 9999px;
    padding: 0.2rem 0.6rem;
    min-width: auto;
  }

  .category-section {
    padding-top: 4rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgb(var(--color-primary) / 0.1);
  }
  .category-section:last-child { border-bottom: none; }

  .category-header {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin-bottom: 0.375rem;
  }
  .category-number {
    font-family: var(--font-heading, serif);
    font-size: 0.75rem;
    color: rgb(var(--color-primary));
    font-weight: 300;
    letter-spacing: 0.05em;
    flex-shrink: 0;
    padding-top: 0.1em;
  }
  .category-title {
    font-family: var(--font-heading, serif);
    font-size: 1.625rem;
    color: rgb(var(--color-text-main));
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .category-count {
    font-family: var(--font-body, sans-serif);
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgb(var(--color-text-muted));
    margin-bottom: 1.5rem;
    display: block;
    padding-left: calc(0.75rem + 1.25rem + 0.75rem);
  }
  .services-table {
    border-top: 1px solid rgb(var(--color-primary) / 0.08);
    padding-top: 0.25rem;
  }

  @media (max-width: 640px) {
    .category-nav-arrow {
      width: 1.625rem;
      height: 1.625rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initCennik() {
    // ── GSAP hero animations ──────────────────────────────────────
    const safety = setTimeout(() => {
      document.querySelectorAll('[data-hero-label],[data-hero-title],[data-hero-desc],[data-scroll-fade]').forEach((el: Element) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 2000);

    gsap.fromTo('[data-hero-label]', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', delay: 0.1 });
    gsap.fromTo('[data-hero-title]', { opacity: 0, y: 50 }, { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out', delay: 0.2 });
    gsap.fromTo('[data-hero-desc]',  { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 1.0, ease: 'power3.out', delay: 0.5,
      onComplete: () => clearTimeout(safety) });

    document.querySelectorAll('[data-scroll-fade]').forEach(el => {
      gsap.set(el, { opacity: 0, y: 30 });
      gsap.to(el, { opacity: 1, y: 0, duration: 1.0, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 88%' } });
    });

    // ── Sticky nav pill scroll tracking ──────────────────────────
    const nav = document.getElementById('category-nav');
    if (!nav) return;

    const prevButton = document.getElementById('category-nav-prev') as HTMLButtonElement | null;
    const nextButton = document.getElementById('category-nav-next') as HTMLButtonElement | null;
    const pills = nav.querySelectorAll<HTMLButtonElement>('.category-pill');

    const syncNavButtons = () => {
      const maxScroll = nav.scrollWidth - nav.clientWidth;
      const current = Math.round(nav.scrollLeft);
      if (prevButton) prevButton.disabled = current <= 0;
      if (nextButton) nextButton.disabled = current >= Math.max(0, maxScroll - 1);
    };

    const scrollNavBy = (direction: 1 | -1) => {
      const amount = Math.max(nav.clientWidth * 0.7, 220);
      nav.scrollBy({ left: amount * direction, behavior: 'smooth' });
    };

    const setNavVisible = (visible: boolean) => {
      const wrapper = document.getElementById('category-nav-wrapper');
      if (!wrapper) return;
      wrapper.classList.toggle('opacity-0', !visible);
      wrapper.classList.toggle('translate-y-6', !visible);
      wrapper.classList.toggle('opacity-100', visible);
      wrapper.classList.toggle('translate-y-0', visible);
    };

    // Pill click → smooth scroll
    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => {
          p.classList.remove('active', 'bg-primary', 'text-surface', 'border-primary');
          p.classList.add('bg-transparent', 'text-text-muted', 'border-primary/20');
        });
        pill.classList.add('active', 'bg-primary', 'text-surface', 'border-primary');
        pill.classList.remove('bg-transparent', 'text-text-muted', 'border-primary/20');
        const target = document.getElementById(pill.dataset.target!);
        if (!target) return;
        const top = target.getBoundingClientRect().top + window.scrollY - 120;
        window.scrollTo({ top, behavior: 'smooth' });
      });
    });

    prevButton?.addEventListener('click', () => scrollNavBy(-1));
    nextButton?.addEventListener('click', () => scrollNavBy(1));
    nav.addEventListener('scroll', syncNavButtons, { passive: true });
    window.addEventListener('resize', syncNavButtons);

    // Active pill tracking via IntersectionObserver
    const sections = document.querySelectorAll('.category-section');
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          pills.forEach(p => {
            const isActive = p.dataset.target === id;
            p.classList.toggle('active', isActive);
            p.classList.toggle('bg-primary', isActive);
            p.classList.toggle('text-surface', isActive);
            p.classList.toggle('border-primary', isActive);
            p.classList.toggle('bg-transparent', !isActive);
            p.classList.toggle('text-text-muted', !isActive);
            p.classList.toggle('border-primary/20', !isActive);
          });
          const activePill = nav.querySelector<HTMLElement>(`.category-pill[data-target="${id}"]`);
          activePill?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      });
    }, { rootMargin: '-120px 0px -60% 0px', threshold: 0 });

    sections.forEach(s => observer.observe(s));
    syncNavButtons();

    const priceListArea = document.getElementById('price-list-area');
    const consultationSection = document.getElementById('cennik-consultation');
    let priceListVisible = true;
    let consultationVisible = false;

    const syncNavVisibility = () => {
      setNavVisible(priceListVisible && !consultationVisible);
    };

    if (priceListArea) {
      const visibilityObserver = new IntersectionObserver(([entry]) => {
        priceListVisible = entry.isIntersecting;
        syncNavVisibility();
      }, { threshold: 0, rootMargin: '-8% 0px 0px 0px' });
      visibilityObserver.observe(priceListArea);
    }

    if (consultationSection) {
      const consultationObserver = new IntersectionObserver(([entry]) => {
        consultationVisible = entry.isIntersecting;
        syncNavVisibility();
      }, { threshold: 0, rootMargin: '0px' });
      consultationObserver.observe(consultationSection);
    }
  }

  document.addEventListener('astro:page-load', initCennik);
  initCennik();
</script>
