---
import BaseLayout from '../../layouts/BaseLayout.astro';
import locations from '../../data/locations.json';
import CmsImage from '../../components/CmsImage.astro';

export function getStaticPaths() {
  return [
    { params: { location: 'pruszkow' } },
    { params: { location: 'ostroleka' } },
  ];
}

const { location } = Astro.params;
const locationData = locations[location as keyof typeof locations];
const salonName = (locationData as any).salonName || `ili Clinic ${locationData.name}`;
const locationSeo = (locationData as any).seo ?? {};
---

<BaseLayout
  title={locationSeo.aboutTitle ?? `O nas - ${salonName}`}
  description={locationSeo.aboutDescription ?? `Poznaj gabinet ${salonName} w ${locationData.name}. Zespół doświadczonych specjalistów medycyny estetycznej.`}
  location={location as 'pruszkow' | 'ostroleka'}
>

  <!-- ─── HERO ──────────────────────────────────────────────── -->
  <section class="pt-44 lg:pt-44 pb-28 bg-surface relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col lg:flex-row items-start gap-16 lg:gap-24">

        <!-- Text -->
        <div class="w-full lg:w-[48%]" data-hero-text>
          <span class="text-primary font-body tracking-[0.4em] uppercase text-[10px] mb-8 block font-medium">O Klinice</span>
          <h1 class="font-heading text-3xl sm:text-5xl lg:text-7xl text-text-main leading-[0.95] tracking-[-0.02em] mb-10">
            Klinika<br /><em class="not-italic text-primary">Zdrowej</em><br />Skóry
          </h1>
          <p class="font-body text-text-muted text-lg leading-relaxed max-w-sm mb-14 font-light">
            ili Clinic to miejsce, gdzie pasja do kosmetologii spotyka się z wiedzą medyczną.
            Holistyczne podejście, naturalne efekty.
          </p>
          <div class="flex items-center gap-10">
            <div>
              <div class="font-heading text-5xl text-primary font-light leading-none">150+</div>
              <div class="font-body text-[9px] uppercase tracking-[0.3em] text-text-muted mt-2 leading-tight">Zadowolonych<br />Pacjentów</div>
            </div>
            <div class="w-px h-14 bg-primary/20"></div>
            <div>
              <div class="font-heading text-5xl text-primary font-light leading-none">15+</div>
              <div class="font-body text-[9px] uppercase tracking-[0.3em] text-text-muted mt-2 leading-tight">Lat<br />Doświadczenia</div>
            </div>
          </div>
        </div>

        <!-- Image -->
        <div class="w-full lg:w-[52%] relative" data-hero-image>
          <div class="relative aspect-[4/5] overflow-hidden rounded-[40px] md:rounded-[60px] shadow-2xl group">
            <CmsImage
              src="/images/oferta.png"
              alt="Wnętrze gabinetu ili Clinic"
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 52vw, 100vw"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/30 via-transparent to-transparent"></div>
          </div>
          <!-- Floating tag -->
          <div class="absolute -bottom-5 left-8 bg-surface border border-primary/10 rounded-2xl px-7 py-4 shadow-lg">
            <div class="font-body text-[9px] uppercase tracking-[0.3em] text-text-muted mb-1">Nasza klinika</div>
            <div class="font-heading text-xl text-text-main">{salonName}</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── PATRICIA ──────────────────────────────────────────── -->
  <section class="py-32 bg-primary relative overflow-hidden">
    <div class="container mx-auto px-6 max-w-7xl">
      <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">

        <div data-scroll-fade>
          <span class="text-accent font-body tracking-[0.4em] uppercase text-[10px] mb-8 block font-medium">Założycielka</span>
          <h2 class="font-heading text-5xl lg:text-6xl text-white mb-4 leading-tight font-light">
            Ekspert przy<br />każdym kroku
          </h2>
          <p class="font-body text-white/50 text-[10px] uppercase tracking-[0.25em] mb-10">
            Kosmetolog · Trycholog · Pielęgniarka
          </p>

          <blockquote class="border-l-2 border-accent pl-8 mb-10">
            <p class="font-heading text-2xl text-white/90 italic leading-relaxed font-light">
              „Kluczem do efektów jest wiedza, którą uzyskuję podczas konsultacji
              z moim pacjentem i wzajemna współpraca."
            </p>
          </blockquote>

          <div class="space-y-4 text-white/70 font-light leading-relaxed font-body text-sm">
            <p>
              Założycielka ili Clinic jest wykształconym <span class="text-white font-medium">kosmetologiem oraz
              pielęgniarką</span>, co pozwala jej na holistyczne podejście do zdrowia skóry. Pierwsze kroki
              stawiała w renomowanych gabinetach i klinikach w Warszawie i okolicach.
            </p>
            <p>
              Specjalizuje się w <span class="text-white font-medium">terapiach specjalistycznych oraz
              zabiegach stymulujących</span>. Nieustannie podnosi kwalifikacje na światowych kongresach
              medycyny estetycznej.
            </p>
          </div>

          <a
            href="https://www.instagram.com/patricia.kosmetolog/"
            target="_blank"
            rel="noopener"
            class="mt-10 inline-flex items-center gap-3 text-accent hover:text-white transition-colors font-body text-xs uppercase tracking-[0.2em]"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
            @patricia.kosmetolog
          </a>
        </div>

        <div class="relative" data-scroll-fade>
          <div class="aspect-[3/4] overflow-hidden rounded-[40px] md:rounded-[60px] shadow-2xl group">
            <CmsImage
              src="/images/Ili-3.jpg"
              alt="Założycielka ili Clinic"
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/60 via-transparent to-transparent"></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── EQUIPMENT ─────────────────────────────────────────── -->
  <section class="py-32 bg-surface">
    <div class="container mx-auto px-6 max-w-7xl">
      <div class="flex flex-col lg:flex-row gap-16 lg:gap-24 items-center">

        <div class="w-full lg:w-1/2" data-scroll-fade>
          <div class="aspect-[4/3] overflow-hidden rounded-[40px] shadow-xl group">
            <CmsImage
              src="/images/pruszkow-1.jpeg"
              alt="Gabinet zabiegowy ili Clinic"
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
              widths={[480, 720, 960]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              loading="lazy"
            />
          </div>
        </div>

        <div class="w-full lg:w-1/2" data-scroll-fade>
          <span class="text-primary font-body tracking-[0.4em] uppercase text-[10px] mb-8 block font-medium">Wyposażenie</span>
          <h2 class="font-heading text-5xl lg:text-6xl text-text-main mb-8 leading-tight font-light">
            Nowoczesne<br />wyposażenie
          </h2>
          <p class="font-body text-text-muted text-base leading-relaxed mb-12 font-light">
            Nasz gabinet wyposażony jest w najnowocześniejszy sprzęt do zabiegów
            laseroterapii i medycyny estetycznej.
          </p>

          <div class="border-t border-primary/10">

            <div
              class="group py-6 border-b border-primary/10 flex items-center px-4 -mx-4 rounded-lg"
            >
              <div>
                <div class="font-heading text-xl text-text-main group-hover:text-primary transition-colors">AlexDual Xlase</div>
                <div class="font-body text-[10px] uppercase tracking-[0.15em] text-text-muted mt-1">Profesjonalny laser do depilacji i liftingu</div>
              </div>
            </div>

            <div
              class="group py-6 border-b border-primary/10 flex items-center px-4 -mx-4 rounded-lg"
            >
              <div>
                <div class="font-heading text-xl text-text-main group-hover:text-primary transition-colors">Dermapen 4.0</div>
                <div class="font-body text-[10px] uppercase tracking-[0.15em] text-text-muted mt-1">Złoty standard mikronakłuwania</div>
              </div>
            </div>

            <div
              class="group py-6 border-b border-primary/10 flex items-center px-4 -mx-4 rounded-lg"
            >
              <div>
                <div class="font-heading text-xl text-text-main group-hover:text-primary transition-colors">Gold Needle RF</div>
                <div class="font-body text-[10px] uppercase tracking-[0.15em] text-text-muted mt-1">Fala radiowa mikroigłowa</div>
              </div>
            </div>

            <div
              class="group py-6 border-b border-primary/10 flex items-center px-4 -mx-4 rounded-lg"
            >
              <div>
                <div class="font-heading text-xl text-text-main group-hover:text-primary transition-colors">AquaSure H2</div>
                <div class="font-body text-[10px] uppercase tracking-[0.15em] text-text-muted mt-1">Oczyszczanie wodorowe</div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── VALUES ────────────────────────────────────────────── -->
  <section class="py-32 bg-surface-dim">
    <div class="container mx-auto px-6 max-w-7xl">
      <div class="grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-14 lg:gap-20 items-end mb-18 lg:mb-24">
        <div data-scroll-fade>
          <span class="text-primary font-body tracking-[0.4em] uppercase text-[10px] mb-6 block font-medium">Nasze Wartości</span>
          <h2 class="font-heading text-4xl sm:text-5xl md:text-6xl text-text-main font-light leading-[0.96]">Co nas wyróżnia</h2>
        </div>
        <div class="lg:max-w-2xl lg:justify-self-end" data-scroll-fade>
          <p class="text-text-muted font-body text-sm sm:text-base leading-relaxed font-light">
            Najważniejsze w naszej pracy nie jest tempo ani spektakl. Liczy się sposób prowadzenia pacjenta:
            uważny, dyskretny i precyzyjny od pierwszej rozmowy po końcową ocenę efektu.
          </p>
        </div>
      </div>

      <div class="border-t border-primary/10">
        <div class="grid lg:grid-cols-3 gap-0">
          <article class="py-12 lg:py-14 lg:pr-10 border-b lg:border-b-0 lg:border-r border-primary/10" data-scroll-fade>
            <div class="mb-10">
              <div class="h-20 w-20 rounded-full border border-primary/12 bg-surface flex items-center justify-center text-primary">
                <svg class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.35" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
            </div>
            <h3 class="text-3xl sm:text-[2.1rem] mb-5 font-heading text-text-main font-light leading-[1.02]">Bezpieczeństwo</h3>
            <p class="text-text-muted font-light text-sm sm:text-base leading-relaxed font-body max-w-sm">
              Każdy zabieg wykonujemy w oparciu o procedury, certyfikowane preparaty i standard pracy, który nie zostawia miejsca na przypadek.
            </p>
          </article>

          <article class="py-12 lg:py-14 lg:px-10 border-b lg:border-b-0 lg:border-r border-primary/10" data-scroll-fade>
            <div class="mb-10">
              <div class="h-20 w-20 rounded-full border border-primary/12 bg-surface flex items-center justify-center text-primary">
                <svg class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.35" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </div>
            </div>
            <h3 class="text-3xl sm:text-[2.1rem] mb-5 font-heading text-text-main font-light leading-[1.02]">Naturalność</h3>
            <p class="text-text-muted font-light text-sm sm:text-base leading-relaxed font-body max-w-sm">
              Subtelny efekt nie dzieje się przypadkiem. To wynik umiaru, doświadczenia i bardzo świadomego wyboru tego, czego nie robić.
            </p>
          </article>

          <article class="py-12 lg:py-14 lg:pl-10" data-scroll-fade>
            <div class="mb-10">
              <div class="h-20 w-20 rounded-full border border-primary/12 bg-surface flex items-center justify-center text-primary">
                <svg class="w-9 h-9" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.35" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
            </div>
            <h3 class="text-3xl sm:text-[2.1rem] mb-5 font-heading text-text-main font-light leading-[1.02]">Indywidualność</h3>
            <p class="text-text-muted font-light text-sm sm:text-base leading-relaxed font-body max-w-sm">
              Każdy plan terapii budujemy od podstaw. Nie dopasowujemy pacjenta do gotowej procedury, tylko procedurę do jego rysów, rytmu życia i komfortu.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── CTA ───────────────────────────────────────────────── -->
  <section class="py-32 bg-surface">
    <div class="max-w-4xl mx-auto px-6 text-center" data-scroll-fade>
      <span class="text-primary font-body tracking-[0.4em] uppercase text-[10px] mb-8 block font-medium">Umów wizytę</span>
      <h2 class="font-heading text-5xl lg:text-6xl text-text-main mb-8 font-light leading-tight">
        Gotowa na<br />konsultację?
      </h2>
      <p class="font-body text-text-muted mb-12 max-w-md mx-auto leading-relaxed font-light">
        Umów się na bezpłatną konsultację i dowiedz się, jak możemy Ci pomóc.
      </p>
      <div class="flex flex-wrap justify-center gap-6">
        <a
          href={`tel:${locationData.phone.replace(/\s/g, '')}`}
          class="inline-flex items-center gap-3 bg-primary text-surface px-10 py-4 rounded-full font-body text-xs uppercase tracking-widest hover:brightness-110 transition-all active:scale-95"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {locationData.phone}
        </a>
        <a
          href={`/${location}/kontakt`}
          class="inline-flex items-center gap-3 border border-primary text-primary px-10 py-4 rounded-full font-body text-xs uppercase tracking-widest hover:bg-primary hover:text-surface transition-all"
        >
          Wyślij zapytanie
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Safety: scroll-fade elements start visible; JS animates from partial opacity only when off-screen */
  [data-scroll-fade] { opacity: 1; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initAnimations() {
    const safetyTimeout = setTimeout(() => {
      document.querySelectorAll('[data-hero-text],[data-hero-image],[data-scroll-fade]').forEach(el => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 2000);

    gsap.fromTo('[data-hero-text]', { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out', delay: 0.2 });
    gsap.fromTo('[data-hero-image]', { opacity: 0, y: 60 }, { opacity: 1, y: 0, duration: 1.4, ease: 'power3.out', delay: 0.4,
      onComplete: () => clearTimeout(safetyTimeout) });

    document.querySelectorAll('[data-scroll-fade]').forEach(el => {
      const rect = el.getBoundingClientRect();
      const inView = rect.top < window.innerHeight && rect.bottom > 0;
      if (inView) {
        gsap.fromTo(el, { opacity: 0.3, y: 15 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' });
      } else {
        gsap.set(el, { opacity: 0, y: 35 });
        gsap.to(el, { opacity: 1, y: 0, duration: 1.1, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 88%' } });
      }
    });
  }

  document.addEventListener('astro:page-load', initAnimations);
  initAnimations();
</script>
