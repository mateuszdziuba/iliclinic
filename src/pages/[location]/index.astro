---
import BaseLayout from '../../layouts/BaseLayout.astro';
import locations from '../../data/locations.json';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { location: 'pruszkow' } },
    { params: { location: 'ostroleka' } },
  ];
}

const { location } = Astro.params;
const locationData = locations[location as keyof typeof locations];

if (!locationData) {
  return Astro.redirect('/');
}

// Get featured treatments
const allTreatments = await getCollection('zabiegi');
const featuredTreatments = allTreatments
  .filter(t => t.data.featured && t.data.locations.includes(location))
  .slice(0, 4);

// Get partner brands
const allBrands = await getCollection('marki');
const brands = allBrands.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout 
  title={`Ili Clinic ${locationData.name} - Klinika Zdrowej Skóry`} 
  description={`Ili Clinic ${locationData.name} - Skóra, zdrowie, relaks. Holistyczne podejście do dbania o zdrowie, ciało i duszę. Zabiegi medycyny estetycznej w ${locationData.address.city}.`}
  location={location as 'pruszkow' | 'ostroleka'}
>
  <!-- Hero Section -->
  <section class="relative py-24 lg:py-32 overflow-hidden">
    <!-- Background -->
    <div class="absolute inset-0 bg-gradient-to-br from-surface-warm via-surface-cream to-surface-warm"></div>
    <div class="absolute top-0 right-0 w-1/2 h-full bg-primary-medical/3 mask-organic"></div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-primary-medical font-medium mb-4 tracking-wide uppercase text-sm">
            Ili Clinic {locationData.name}
          </p>
          
          <h1 class="font-heading text-4xl lg:text-6xl text-text-deep mb-6 leading-tight">
            Klinika Zdrowej Skóry<br />
            <span class="text-primary-medical">Skóra, zdrowie, relaks</span>
          </h1>
          
          <p class="text-lg text-text-muted mb-4 max-w-lg">
            Ili Clinic zostało stworzone by koncentrować się na człowieku i jego potrzebach.
          </p>
          
          <p class="text-text-muted mb-8 max-w-lg">
            Charakteryzuje nas holistyczne podejście do dbania o zdrowie, ciało i duszę. 
            Oferujemy nie jedno, a wiele rozwiązań na Twoje problemy z zakresu zdrowia skóry i ciała.
          </p>
          
          <div class="flex flex-wrap gap-4">
            <a 
              href={`/${location}/zabiegi`}
              class="bg-primary-medical text-text-light px-8 py-4 rounded-sm font-medium hover:bg-primary-medical-dark transition-colors"
            >
              Zobacz zabiegi
            </a>
            <a 
              href={`/${location}/kontakt`}
              class="border-2 border-primary-medical text-primary-medical px-8 py-4 rounded-sm font-medium hover:bg-primary-medical hover:text-text-light transition-colors"
            >
              Umów wizytę
            </a>
          </div>
        </div>
        
        <!-- Hero Image -->
        <div class="relative">
          <img 
            src="/images/hero-clinic.png"
            alt="Wnętrze gabinetu Ili Clinic"
            class="w-full h-auto mask-organic"
            width="600"
            height="600"
          />
          <div class="absolute -bottom-4 -left-4 w-24 h-24 bg-accent-gold/30 rounded-sm"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-primary-medical font-medium mb-4 tracking-wide uppercase text-sm">
          Szeroki wachlarz usług
        </p>
        <h2 class="font-heading text-3xl lg:text-4xl text-text-deep mb-6">
          W czym możemy Ci pomóc?
        </h2>
        <p class="text-text-muted max-w-2xl mx-auto">
          W klinice oferujemy nie jedno, a wiele rozwiązań na Twoje problemy 
          z zakresu zdrowia skóry i ciała.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-surface-cream p-6 text-center hover-lift">
          <div class="w-14 h-14 mx-auto mb-4 bg-primary-medical/10 rounded-sm flex items-center justify-center">
            <svg class="w-7 h-7 text-primary-medical" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text-deep mb-2">Kosmetologia</h3>
          <p class="text-text-muted text-sm">Zabiegi pielęgnacyjne i odmładzające dla Twojej skóry</p>
        </div>
        
        <div class="bg-surface-cream p-6 text-center hover-lift">
          <div class="w-14 h-14 mx-auto mb-4 bg-primary-medical/10 rounded-sm flex items-center justify-center">
            <svg class="w-7 h-7 text-primary-medical" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text-deep mb-2">Medycyna Estetyczna</h3>
          <p class="text-text-muted text-sm">Botoks, wypełniacze, stymulatory tkankowe</p>
        </div>
        
        <div class="bg-surface-cream p-6 text-center hover-lift">
          <div class="w-14 h-14 mx-auto mb-4 bg-primary-medical/10 rounded-sm flex items-center justify-center">
            <svg class="w-7 h-7 text-primary-medical" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text-deep mb-2">Hi-Tech / Laser</h3>
          <p class="text-text-muted text-sm">Depilacja laserowa, termolifting, fala radiowa</p>
        </div>
        
        <div class="bg-surface-cream p-6 text-center hover-lift">
          <div class="w-14 h-14 mx-auto mb-4 bg-primary-medical/10 rounded-sm flex items-center justify-center">
            <svg class="w-7 h-7 text-primary-medical" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text-deep mb-2">Trychologia</h3>
          <p class="text-text-muted text-sm">Konsultacje i zabiegi na skórę głowy</p>
        </div>
      </div>
      
      <div class="text-center mt-10">
        <a 
          href={`/${location}/zabiegi`}
          class="inline-flex items-center gap-2 text-primary-medical font-medium hover:text-primary-medical-dark transition-colors"
        >
          Zobacz pełną ofertę zabiegów
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Team Philosophy -->
  <section class="py-20 bg-surface-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-primary-medical font-medium mb-4 tracking-wide uppercase text-sm">
            Nasz zespół
          </p>
          <h2 class="font-heading text-3xl lg:text-4xl text-text-deep mb-6">
            Doświadczenie i pasja
          </h2>
          
          <blockquote class="border-l-4 border-primary-medical pl-6 my-6 italic text-text-muted text-lg">
            „Nasz zespół nie powstał przez przypadek. Łączy nas doświadczenie 
            i pasja do tego co robimy."
          </blockquote>
          
          <p class="text-text-muted mb-6">
            Specjalizujemy się w różnych dziedzinach, co pozwala nam zaopiekować się 
            naszymi pacjentami w pełni. Dzięki doświadczeniu i ciągle poszerzanej wiedzy 
            możemy świadczyć usługi skuteczne, bezpieczne i dopasowane do indywidualnych potrzeb.
          </p>
          
          <a 
            href={`/${location}/o-nas`}
            class="inline-flex items-center gap-2 text-primary-medical font-medium hover:text-primary-medical-dark transition-colors"
          >
            Poznaj nas bliżej
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        
        <div>
          <img 
            src="/images/treatment-room.png"
            alt="Gabinet zabiegowy Ili Clinic"
            class="w-full h-auto rounded-sm shadow-lg"
            width="600"
            height="600"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Treatments -->
  {featuredTreatments.length > 0 && (
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="font-heading text-3xl lg:text-4xl text-text-deep mb-4">
            Polecane zabiegi
          </h2>
          <p class="text-text-muted max-w-2xl mx-auto">
            Najpopularniejsze zabiegi wybierane przez naszych pacjentów.
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredTreatments.map(treatment => {
            const price = location === 'pruszkow' 
              ? treatment.data.price_pruszkow 
              : treatment.data.price_ostroleka;
            
            return (
              <a 
                href={`/${location}/zabiegi/${treatment.slug}`}
                class="group bg-white border border-primary-medical/10 overflow-hidden hover-lift"
              >
                <div class="aspect-[4/3] bg-gradient-to-br from-primary-medical/10 to-accent-gold/10 relative">
                  <span class="absolute top-3 left-3 bg-accent-gold text-text-deep text-xs font-medium px-2 py-1 rounded-sm">
                    Polecany
                  </span>
                </div>
                <div class="p-4">
                  <h3 class="font-heading text-lg text-text-deep mb-2 group-hover:text-primary-medical transition-colors">
                    {treatment.data.title}
                  </h3>
                  <div class="flex items-center justify-between text-sm">
                    {price && (
                      <span class="text-primary-medical font-medium">od {price} zł</span>
                    )}
                    {treatment.data.duration && (
                      <span class="text-text-muted">{treatment.data.duration}</span>
                    )}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
        
        <div class="text-center mt-10">
          <a 
            href={`/${location}/zabiegi`}
            class="inline-block bg-primary-medical text-text-light px-8 py-4 rounded-sm font-medium hover:bg-primary-medical-dark transition-colors"
          >
            Zobacz wszystkie zabiegi
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Why Choose Us -->
  <section class="py-20 bg-primary-medical text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="font-heading text-3xl lg:text-4xl mb-4">
          Dlaczego Ili Clinic?
        </h2>
        <p class="text-white/90 max-w-2xl mx-auto">
          Dzięki doświadczeniu i ciągle poszerzanej wiedzy świadczymy usługi skuteczne, 
          bezpieczne i dopasowane do Twoich indywidualnych potrzeb.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-6 bg-white/20 rounded-sm flex items-center justify-center">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-heading text-xl mb-3">Bezpieczeństwo</h3>
          <p class="text-white/90 text-sm">
            Wszystkie zabiegi wykonywane są przez certyfikowanych specjalistów 
            z użyciem sprawdzonych preparatów.
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-6 bg-white/20 rounded-sm flex items-center justify-center">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="font-heading text-xl mb-3">Naturalne efekty</h3>
          <p class="text-white/90 text-sm">
            Stawiamy na subtelne korekty, które podkreślają Twoje naturalne piękno 
            i zachowują indywidualny charakter.
          </p>
        </div>
        
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-6 bg-white/20 rounded-sm flex items-center justify-center">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="font-heading text-xl mb-3">Indywidualne podejście</h3>
          <p class="text-white/90 text-sm">
            Każdy zabieg poprzedzony jest konsultacją, podczas której dobieramy 
            optymalne rozwiązanie dla Twoich potrzeb.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner Brands -->
  {brands.length > 0 && (
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <p class="text-primary-medical font-medium mb-2 tracking-wide uppercase text-sm">
            Zaufane marki
          </p>
          <h2 class="font-heading text-2xl lg:text-3xl text-text-deep">
            Współpracujemy z najlepszymi
          </h2>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 items-center">
          {brands.map(brand => (
            brand.data.url ? (
              <a 
                href={brand.data.url}
                target="_blank"
                rel="noopener"
                class="flex items-center justify-center p-4 grayscale hover:grayscale-0 opacity-60 hover:opacity-100 transition-all duration-300"
              >
                <img 
                  src={brand.data.logo}
                  alt={brand.data.name}
                  class="max-h-12 w-auto object-contain"
                  loading="lazy"
                />
              </a>
            ) : (
              <div class="flex items-center justify-center p-4 grayscale opacity-60">
                <img 
                  src={brand.data.logo}
                  alt={brand.data.name}
                  class="max-h-12 w-auto object-contain"
                  loading="lazy"
                />
              </div>
            )
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
