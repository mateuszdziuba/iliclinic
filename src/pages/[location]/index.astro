---
import BaseLayout from '../../layouts/BaseLayout.astro';
import locations from '../../data/locations.json';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { location: 'pruszkow' } },
    { params: { location: 'ostroleka' } },
  ];
}

const { location } = Astro.params;
const locationData = locations[location as keyof typeof locations];

if (!locationData) {
  return Astro.redirect('/');
}

// Get featured treatments
const allTreatments = await getCollection('zabiegi');
const featuredTreatments = allTreatments
  .filter(t => t.data.featured && t.data.locations.includes(location))
  .slice(0, 4);

// Get partner brands
const allBrands = await getCollection('marki');
const brands = allBrands.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout 
  title={`Ili Clinic ${locationData.name} - Holistyczna Klinika Skóry`} 
  description={`Ili Clinic ${locationData.name} - Skóra, zdrowie, relaks. Holistyczne podejście do dbania o zdrowie, ciało i duszę w ${locationData.address.city}.`}
  location={location as 'pruszkow' | 'ostroleka'}
>
  <!-- Cinematic Hero -->
  <section class="relative min-h-[100svh] w-full flex flex-col justify-end pb-12 overflow-hidden bg-surface">
    <!-- Atmospheric Background -->
    <div class="absolute inset-x-0 top-0 h-[80%] bg-primary/5 rounded-b-[4rem] sm:rounded-b-[8rem] -z-10" data-hero-bg></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 pt-32">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end">
        
        <!-- Typography Element -->
        <div class="lg:col-span-8 flex flex-col justify-end">
          <div class="text-reveal-mask mb-6">
            <span class="text-reveal-inner font-body text-[10px] tracking-[0.2em] text-primary uppercase inline-block border border-primary/20 rounded-full px-3 py-1" data-hero-text>
              Ili Clinic {locationData.name}
            </span>
          </div>

          <h1 class="font-heading text-5xl sm:text-7xl lg:text-[6rem] leading-[0.9] tracking-[-0.03em] text-text-main mb-8">
            <div class="text-reveal-mask w-full">
              <span class="text-reveal-inner block" data-hero-text>Klinika Zdrowej</span>
            </div>
            <div class="text-reveal-mask w-full">
              <span class="text-reveal-inner block italic text-primary" data-hero-text>Skóry.</span>
            </div>
          </h1>

          <div class="text-reveal-mask mb-4">
            <p class="text-reveal-inner font-body text-text-main max-w-lg text-sm sm:text-base leading-relaxed font-medium" data-hero-text>
              Skóra, zdrowie, relaks
            </p>
          </div>

          <div class="text-reveal-mask mb-2">
            <p class="text-reveal-inner font-body text-text-muted max-w-lg text-sm sm:text-base leading-relaxed" data-hero-text>
              Ili Clinic zostało stworzone by koncentrować się na człowieku i jego potrzebach.
            </p>
          </div>

          <div class="text-reveal-mask">
            <p class="text-reveal-inner font-body text-text-muted max-w-lg text-sm sm:text-base leading-relaxed" data-hero-text>
              Charakteryzuje nas holistyczne podejście do dbania o zdrowie, ciało i duszę. Oferujemy nie jedno, a wiele rozwiązań na Twoje problemy z zakresu zdrowia skóry i ciała.
            </p>
          </div>
        </div>

        <!-- Call to Action / Image context -->
        <div class="lg:col-span-4 flex flex-col items-start lg:items-end justify-end h-full mt-12 lg:mt-0 relative">
          <div class="text-reveal-mask mb-6 lg:mb-12 w-full lg:w-auto relative z-20">
            <a href={`/${location}/kontakt`} data-hero-text
              class="text-reveal-inner inline-flex items-center justify-center w-full lg:w-32 lg:h-32 bg-primary text-surface rounded-full font-body text-xs uppercase tracking-widest hover:scale-105 transition-transform duration-500 py-4 lg:py-0 text-center shadow-2xl">
              Umów wizytę
            </a>
          </div>
          
          <div class="w-full relative origin-bottom" data-hero-img>
            <!-- Original Hero framing: Organic background mask & accent box -->
            <div class="absolute -top-4 -right-4 w-1/2 h-full bg-primary/5 mask-organic scale-110 z-0"></div>
            <div class="absolute -bottom-4 -left-4 w-24 h-24 bg-accent/30 rounded-sm z-0"></div>
            
            <img 
              src="/images/hero-clinic.jpg" 
              alt="Ili Clinic Wnętrze" 
              class="w-full h-auto max-h-[60vh] object-cover mask-organic relative z-10 shadow-lg"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Scrolling Manifesto -->
  <section class="py-32 bg-primary text-surface relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center font-heading text-3xl sm:text-4xl lg:text-5xl leading-[1.2] tracking-tight" data-scroll-fade>
        „Nasz zespół nie powstał przez przypadek. <span class="italic text-accent">Łączy nas doświadczenie</span> i pasja do tego co robimy.”
      </div>
      <div class="mt-12 text-center" data-scroll-fade>
        <span class="font-body text-xs tracking-widest uppercase opacity-60">Nasz zespół / Doświadczenie i pasja</span>
      </div>
    </div>
  </section>

  <!-- Cinematic Services Protocol -->
  <section class="py-32 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row justify-between items-end mb-24 gap-8">
        <div>
          <p class="font-body text-[10px] uppercase tracking-widest text-text-muted mb-4" data-scroll-fade>Szeroki wachlarz usług</p>
          <h2 class="font-heading text-4xl sm:text-5xl lg:text-6xl leading-none text-text-main" data-scroll-fade>
            W czym możemy <br/><span class="italic text-primary">Ci pomóc?</span>
          </h2>
        </div>
        <a href={`/${location}/zabiegi`} class="font-body text-xs uppercase tracking-widest text-text-main border-b border-text-main pb-1 hover:text-primary transition-colors" data-scroll-fade>
          Zobacz pełną ofertę
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-8">
        <!-- Service 1 -->
        <article class="group bg-surface-dim p-8 rounded-2xl hover:bg-surface-warm transition-colors duration-500 hover-lift text-center" data-scroll-fade>
          <div class="w-16 h-16 mx-auto mb-6 bg-primary/10 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <p class="font-body text-[10px] uppercase tracking-widest text-text-muted mb-2">Pielęgnacja</p>
          <h3 class="font-heading text-2xl text-text-main mb-3 group-hover:text-primary transition-colors">Kosmetologia</h3>
          <p class="font-body text-sm text-text-muted leading-relaxed">Zabiegi pielęgnacyjne i odmładzające dla Twojej skóry.</p>
        </article>
        
        <!-- Service 2 -->
        <article class="group bg-surface-dim p-8 rounded-2xl hover:bg-surface-warm transition-colors duration-500 hover-lift text-center" data-scroll-fade>
          <div class="w-16 h-16 mx-auto mb-6 bg-primary/10 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
            </svg>
          </div>
          <p class="font-body text-[10px] uppercase tracking-widest text-text-muted mb-2">Iniekcje</p>
          <h3 class="font-heading text-2xl text-text-main mb-3 group-hover:text-primary transition-colors">Medycyna Estetyczna</h3>
          <p class="font-body text-sm text-text-muted leading-relaxed">Botoks, wypełniacze, stymulatory tkankowe.</p>
        </article>

        <!-- Service 3 -->
        <article class="group bg-surface-dim p-8 rounded-2xl hover:bg-surface-warm transition-colors duration-500 hover-lift text-center" data-scroll-fade>
          <div class="w-16 h-16 mx-auto mb-6 bg-primary/10 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <p class="font-body text-[10px] uppercase tracking-widest text-text-muted mb-2">Technologie</p>
          <h3 class="font-heading text-2xl text-text-main mb-3 group-hover:text-primary transition-colors">Hi-Tech / Laser</h3>
          <p class="font-body text-sm text-text-muted leading-relaxed">Depilacja laserowa, termolifting, fala radiowa.</p>
        </article>

        <!-- Service 4 -->
        <article class="group bg-surface-dim p-8 rounded-2xl hover:bg-surface-warm transition-colors duration-500 hover-lift text-center" data-scroll-fade>
           <div class="w-16 h-16 mx-auto mb-6 bg-primary/10 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
            <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707" />
            </svg>
          </div>
          <p class="font-body text-[10px] uppercase tracking-widest text-text-muted mb-2">Skóra Głowy</p>
          <h3 class="font-heading text-2xl text-text-main mb-3 group-hover:text-primary transition-colors">Trychologia</h3>
          <p class="font-body text-sm text-text-muted leading-relaxed">Konsultacje i zabiegi na skórę głowy.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Team Philosophy / Original Image Restored -->
  <section class="py-32 bg-surface-dim relative overflow-hidden">
    <!-- Background element -->
    <div class="absolute -top-1/4 -right-1/4 w-1/2 h-full bg-primary/5 mask-organic opacity-50 z-0 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div data-scroll-fade>
          <p class="font-body text-[10px] uppercase tracking-widest text-primary mb-4">
            Doświadczenie i pasja
          </p>
          <h2 class="font-heading text-4xl sm:text-5xl lg:text-6xl text-text-main mb-8 leading-[1.1]">
            Nasz zespół <br/><span class="italic text-primary">profesjonalistów</span>
          </h2>
          
          <p class="font-body text-lg text-text-muted mb-6">
            Specjalizujemy się w różnych dziedzinach, co pozwala nam zaopiekować się 
            naszymi pacjentami w pełni. Osiągamy optymalne wyniki, zachowując najwyższe standardy.
          </p>
          
          <div class="h-px w-16 bg-primary mb-6"></div>
          
          <p class="font-body text-sm text-text-muted max-w-md mb-10 leading-relaxed">
            Dzięki doświadczeniu i ciągle poszerzanej wiedzy możemy świadczyć usługi skuteczne, 
            bezpieczne i dopasowane do Twoich indywidualnych potrzeb, niezależnie od problemu.
          </p>
          
          <a href={`/${location}/o-nas`} class="inline-flex items-center gap-4 text-primary font-body text-xs uppercase tracking-widest hover:gap-6 transition-all group">
            <span class="inline-block border border-primary/30 rounded-full px-6 py-3 group-hover:bg-primary group-hover:text-surface transition-colors">Poznaj nas bliżej</span>
          </a>
        </div>
        
        <div class="relative" data-scroll-fade>
          <!-- Additional design frames mimicking the original organic look -->
          <div class="absolute -bottom-6 -left-6 w-3/4 h-3/4 bg-primary/10 rounded-3xl z-0"></div>
          <div class="absolute top-4 -right-4 w-24 h-24 bg-accent/20 rounded-full z-0 blur-lg"></div>

          <img 
            src="/images/IMG_7809.jpg"
            alt="Gabinet zabiegowy Ili Clinic"
            class="w-full h-auto object-cover rounded-[2rem] shadow-2xl relative z-10"
          />
        </div>
      </div>
    </div>
  </section>


  <!-- Featured Treatments List (Interactive Accordion Style) -->
  {featuredTreatments.length > 0 && (
    <section class="py-32 bg-surface">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-16">
          <p class="font-body text-[10px] uppercase tracking-widest text-text-muted mb-4">Najpopularniejsze zabiegi</p>
          <h2 class="font-heading text-4xl sm:text-5xl text-text-main">
            Polecane zabiegi
          </h2>
        </div>

        <div class="border-t border-text-main/10 flex flex-col">
          {featuredTreatments.map(treatment => {
            const price = location === 'pruszkow' ? treatment.data.price_pruszkow : treatment.data.price_ostroleka;
            return (
              <a href={`/${location}/zabiegi/${treatment.slug}`} class="group py-8 lg:py-12 border-b border-text-main/10 flex flex-col lg:flex-row lg:items-center justify-between gap-6 hover:bg-surface/50 transition-colors w-full relative" data-scroll-fade>
                <div class="flex-1">
                  <h3 class="font-heading text-3xl text-text-main group-hover:text-primary transition-colors mb-2">{treatment.data.title}</h3>
                  <p class="font-body text-xs text-text-muted uppercase tracking-widest">{treatment.data.duration || 'Czas: Konsultacja'}</p>
                </div>
                {price && (
                  <div class="font-body text-lg text-primary tracking-wide">
                    od {price} zł
                  </div>
                )}
                <div class="hidden lg:block w-12 h-12 rounded-full border border-text-main/20 flex items-center justify-center group-hover:bg-primary group-hover:border-primary group-hover:text-surface transition-all">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Brands Minimal -->
  {brands.length > 0 && (
    <section class="py-24 bg-surface border-t border-primary/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="font-heading text-4xl sm:text-5xl text-text-main mb-4">Współpracujemy z najlepszymi</h2>
          <span class="font-body text-[10px] uppercase tracking-[0.2em] text-text-muted">Zaufane marki</span>
        </div>
        <div class="flex flex-wrap justify-center gap-12 lg:gap-24 items-center opacity-60 mix-blend-multiply">
          {brands.map(brand => (
             <img src={brand.data.logo} alt={brand.data.name} class="h-8 max-w-[120px] object-contain grayscale" loading="lazy" />
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  gsap.registerPlugin(ScrollTrigger);

  // Hero Entrance Animation
  const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });

  tl.fromTo('[data-hero-bg]', 
    { scaleY: 0, transformOrigin: 'top' }, 
    { scaleY: 1, duration: 1.5 },
    0
  )
  .fromTo('[data-hero-text]', 
    { y: '100%', rotate: 2 }, 
    { y: '0%', rotate: 0, duration: 1.2, stagger: 0.1 },
    0.5
  )
  .fromTo('[data-hero-img]',
    { scale: 0.9, opacity: 0, y: 40 },
    { scale: 1, opacity: 1, y: 0, duration: 1.5, ease: 'expo.out' },
    0.8
  );

  // Scroll Fade Elements
  const fadeElements = document.querySelectorAll('[data-scroll-fade]');
  fadeElements.forEach(el => {
    gsap.fromTo(el, 
      { opacity: 0, y: 40 },
      { 
        opacity: 1, 
        y: 0, 
        duration: 1.2, 
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 85%',
        }
      }
    );
  });
</script>
