---
import BaseLayout from '../../layouts/BaseLayout.astro';
import locations from '../../data/locations.json';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { location: 'pruszkow' } },
    { params: { location: 'ostroleka' } },
  ];
}

const { location } = Astro.params;
const locationData = locations[location as keyof typeof locations];

if (!locationData) {
  return Astro.redirect('/');
}

// Get featured treatments
const allTreatments = await getCollection('zabiegi');
const featuredTreatments = allTreatments
  .filter(t => t.data.featured && t.data.locations.includes(location))
  .slice(0, 4);

// Get partner brands
const allBrands = await getCollection('marki');
const brands = allBrands.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`Ili Clinic ${locationData.name} - Holistyczna Klinika Skóry`}
  description={`Ili Clinic ${locationData.name} - Skóra, zdrowie, relaks. Holistyczne podejście do dbania o zdrowie, ciało i duszę w ${locationData.address.city}.`}
  location={location as 'pruszkow' | 'ostroleka'}
>

  <!-- ─── HERO ──────────────────────────────────────────────── -->
  <header class="relative min-h-screen flex items-center pt-8 px-4 md:px-6">
    <div class="container mx-auto max-w-7xl relative h-full w-full">
      <div class="relative w-full h-[90vh] overflow-hidden rounded-[40px] md:rounded-[60px] shadow-2xl">
        <img
          src="/images/hero-clinic.jpg"
          alt={`Ili Clinic ${locationData.name}`}
          class="w-full h-full object-cover"
          loading="eager"
        />
        <!-- gradient: primary-colored per location via CSS var -->
        <div class="absolute inset-0 hero-overlay"></div>

        <div class="absolute inset-0 flex items-start pt-28 sm:pt-32 lg:pt-36 px-10 md:px-20 lg:px-24">
          <div class="max-w-2xl" data-hero-content>
            <span class="text-accent font-body tracking-[0.4em] uppercase text-[10px] mb-6 block font-medium">
              Ekspercka Medycyna Estetyczna · {locationData.name}
            </span>
            <h1 class="text-white text-5xl md:text-8xl leading-[1.05] mb-8 font-heading font-light">
              Pielęgnujemy Twoje Naturalne Piękno
            </h1>
            <p class="text-white/80 text-lg mb-10 max-w-md font-light leading-relaxed">
              W ili Clinic łączymy zaawansowaną technologię z artystycznym podejściem,
              aby wydobyć to, co w Tobie najpiękniejsze.
            </p>
            <a
              href={`/${location}/kontakt`}
              class="inline-block bg-primary text-surface px-10 py-4 text-xs tracking-[0.2em] uppercase font-body font-medium hover:brightness-110 transition-all active:scale-95 duration-150 rounded-full"
            >
              Rozpocznij swoją podróż
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ─── STATS & ABOUT ─────────────────────────────────────── -->
  <section class="py-32 bg-surface relative overflow-hidden">
    <div class="container mx-auto px-6 max-w-7xl">
      <div class="flex flex-col lg:flex-row items-center gap-20 lg:gap-28">

        <!-- Image + Stats overlay -->
        <div class="w-full lg:w-5/12 relative flex-shrink-0">
          <div class="relative z-10 overflow-hidden aspect-square rounded-full border-[12px] border-white shadow-[0_40px_80px_rgba(0,0,0,0.08)] group">
            <img
              src="/images/IMG_7809.jpg"
              alt="Gabinet Ili Clinic"
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
            />
          </div>

          <!-- Stats box -->
          <div class="absolute -bottom-4 -right-4 lg:right-4 z-20 bg-primary p-10 text-white shadow-2xl rounded-2xl border border-white/5" data-scroll-fade>
            <div class="mb-8">
              <div class="text-5xl font-heading text-accent font-light mb-1">150+</div>
              <div class="text-[9px] uppercase tracking-[0.3em] font-body text-white/60">Zadowolonych Pacjentów</div>
            </div>
            <div>
              <div class="text-5xl font-heading text-accent font-light mb-1">15+</div>
              <div class="text-[9px] uppercase tracking-[0.3em] font-body text-white/60">Lat Doświadczenia</div>
            </div>
          </div>
        </div>

        <!-- Text -->
        <div class="w-full lg:w-7/12" data-scroll-fade>
          <span class="text-primary font-body tracking-[0.4em] uppercase text-[10px] mb-8 block font-semibold">O Klinice</span>
          <h2 class="font-heading text-5xl md:text-6xl mb-10 leading-[1.1] font-light text-text-main">
            Wizja Nowoczesnego Piękna
          </h2>
          <div class="space-y-6 text-text-muted leading-relaxed font-light text-lg">
            <p>ili Clinic to miejsce, gdzie luksus spotyka się z nauką. Nasz zespół składa się z certyfikowanych specjalistów medycyny estetycznej, którzy wierzą w holistyczne podejście do pacjenta.</p>
            <p>Każdy zabieg poprzedzony jest szczegółową konsultacją, podczas której analizujemy potrzeby Twojej skóry i dobieramy indywidualny plan terapii.</p>
          </div>
          <div class="mt-12">
            <a class="text-text-main font-body font-medium flex items-center gap-6 group w-fit" href={`/${location}/o-nas`}>
              <span class="border-b border-primary pb-1 uppercase text-[10px] tracking-[0.2em] font-body">Poznaj nasz zespół</span>
              <div class="w-10 h-10 rounded-full border border-primary/20 flex items-center justify-center transition-all group-hover:bg-primary group-hover:border-primary">
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1 group-hover:text-surface" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── PROCESS ───────────────────────────────────────────── -->
  <section class="py-32 bg-primary text-white relative">
    <div class="container mx-auto px-6 max-w-7xl">
      <div class="flex flex-col md:flex-row justify-between items-end mb-24 gap-8">
        <div class="max-w-xl">
          <span class="text-accent font-body tracking-[0.4em] uppercase text-[10px] mb-6 block font-medium">Harmonogram Opieki</span>
          <h2 class="text-white text-5xl md:text-6xl font-heading font-light leading-tight">Jak Udoskonalamy Piękno</h2>
        </div>
        <p class="text-white/50 font-light max-w-xs text-sm leading-relaxed mb-2 font-body">
          Trzy kroki do Twojego nowego oblicza, realizowane z najwyższą precyzją.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">

        <!-- Step 01 -->
        <div class="group bg-white/5 backdrop-blur-sm p-8 lg:p-10 rounded-3xl border border-white/10 hover:bg-white/[0.08] transition-all duration-500" data-scroll-fade>
          <div class="mb-10 relative overflow-hidden aspect-[4/5] rounded-2xl">
            <img
              src="/images/Ili-3.jpg"
              alt="Konsultacja"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
            />
            <div class="absolute top-5 left-5 text-5xl font-heading text-white/25 font-light leading-none">01</div>
            <div class="absolute inset-0 bg-gradient-to-t from-primary/40 via-transparent to-transparent"></div>
          </div>
          <h3 class="text-2xl mb-3 text-accent font-heading font-light">Konsultacja</h3>
          <p class="text-white/70 font-light leading-relaxed text-sm font-body">Fundamentem każdego zabiegu jest rozmowa i analiza skóry. Rozumiemy Twoje cele i dobieramy najlepsze rozwiązania.</p>
        </div>

        <!-- Step 02 -->
        <div class="group bg-white/5 backdrop-blur-sm p-8 lg:p-10 rounded-3xl border border-white/10 hover:bg-white/[0.08] transition-all duration-500 md:translate-y-10" data-scroll-fade>
          <div class="mb-10 relative overflow-hidden aspect-[4/5] rounded-2xl">
            <img
              src="/images/zdjecie_zabiegu_16_1.jpg"
              alt="Plan zabiegowy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
            />
            <div class="absolute top-5 left-5 text-5xl font-heading text-white/25 font-light leading-none">02</div>
            <div class="absolute inset-0 bg-gradient-to-t from-primary/40 via-transparent to-transparent"></div>
          </div>
          <h3 class="text-2xl mb-3 text-accent font-heading font-light">Plan Zabiegowy</h3>
          <p class="text-white/70 font-light leading-relaxed text-sm font-body">Precyzyjne wykonanie procedury z użyciem certyfikowanych preparatów i najnowocześniejszego sprzętu.</p>
        </div>

        <!-- Step 03 -->
        <div class="group bg-white/5 backdrop-blur-sm p-8 lg:p-10 rounded-3xl border border-white/10 hover:bg-white/[0.08] transition-all duration-500 md:translate-y-20" data-scroll-fade>
          <div class="mb-10 relative overflow-hidden aspect-[4/5] rounded-2xl">
            <img
              src="/images/kwas_hialuronowy.jpg"
              alt="Opieka pozabiegowa"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000"
            />
            <div class="absolute top-5 left-5 text-5xl font-heading text-white/25 font-light leading-none">03</div>
            <div class="absolute inset-0 bg-gradient-to-t from-primary/40 via-transparent to-transparent"></div>
          </div>
          <h3 class="text-2xl mb-3 text-accent font-heading font-light">Opieka Pozabiegowa</h3>
          <p class="text-white/70 font-light leading-relaxed text-sm font-body">Zapewniamy pełne wsparcie w procesie rekonwalescencji, monitorując efekty i zalecając pielęgnację domową.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── BRAND VALUES ──────────────────────────────────────── -->
  <section class="py-40 bg-surface">
    <div class="container mx-auto px-6 max-w-7xl">
      <div class="text-center mb-24" data-scroll-fade>
        <span class="text-primary font-body tracking-[0.4em] uppercase text-[10px] mb-6 block font-medium">Nasze Atuty</span>
        <h2 class="text-text-main text-5xl font-heading font-light">Dlaczego My</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-0 border-y border-primary/10">

        <div class="p-14 lg:p-16 md:border-r border-primary/10 flex flex-col items-center text-center group hover:bg-surface-dim transition-colors duration-500" data-scroll-fade>
          <div class="w-16 h-16 bg-white shadow-sm flex items-center justify-center mb-10 rounded-full group-hover:scale-110 transition-transform border border-primary/5">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <h3 class="text-xl mb-5 font-heading text-text-main font-light">Indywidualne Podejście</h3>
          <p class="text-text-muted font-light text-sm leading-relaxed max-w-[220px] font-body">Nie wierzymy w uniwersalne rozwiązania. Każdy pacjent to inna historia.</p>
        </div>

        <div class="p-14 lg:p-16 md:border-r border-primary/10 border-t md:border-t-0 flex flex-col items-center text-center group hover:bg-surface-dim transition-colors duration-500" data-scroll-fade>
          <div class="w-16 h-16 bg-white shadow-sm flex items-center justify-center mb-10 rounded-full group-hover:scale-110 transition-transform border border-primary/5">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="text-xl mb-5 font-heading text-text-main font-light">Ekspercka Wiedza</h3>
          <p class="text-text-muted font-light text-sm leading-relaxed max-w-[220px] font-body">Stale podnosimy kwalifikacje na światowych kongresach medycyny estetycznej.</p>
        </div>

        <div class="p-14 lg:p-16 border-t md:border-t-0 flex flex-col items-center text-center group hover:bg-surface-dim transition-colors duration-500" data-scroll-fade>
          <div class="w-16 h-16 bg-white shadow-sm flex items-center justify-center mb-10 rounded-full group-hover:scale-110 transition-transform border border-primary/5">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="text-xl mb-5 font-heading text-text-main font-light">Najwyższa Jakość</h3>
          <p class="text-text-muted font-light text-sm leading-relaxed max-w-[220px] font-body">Pracujemy wyłącznie na preparatach marek premium o udowodnionej skuteczności.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── FEATURED TREATMENTS ──────────────────────────────── -->
  {featuredTreatments.length > 0 && (
    <section class="py-24 bg-surface-dim">
      <div class="max-w-5xl mx-auto px-6">
        <div class="mb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div>
            <span class="font-body text-[10px] uppercase tracking-[0.3em] text-primary mb-4 block font-medium">Najpopularniejsze</span>
            <h2 class="font-heading text-4xl sm:text-5xl text-text-main font-light">Polecane zabiegi</h2>
          </div>
          <a href={`/${location}/zabiegi`} class="font-body text-[10px] uppercase tracking-[0.2em] text-text-main border-b border-primary pb-1 hover:text-primary transition-colors self-start md:self-auto" data-scroll-fade>
            Pełna oferta →
          </a>
        </div>

        <div class="border-t border-primary/10 flex flex-col">
          {featuredTreatments.map(treatment => {
            const price = location === 'pruszkow' ? treatment.data.price_pruszkow : treatment.data.price_ostroleka;
            return (
              <a
                href={`/${location}/zabiegi/${treatment.id}`}
                class="group py-8 lg:py-10 border-b border-primary/10 flex flex-col lg:flex-row lg:items-center justify-between gap-4 hover:bg-surface/60 transition-colors w-full px-4 -mx-4 rounded-lg"
                data-scroll-fade
              >
                <div class="flex-1">
                  <h3 class="font-heading text-2xl sm:text-3xl text-text-main group-hover:text-primary transition-colors mb-1 font-light">{treatment.data.title}</h3>
                  <p class="font-body text-[10px] text-text-muted uppercase tracking-widest">{treatment.data.duration || 'Konsultacja'}</p>
                </div>
                {price && (
                  <div class="font-body text-base text-primary tracking-wide font-medium">
                    od {price} zł
                  </div>
                )}
                <div class="hidden lg:flex w-10 h-10 rounded-full border border-primary/20 items-center justify-center group-hover:bg-primary group-hover:border-primary group-hover:text-surface transition-all">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ─── PARTNER BRANDS ────────────────────────────────────── -->
  {brands.length > 0 && (
    <section class="py-20 bg-surface border-t border-primary/5">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-14">
          <span class="font-body text-[10px] uppercase tracking-[0.3em] text-text-muted">Zaufane Marki</span>
        </div>
        <div class="flex flex-wrap justify-center gap-10 lg:gap-20 items-center opacity-50 mix-blend-multiply">
          {brands.map(brand => (
            <img src={brand.data.logo} alt={brand.data.name} class="h-7 max-w-[110px] object-contain grayscale" loading="lazy" />
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .hero-overlay {
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--theme-primary) 75%, transparent) 0%,
      color-mix(in srgb, var(--theme-primary) 30%, transparent) 55%,
      transparent 100%
    );
  }
  /* Safety: scroll-fade elements start visible; JS will animate from partial opacity only when off-screen */
  [data-scroll-fade] { opacity: 1; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Safety: ensure hero elements become visible even if GSAP fails or takes too long
  const safetyTimeout = setTimeout(() => {
    document.querySelectorAll('[data-hero-content],[data-scroll-fade]').forEach(el => {
      (el as HTMLElement).style.opacity = '1';
      (el as HTMLElement).style.transform = 'none';
    });
  }, 2000);

  // Hero entrance
  gsap.fromTo('[data-hero-content]',
    { opacity: 0, y: 50 },
    { opacity: 1, y: 0, duration: 1.4, ease: 'power3.out', delay: 0.3 }
  );

  // Scroll fade elements — check viewport first to avoid stuck opacity:0
  document.querySelectorAll('[data-scroll-fade]').forEach(el => {
    const rect = el.getBoundingClientRect();
    const inView = rect.top < window.innerHeight && rect.bottom > 0;
    if (inView) {
      gsap.fromTo(el,
        { opacity: 0.3, y: 15 },
        { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }
      );
    } else {
      gsap.set(el, { opacity: 0, y: 35 });
      gsap.to(el, {
        opacity: 1,
        y: 0,
        duration: 1.1,
        ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 88%' },
      });
    }
  });
</script>
