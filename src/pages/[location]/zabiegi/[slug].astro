---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import locations from '../../../data/locations.json';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const treatments = await getCollection('zabiegi');
  const paths = [];

  for (const treatment of treatments) {
    for (const loc of treatment.data.locations) {
      paths.push({
        params: { location: loc, slug: treatment.slug },
        props: { treatment, location: loc },
      });
    }
  }

  return paths;
}

const { treatment, location } = Astro.props;
const locationData = locations[location as keyof typeof locations];

const price = location === 'pruszkow' 
  ? treatment.data.price_pruszkow 
  : treatment.data.price_ostroleka;

const { Content } = await treatment.render();

// Get related treatments (same category)
const allTreatments = await getCollection('zabiegi');
const relatedTreatments = allTreatments
  .filter(t => 
    t.data.category === treatment.data.category && 
    t.slug !== treatment.slug &&
    t.data.locations.includes(location)
  )
  .slice(0, 3);
---

<BaseLayout 
  title={`${treatment.data.title} - Ili Clinic ${locationData.name}`}
  description={treatment.data.description}
  location={location as 'pruszkow' | 'ostroleka'}
>
  <!-- Breadcrumbs -->
  <div class="bg-surface-cream py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm">
        <ol class="flex items-center gap-2 text-text-muted">
          <li><a href={`/${location}`} class="hover:text-primary-medical">{locationData.name}</a></li>
          <li class="text-primary-medical/40">/</li>
          <li><a href={`/${location}/zabiegi`} class="hover:text-primary-medical">Zabiegi</a></li>
          <li class="text-primary-medical/40">/</li>
          <li class="text-text-deep font-medium">{treatment.data.title}</li>
        </ol>
      </nav>
    </div>
  </div>

  <article class="py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        
        <!-- Main Content -->
        <div class="lg:col-span-2">
          <!-- Header -->
          <header class="mb-10 pb-8 border-b border-primary-medical/10">
            {treatment.data.image && (
              <div class="mb-6 aspect-[16/9] overflow-hidden rounded-sm">
                <img 
                  src={treatment.data.image} 
                  alt={treatment.data.title}
                  class="w-full h-full object-cover"
                  loading="eager"
                />
              </div>
            )}
            
            {treatment.data.category && (
              <p class="text-primary-medical font-medium mb-3 tracking-wide uppercase text-sm">
                {treatment.data.category}
              </p>
            )}
            
            <h1 class="font-heading text-3xl lg:text-4xl text-text-deep mb-4">
              {treatment.data.title}
            </h1>
            
            <p class="text-lg text-text-muted leading-relaxed">
              {treatment.data.description}
            </p>
            
            <!-- Quick Info Pills -->
            <div class="mt-6 flex flex-wrap gap-3">
              {price && (
                <span class="inline-flex items-center gap-2 bg-primary-medical/10 text-primary-medical px-4 py-2 rounded-sm text-sm font-medium">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  od {price} zł
                </span>
              )}
              {treatment.data.duration && (
                <span class="inline-flex items-center gap-2 bg-surface-cream text-text-deep px-4 py-2 rounded-sm text-sm">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {treatment.data.duration}
                </span>
              )}
              <span class="inline-flex items-center gap-2 bg-accent-gold/30 text-text-deep px-4 py-2 rounded-sm text-sm font-medium">
                ✓ Bezpłatna konsultacja
              </span>
            </div>
          </header>

          <!-- Content in Accordion Style -->
          <div class="space-y-4">
            <details class="group border border-primary-medical/10 bg-white" open>
              <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-surface-cream/50 transition-colors">
                <h2 class="font-heading text-xl text-text-deep">Opis zabiegu</h2>
                <svg class="w-5 h-5 text-primary-medical transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-5 pb-5 prose prose-lg max-w-none 
                prose-headings:font-heading prose-headings:text-text-deep prose-headings:text-lg prose-headings:mt-6 prose-headings:mb-3
                prose-p:text-text-muted prose-p:leading-relaxed prose-p:my-3
                prose-a:text-primary-medical prose-a:no-underline hover:prose-a:underline
                prose-strong:text-text-deep prose-strong:font-semibold
                prose-ul:text-text-muted prose-ul:my-3
                prose-li:marker:text-primary-medical prose-li:my-1
              ">
                <Content />
              </div>
            </details>

            <details class="group border border-primary-medical/10 bg-white">
              <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-surface-cream/50 transition-colors">
                <h2 class="font-heading text-xl text-text-deep">Dla kogo jest ten zabieg?</h2>
                <svg class="w-5 h-5 text-primary-medical transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-5 pb-5 text-text-muted">
                <p class="mb-4">Zabieg jest odpowiedni dla osób, które:</p>
                <ul class="space-y-2">
                  <li class="flex items-start gap-2">
                    <svg class="w-5 h-5 text-primary-medical shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Chcą poprawić wygląd i kondycję skóry</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-5 h-5 text-primary-medical shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Szukają bezpiecznych i sprawdzonych rozwiązań</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-5 h-5 text-primary-medical shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Cenią naturalne i subtelne efekty</span>
                  </li>
                </ul>
                <p class="mt-4 text-sm">Dokładne wskazania omówimy podczas bezpłatnej konsultacji.</p>
              </div>
            </details>

            <details class="group border border-primary-medical/10 bg-white">
              <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-surface-cream/50 transition-colors">
                <h2 class="font-heading text-xl text-text-deep">Jak przygotować się do zabiegu?</h2>
                <svg class="w-5 h-5 text-primary-medical transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-5 pb-5 text-text-muted">
                <ul class="space-y-2">
                  <li class="flex items-start gap-2">
                    <span class="text-primary-medical font-medium">1.</span>
                    <span>Umów się na bezpłatną konsultację</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-primary-medical font-medium">2.</span>
                    <span>Poinformuj nas o przyjmowanych lekach</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-primary-medical font-medium">3.</span>
                    <span>Unikaj alkoholu i aspiryny przed zabiegiem</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-primary-medical font-medium">4.</span>
                    <span>Przyjdź z czystą skórą (bez makijażu)</span>
                  </li>
                </ul>
              </div>
            </details>

            <details class="group border border-primary-medical/10 bg-white">
              <summary class="flex items-center justify-between p-5 cursor-pointer hover:bg-surface-cream/50 transition-colors">
                <h2 class="font-heading text-xl text-text-deep">Często zadawane pytania</h2>
                <svg class="w-5 h-5 text-primary-medical transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-5 pb-5">
                <div class="space-y-4">
                  <div class="border-b border-gray-100 pb-4">
                    <p class="font-medium text-text-deep mb-2">Czy zabieg jest bolesny?</p>
                    <p class="text-text-muted text-sm">Stosujemy znieczulenie miejscowe, które minimalizuje dyskomfort. Większość pacjentów opisuje zabieg jako bezbolesny lub lekko nieprzyjemny.</p>
                  </div>
                  <div class="border-b border-gray-100 pb-4">
                    <p class="font-medium text-text-deep mb-2">Jak długo utrzymują się efekty?</p>
                    <p class="text-text-muted text-sm">Czas utrzymywania się efektów zależy od rodzaju zabiegu i indywidualnych predyspozycji. Szczegóły omówimy podczas konsultacji.</p>
                  </div>
                  <div>
                    <p class="font-medium text-text-deep mb-2">Czy potrzebna jest rekonwalescencja?</p>
                    <p class="text-text-muted text-sm">Okres rekonwalescencji zależy od rodzaju zabiegu. Po niektórych zabiegach można od razu wrócić do codziennych aktywności.</p>
                  </div>
                </div>
              </div>
            </details>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-1">
          <div class="sticky top-8 space-y-6">
            
            <!-- CTA Card -->
            <div class="bg-primary-medical p-6 text-white">
              <h3 class="font-heading text-xl mb-3">Umów wizytę</h3>
              <p class="text-white/90 text-sm mb-6">
                Bezpłatna konsultacja w Ili Clinic {locationData.name}.
              </p>
              
              <div class="space-y-3">
                <a 
                  href={`tel:${locationData.phone.replace(/\s/g, '')}`}
                  class="flex items-center justify-center gap-2 bg-white text-primary-medical px-6 py-3 rounded-sm font-medium hover:bg-surface-cream transition-colors w-full"
                >
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  {locationData.phone}
                </a>
                <a 
                  href={`/${location}/kontakt`}
                  class="flex items-center justify-center gap-2 border-2 border-white/30 text-white px-6 py-3 rounded-sm font-medium hover:bg-white/10 transition-colors w-full"
                >
                  Formularz kontaktowy
                </a>
              </div>
            </div>

            <!-- Price Card -->
            <div class="bg-surface-cream p-6">
              <h3 class="font-heading text-lg text-text-deep mb-4">Szczegóły</h3>
              
              <div class="space-y-3 text-sm">
                {price && (
                  <div class="flex justify-between py-2 border-b border-primary-medical/10">
                    <span class="text-text-muted">Cena od</span>
                    <span class="font-heading text-lg text-primary-medical">{price} zł</span>
                  </div>
                )}
                
                {treatment.data.duration && (
                  <div class="flex justify-between py-2 border-b border-primary-medical/10">
                    <span class="text-text-muted">Czas zabiegu</span>
                    <span class="text-text-deep font-medium">{treatment.data.duration}</span>
                  </div>
                )}
                
                <div class="flex justify-between py-2 border-b border-primary-medical/10">
                  <span class="text-text-muted">Gabinet</span>
                  <span class="text-text-deep font-medium">{locationData.name}</span>
                </div>
                
                <div class="flex justify-between py-2">
                  <span class="text-text-muted">Konsultacja</span>
                  <span class="text-primary-medical font-medium">Bezpłatna</span>
                </div>
              </div>
            </div>

            <!-- Location Info -->
            <div class="border border-gray-100 p-6">
              <h3 class="font-heading text-lg text-text-deep mb-4">Lokalizacja</h3>
              <p class="text-text-muted text-sm mb-2">
                {locationData.address.street}<br />
                {locationData.address.postalCode} {locationData.address.city}
              </p>
              <p class="text-text-muted text-sm mb-4">
                Pon-Pt: {locationData.openingHours.weekdays}
              </p>
              <a 
                href={locationData.googleMapsUrl}
                target="_blank"
                rel="noopener"
                class="text-primary-medical text-sm hover:underline"
              >
                Zobacz na mapie →
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <!-- Related Treatments -->
  {relatedTreatments.length > 0 && (
    <section class="py-16 bg-surface-cream">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-heading text-2xl text-text-deep mb-8">
          Podobne zabiegi
        </h2>
        
        <div class="grid md:grid-cols-3 gap-6">
          {relatedTreatments.map(related => {
            const relatedPrice = location === 'pruszkow' 
              ? related.data.price_pruszkow 
              : related.data.price_ostroleka;
            
            return (
              <a 
                href={`/${location}/zabiegi/${related.slug}`}
                class="group bg-white border border-primary-medical/10 overflow-hidden hover-lift"
              >
                <div class="aspect-[16/9] bg-gradient-to-br from-primary-medical/10 to-accent-gold/10"></div>
                <div class="p-5">
                  <h3 class="font-heading text-lg text-text-deep mb-2 group-hover:text-primary-medical transition-colors">
                    {related.data.title}
                  </h3>
                  <p class="text-text-muted text-sm mb-3 line-clamp-2">
                    {related.data.description}
                  </p>
                  {relatedPrice && (
                    <span class="text-primary-medical font-medium text-sm">
                      od {relatedPrice} zł
                    </span>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Back Link -->
  <div class="py-8 border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <a 
        href={`/${location}/zabiegi`}
        class="inline-flex items-center gap-2 text-primary-medical hover:text-primary-medical-dark transition-colors"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Wróć do wszystkich zabiegów
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
  
  details summary {
    list-style: none;
  }
</style>
