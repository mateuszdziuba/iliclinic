---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import locations from '../../../data/locations.json';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const treatments = await getCollection('zabiegi');
  const paths = [];

  for (const treatment of treatments) {
    for (const loc of treatment.data.locations) {
      paths.push({
        params: { location: loc, slug: treatment.id },
        props: { treatment, location: loc },
      });
    }
  }

  return paths;
}

const { treatment, location } = Astro.props;
const locationData = locations[location as keyof typeof locations];
const salonName = (locationData as any).salonName || `ili Clinic ${locationData.name}`;
const metaTitle = treatment.data.seo?.metaTitle ?? `${treatment.data.title} ${locationData.name} | ${salonName}`;
const metaDescription = treatment.data.seo?.metaDescription ?? `${treatment.data.title} w ${salonName}. ${treatment.data.description} Umów wizytę i skorzystaj z bezpłatnej konsultacji.`;

const { Content } = await render(treatment);

// Get related treatments (same category)
const allTreatments = await getCollection('zabiegi');
const relatedTreatments = allTreatments
  .filter(t =>
    t.data.category === treatment.data.category &&
    t.id !== treatment.id &&
    t.data.locations.includes(location)
  )
  .slice(0, 3);

const siteUrl = 'https://iliclinic.pl';
const pageUrl = `${siteUrl}/${location}/zabiegi/${treatment.id}`;

const treatmentSchema = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalProcedure",
    "name": treatment.data.title,
    "description": treatment.data.description,
    "procedureType": treatment.data.category ?? "Medycyna Estetyczna",
    "followup": "Bezpłatna konsultacja po zabiegu",
    "howPerformed": treatment.data.description,
    "performer": {
      "@type": "HealthAndBeautyBusiness",
      "name": salonName,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": locationData.address.street,
        "addressLocality": locationData.address.city,
        "postalCode": locationData.address.postalCode,
        "addressCountry": "PL"
      },
      "telephone": locationData.phone,
      "url": `${siteUrl}/${location}`
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": locationData.name, "item": `${siteUrl}/${location}` },
      { "@type": "ListItem", "position": 2, "name": "Zabiegi", "item": `${siteUrl}/${location}/zabiegi` },
      { "@type": "ListItem", "position": 3, "name": treatment.data.title, "item": pageUrl }
    ]
  }
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  location={location as 'pruszkow' | 'ostroleka'}
  jsonLd={treatmentSchema}
>

  <!-- ─── BREADCRUMBS ────────────────────────────────────────── -->
  <div class="bg-surface pt-48 pb-4 border-b border-primary/10 relative z-30">
    <div class="max-w-7xl mx-auto px-6">
      <nav class="font-body text-[10px] uppercase tracking-[0.15em]">
        <ol class="flex items-center gap-3 text-text-muted">
          <li><a href={`/${location}`} class="hover:text-primary transition-colors">{locationData.name}</a></li>
          <li class="text-primary/30">/</li>
          <li><a href={`/${location}/zabiegi`} class="hover:text-primary transition-colors">Zabiegi</a></li>
          <li class="text-primary/30">/</li>
          <li class="text-text-main">{treatment.data.title}</li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- ─── EDITORIAL HERO ──────────────────────────────────────── -->
  <section class="bg-surface pt-16 lg:pt-20 pb-0 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-0 lg:gap-16 items-end">

        <!-- Left: Title block -->
        <div class="pb-8 lg:pb-16" data-hero>
          {treatment.data.category && (
            <p class="font-body text-[10px] uppercase tracking-[0.4em] text-primary mb-8 font-medium">
              {treatment.data.category}
            </p>
          )}
          <h1 class="font-heading text-3xl sm:text-4xl lg:text-6xl xl:text-7xl text-text-main leading-[0.95] tracking-[-0.02em] mb-10">
            {treatment.data.title}
          </h1>
          <p class="font-body text-lg text-text-muted leading-relaxed max-w-lg mb-10 font-light">
            {treatment.data.description}
          </p>

          <!-- Quick facts row -->
          <div class="flex flex-wrap gap-2 sm:gap-3">
            {treatment.data.duration && (
              <span class="inline-flex items-center gap-2 bg-surface-dim px-5 py-2.5 rounded-full font-body text-[10px] tracking-widest uppercase text-text-main border border-primary/10">
                <svg class="w-3.5 h-3.5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {treatment.data.duration}
              </span>
            )}
            <span class="inline-flex items-center gap-2 bg-primary/5 text-primary px-5 py-2.5 rounded-full font-body text-[10px] tracking-widest uppercase border border-primary/15">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
              </svg>
              Bezpłatna konsultacja
            </span>
          </div>
        </div>

        <!-- Right: Hero image -->
        {treatment.data.image ? (
          <div class="relative h-[40vh] lg:h-[65vh] overflow-hidden rounded-[32px] lg:rounded-[48px]" data-hero-image>
            <div class="absolute inset-0 bg-gradient-to-t from-[#8B6F47]/30 via-[#8B6F47]/10 to-transparent z-10 pointer-events-none"></div>
            <div class="absolute inset-0 bg-[#C4A882]/8 mix-blend-multiply z-10 pointer-events-none"></div>
            <img
              src={treatment.data.image}
              alt={treatment.data.title}
              class="w-full h-full object-cover"
              loading="eager"
            />
            <!-- Floating location tag -->
            <div class="absolute bottom-6 left-6 z-20 bg-surface/90 backdrop-blur-sm px-4 py-2 rounded-full border border-primary/10">
              <span class="font-body text-[9px] uppercase tracking-[0.2em] text-text-muted">
                {salonName}
              </span>
            </div>
          </div>
        ) : (
          <div class="hidden lg:block h-[40vh] bg-surface-dim rounded-[48px]"></div>
        )}

      </div>
    </div>
  </section>

  <!-- ─── BENTO CONTENT GRID ──────────────────────────────────── -->
  <section class="bg-surface pb-32">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-12 gap-6 pt-6 lg:pt-8">

        <!-- ── Description — large card, spans 8 cols ── -->
        <div class="lg:col-span-8 bg-surface-dim rounded-[32px] p-8 lg:p-12 border border-primary/8" data-scroll-fade>
          <p class="font-body text-[9px] uppercase tracking-[0.3em] text-primary mb-8 font-medium">O zabiegu</p>
          <div class="prose prose-lg max-w-none font-body
            prose-headings:font-heading prose-headings:text-text-main prose-headings:font-light prose-headings:mt-8 prose-headings:mb-4
            prose-p:text-text-muted prose-p:leading-relaxed prose-p:mb-5 prose-p:font-light
            prose-a:text-primary prose-a:underline-offset-4
            prose-strong:text-text-main prose-strong:font-medium
            prose-ul:text-text-muted prose-ul:my-5 prose-ul:list-none prose-ul:pl-0
            prose-li:relative prose-li:pl-5 prose-li:mb-2.5
            prose-li:before:content-[''] prose-li:before:absolute prose-li:before:left-0 prose-li:before:top-[0.65em] prose-li:before:w-1.5 prose-li:before:h-1.5 prose-li:before:bg-primary prose-li:before:rounded-full
          ">
            <Content />
          </div>
        </div>

        <!-- ── Sidebar stack — 4 cols ── -->
        <div class="lg:col-span-4 flex flex-col gap-6">

          <!-- Book CTA card -->
          <div class="bg-text-main rounded-[32px] p-5 sm:p-8 relative overflow-hidden group" data-scroll-fade>
            <div class="absolute inset-0 bg-primary/20 mix-blend-multiply opacity-0 group-hover:opacity-100 transition-opacity duration-700 rounded-[32px]"></div>
            <h3 class="font-heading text-xl sm:text-2xl text-surface mb-2 sm:mb-3 relative z-10 leading-tight font-light">Gotowa na<br />metamorfozę?</h3>
            <p class="font-body text-surface/50 text-xs sm:text-sm mb-4 sm:mb-7 relative z-10 font-light">
              Bezpłatna konsultacja w {salonName}.
            </p>
            <div class="space-y-2 sm:space-y-2.5 relative z-10">
              <a
                href={`tel:${locationData.phone.replace(/\s/g, '')}`}
                class="flex items-center justify-center gap-3 bg-primary text-surface px-5 py-3 sm:px-6 sm:py-3.5 rounded-full font-body text-[10px] tracking-widest uppercase hover:bg-surface hover:text-primary transition-all duration-300 w-full"
              >
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                {locationData.phone}
              </a>
              <a
                href={`/${location}/kontakt`}
                class="flex items-center justify-center border border-surface/20 text-surface px-5 py-3 sm:px-6 sm:py-3.5 rounded-full font-body text-[10px] tracking-widest uppercase hover:bg-surface/10 transition-colors w-full"
              >
                Wyślij zapytanie
              </a>
            </div>
          </div>

          <!-- Treatment info card -->
          <div class="bg-surface-dim border border-primary/10 rounded-[32px] p-8" data-scroll-fade>
            <p class="font-body text-[9px] uppercase tracking-[0.3em] text-primary mb-5 pb-4 border-b border-primary/10">
              Szczegóły
            </p>
            <div class="space-y-0">
              {treatment.data.duration && (
                <div class="flex justify-between items-center py-3.5 border-b border-primary/8">
                  <span class="font-body text-sm text-text-muted font-light">Czas zabiegu</span>
                  <span class="font-body text-sm text-text-main font-medium">{treatment.data.duration}</span>
                </div>
              )}
              <div class="flex justify-between items-center py-3.5 border-b border-primary/8">
                <span class="font-body text-sm text-text-muted font-light">Klinika</span>
                <span class="font-body text-sm text-text-main font-medium">{locationData.name}</span>
              </div>
              <div class="flex justify-between items-center py-3.5">
                <span class="font-body text-sm text-text-muted font-light">Kwalifikacja</span>
                <span class="text-primary font-body border border-primary/20 px-3 py-1 rounded-full text-[9px] uppercase tracking-widest">Wymagana</span>
              </div>
            </div>
          </div>

        </div>

        <div class="lg:col-span-6 bg-surface rounded-[32px] p-8 lg:p-10 border border-primary/10" data-scroll-fade>
          <p class="font-body text-[9px] uppercase tracking-[0.3em] text-primary mb-6 font-medium">Przygotowanie do zabiegu</p>
          <h3 class="font-heading text-2xl text-text-main mb-8 font-light">Jak się przygotować?</h3>
          <ol class="space-y-6">
            {treatment.data.przygotowanie_do_zabiegu?.map((etap, i) => (
            <li class="flex items-start gap-5">
              <span class="text-primary font-heading text-2xl leading-none font-light shrink-0 w-8">0{i + 1}</span>
              <span class="font-body text-text-muted text-sm leading-relaxed font-light pt-0.5">{etap}</span>
            </li>
            ))}
          </ol>
        </div>

        <div class="lg:col-span-3 bg-primary rounded-[32px] p-8 lg:p-10 relative overflow-hidden" data-scroll-fade>
          <div class="absolute top-0 right-0 w-48 h-48 rounded-full bg-surface/5 -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
          <p class="font-body text-[9px] uppercase tracking-[0.3em] text-surface/50 mb-6 font-medium">Dla kogo</p>
          <h3 class="font-heading text-2xl text-surface mb-8 font-light leading-snug">
            Kto skorzysta<br />na tym zabiegu?
          </h3>
          <ul class="space-y-4">
            {treatment.data.wskazania?.map(wskazanie => (
            <li class="flex items-start gap-4">
              <span class="w-5 h-5 rounded-full border border-surface/30 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-2.5 h-2.5 text-surface" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="font-body text-surface/75 text-sm leading-relaxed font-light">{wskazanie}</span>
            </li>
           ))}
          </ul>
        </div>

        <div class="lg:col-span-3 bg-surface-dim border border-primary/8 rounded-[32px] p-8 lg:p-10" data-scroll-fade>
          <p class="font-body text-[9px] uppercase tracking-[0.3em] text-primary mb-6 font-medium">Przeciwwskazania</p>
          <h3 class="font-heading text-2xl text-text-main mb-8 font-light">Kiedy odłożyć zabieg?</h3>
          <ul class="space-y-5">
            {treatment.data.przeciwwskazania?.map(wskazanie => (
            <li class="flex items-start gap-4">
              <span class="w-5 h-5 rounded-full border border-primary/20 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-2.5 h-2.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </span>
              <span class="font-body text-text-muted text-sm leading-relaxed font-light">{wskazanie}</span>
            </li>
            ))}
          </ul>
        </div>

        <!-- ── Location card — small ── -->
        <div class="lg:col-span-4 border border-primary/10 rounded-[32px] p-8 bg-surface" data-scroll-fade>
          <svg class="w-5 h-5 text-primary mb-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <h3 class="font-heading text-xl text-text-main mb-2 font-light">Zapraszamy</h3>
          <p class="font-body text-text-muted text-sm leading-relaxed mb-4 font-light">
            {locationData.address.street}<br />
            {locationData.address.postalCode} {locationData.address.city}
          </p>
          <p class="font-body text-text-muted text-xs bg-surface-dim inline-block px-4 py-2 rounded-full border border-primary/8 mb-5">
            {locationData.openingHours.weekdays}
          </p>
          <br />
          <a
            href={locationData.googleMapsUrl}
            target="_blank"
            rel="noopener"
            class="font-body text-[10px] uppercase tracking-widest text-primary border-b border-primary/30 pb-0.5 hover:border-primary transition-colors"
          >
            Otwórz w mapach
          </a>
        </div>

        <!-- ── Category / explore more card ── -->
        <div class="lg:col-span-8 border border-primary/10 rounded-[32px] p-8 lg:p-10 bg-surface flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6" data-scroll-fade>
          <div>
            <p class="font-body text-[9px] uppercase tracking-[0.3em] text-text-muted mb-3">Kategoria</p>
            <h3 class="font-heading text-2xl lg:text-3xl text-text-main font-light mb-2">
              {treatment.data.category || 'Medycyna Estetyczna'}
            </h3>
            <p class="font-body text-text-muted text-sm font-light">
              Przeglądaj wszystkie zabiegi w tej kategorii.
            </p>
          </div>
          <a
            href={`/${location}/zabiegi`}
            class="flex items-center gap-3 bg-surface-dim border border-primary/10 px-7 py-4 rounded-full font-body text-[10px] uppercase tracking-widest text-text-main hover:bg-primary hover:text-surface hover:border-primary transition-all duration-300 shrink-0"
          >
            Wszystkie zabiegi
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── RELATED TREATMENTS ────────────────────────────────── -->
  {relatedTreatments.length > 0 && (
    <section class="py-24 bg-surface-dim border-t border-primary/10">
      <div class="max-w-5xl mx-auto px-6">
        <div class="mb-16 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
          <div data-scroll-fade>
            <span class="font-body text-[10px] uppercase tracking-[0.3em] text-primary mb-4 block font-medium">Inne możliwości</span>
            <h2 class="font-heading text-4xl sm:text-5xl text-text-main font-light">Podobne zabiegi</h2>
          </div>
          <a
            href={`/${location}/zabiegi`}
            class="font-body text-[10px] uppercase tracking-[0.2em] text-text-main border-b border-primary pb-1 hover:text-primary transition-colors self-start md:self-auto"
            data-scroll-fade
          >
            Wszystkie zabiegi →
          </a>
        </div>

        <div class="border-t border-primary/10 flex flex-col" data-scroll-fade>
          {relatedTreatments.map(related => {
            return (
              <a
                href={`/${location}/zabiegi/${related.id}`}
                class="group py-8 lg:py-10 border-b border-primary/10 flex flex-col lg:flex-row lg:items-center justify-between gap-4 hover:bg-surface/60 transition-colors w-full px-4 -mx-4 rounded-lg"
              >
                <div class="flex items-center gap-6 flex-1">
                  {related.data.image && (
                    <div class="w-16 h-16 rounded-2xl overflow-hidden shrink-0 hidden sm:block">
                      <img
                        src={related.data.image}
                        alt={related.data.title}
                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div>
                    <h3 class="font-heading text-2xl sm:text-3xl text-text-main group-hover:text-primary transition-colors font-light">{related.data.title}</h3>
                    <p class="font-body text-[10px] text-text-muted uppercase tracking-widest mt-1">{related.data.category}</p>
                  </div>
                </div>
                <div class="hidden lg:flex w-10 h-10 rounded-full border border-primary/20 items-center justify-center group-hover:bg-primary group-hover:border-primary group-hover:text-surface transition-all shrink-0">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* Safety: elements start visible so they're never stuck invisible if GSAP fails */
  [data-hero],[data-hero-image],[data-scroll-fade] { opacity: 1; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initAnimations() {
    const safetyTimeout = setTimeout(() => {
      document.querySelectorAll('[data-hero],[data-hero-image],[data-scroll-fade]').forEach(el => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    }, 2000);

    // Hero entrance — staggered left/right
    gsap.fromTo('[data-hero]',
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out', delay: 0.15 }
    );
    gsap.fromTo('[data-hero-image]',
      { opacity: 0, y: 60, scale: 0.98 },
      { opacity: 1, y: 0, scale: 1, duration: 1.4, ease: 'power3.out', delay: 0.3,
        onComplete: () => clearTimeout(safetyTimeout) }
    );

    // Bento cards — check viewport first to avoid stuck opacity:0
    document.querySelectorAll('[data-scroll-fade]').forEach((el, i) => {
      const rect = el.getBoundingClientRect();
      const inView = rect.top < window.innerHeight && rect.bottom > 0;
      if (inView) {
        gsap.fromTo(el,
          { opacity: 0.3, y: 15 },
          { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', delay: i * 0.04 }
        );
      } else {
        gsap.set(el, { opacity: 0, y: 35 });
        gsap.to(el, {
          opacity: 1, y: 0, duration: 1.0, ease: 'power3.out',
          delay: i * 0.04,
          scrollTrigger: { trigger: el, start: 'top 88%' },
        });
      }
    });
  }

  // astro:page-load fires after view transition completes — safe to animate
  document.addEventListener('astro:page-load', initAnimations);
  initAnimations();
</script>
