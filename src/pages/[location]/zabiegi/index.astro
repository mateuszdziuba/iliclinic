---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import locations from '../../../data/locations.json';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { location: 'pruszkow' } },
    { params: { location: 'ostroleka' } },
  ];
}

const location = Astro.params.location as 'pruszkow' | 'ostroleka';
const locationData = locations[location as keyof typeof locations];

// Get treatments available in this location
const allTreatments = await getCollection('zabiegi');
const treatments = allTreatments.filter(t => t.data.locations.includes(location));

// Get unique categories dynamically from content
const allCategories = [...new Set(treatments.map(t => t.data.category).filter(Boolean))] as string[];

// Known categories in preferred order, then add any new ones from CMS
const knownCategoryOrder = ['Medycyna Estetyczna', 'Hi-Tech / Laser', 'Pielęgnacja Twarzy', 'Inne'];
const sortedCategories = [
  ...knownCategoryOrder.filter(c => allCategories.includes(c)),
  ...allCategories.filter(c => !knownCategoryOrder.includes(c))
];

// Prepare treatments data for client-side filtering
const treatmentsData = treatments.map(t => ({
  slug: t.slug,
  title: t.data.title,
  description: t.data.description,
  category: t.data.category,
  price: location === 'pruszkow' ? t.data.price_pruszkow : t.data.price_ostroleka,
  duration: t.data.duration,
  image: t.data.image,
  featured: t.data.featured,
}));
---

<BaseLayout 
  title={`Zabiegi - Ili Clinic ${locationData.name}`}
  description={`Oferta zabiegów medycyny estetycznej w Ili Clinic ${locationData.name}. Botoks, kwas hialuronowy, laser, mezoterapia i więcej.`}
  location={location as 'pruszkow' | 'ostroleka'}
>
  <!-- Cinematic Hero -->
  <section class="pt-32 pb-16 lg:pt-40 lg:pb-24 bg-surface text-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="font-body text-[10px] uppercase tracking-[0.2em] text-primary mb-6">
        Ili Clinic {locationData.name}
      </p>
      <h1 class="font-heading text-5xl sm:text-7xl lg:text-8xl text-text-main mb-8 leading-[0.9] tracking-[-0.02em]">
        Nasze <span class="italic text-primary">zabiegi</span>
      </h1>
      <p class="font-body text-text-muted max-w-2xl mx-auto leading-relaxed">
        Szeroki wachlarz usług medycyny estetycznej i kosmetologii. 
        Każdy zabieg poprzedzony jest bezpłatną konsultacją.
      </p>
    </div>
  </section>

  <!-- Search and Filters -->
  <section class="py-6 bg-surface/90 backdrop-blur-xl sticky top-[104px] lg:top-[96px] z-40 border-b border-primary/10 transition-all duration-300" id="filter-bar">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row gap-6 items-center justify-between">
        <!-- Search -->
        <div class="relative w-full md:w-96 group">
          <input 
            type="text" 
            id="search-input"
            placeholder="Szukaj zabiegu..."
            class="w-full pl-12 pr-6 py-3 border border-primary/20 bg-surface-dim/50 rounded-full font-body text-sm text-text-main placeholder:text-text-muted focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all"
          />
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-text-muted group-focus-within:text-primary transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        
        <!-- Category Filters -->
        <div class="flex flex-wrap gap-2 justify-center md:justify-end flex-1" id="filter-buttons">
          <button 
            data-category="all"
            class="filter-btn active px-5 py-2 text-[10px] font-body tracking-[0.1em] uppercase rounded-full transition-colors border border-primary bg-primary text-surface"
          >
            Wszystkie
          </button>
          {sortedCategories.map(category => (
            <button 
              data-category={category}
              class="filter-btn px-5 py-2 text-[10px] font-body tracking-[0.1em] uppercase rounded-full transition-colors border border-primary/20 bg-transparent text-text-muted hover:border-primary hover:text-text-main"
            >
              {category}
            </button>
          ))}
        </div>
      </div>
      
      <!-- Results count -->
      <p id="results-count" class="mt-6 font-body text-[10px] uppercase tracking-widest text-text-muted/60 text-center md:text-left">
        Znaleziono <span id="count" class="text-primary">{treatments.length}</span> zabiegów
      </p>
    </div>
  </section>

  <!-- Treatments Grid -->
  <section class="py-16 bg-surface min-h-[50vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="treatments-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-0 border-t border-l border-primary/10">
        {treatmentsData.map(treatment => (
          <a 
            href={`/${location}/zabiegi/${treatment.slug}`}
            class="treatment-card group bg-surface border-b border-r border-primary/10 flex flex-col hover:bg-surface-dim transition-colors duration-500 overflow-hidden h-[450px]"
            data-title={treatment.title.toLowerCase()}
            data-description={treatment.description.toLowerCase()}
            data-category={treatment.category}
          >
            <!-- Image Section -->
            <div class="relative h-1/2 w-full overflow-hidden bg-surface-dim border-b border-primary/10">
              {treatment.image ? (
                <img 
                  src={treatment.image} 
                  alt={treatment.title}
                  class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full bg-primary/5 flex items-center justify-center">
                   <svg class="w-12 h-12 text-primary/20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              )}
              
              <div class="absolute top-4 left-4 z-10">
                <span class="bg-surface/90 backdrop-blur-md text-primary text-[9px] uppercase tracking-[0.2em] px-3 py-1 rounded-full border border-primary/10">
                  {treatment.category}
                </span>
              </div>
              
              {treatment.featured && (
                <div class="absolute top-4 right-4 z-10">
                  <span class="bg-accent/90 backdrop-blur-md text-surface text-[9px] uppercase tracking-[0.2em] px-3 py-1 rounded-full">
                    Polecany
                  </span>
                </div>
              )}
            </div>
            
            <!-- Content Section -->
            <div class="p-8 flex flex-col flex-1 relative z-10">
              <h3 class="font-heading text-2xl text-text-main mb-3 group-hover:text-primary transition-colors leading-tight">
                {treatment.title}
              </h3>
              <p class="font-body text-text-muted text-sm leading-relaxed line-clamp-2 mb-4">
                {treatment.description}
              </p>
              
              <div class="mt-auto flex items-center justify-between pt-4 border-t border-primary/10">
                {treatment.price ? (
                  <span class="font-body text-text-main text-sm font-medium tracking-wide">
                    od {treatment.price} zł
                  </span>
                ) : <span></span>}
                {treatment.duration && (
                  <span class="font-body text-text-muted text-xs tracking-wider uppercase">
                    {treatment.duration}
                  </span>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
      
      <!-- No results message -->
      <div id="no-results" class="hidden py-32 text-center">
        <p class="font-heading text-3xl text-text-muted mb-4">Nie znaleziono zabiegów</p>
        <button id="reset-filters" class="mt-4 font-body text-xs uppercase tracking-widest text-primary border-b border-primary pb-1 hover:text-text-main transition-colors">
          Wyczyść filtry
        </button>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-32 bg-surface-dim border-t border-primary/5">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="font-heading text-4xl lg:text-5xl text-text-main mb-6">
        Potrzebujesz konsultacji?
      </h2>
      <p class="font-body text-text-muted mb-12 max-w-xl mx-auto leading-relaxed">
        Pomożemy dobrać najlepsze rozwiązanie dopasowane do Twoich potrzeb i oczekiwań.
      </p>
      <div class="flex flex-wrap justify-center gap-6">
        <a 
          href={`tel:${locationData.phone.replace(/\s/g, '')}`}
          class="inline-flex items-center justify-center bg-primary text-surface px-8 py-4 rounded-full font-body text-xs uppercase tracking-widest hover:scale-105 transition-transform"
        >
          Zadzwoń do nas
        </a>
        <a 
          href={`/${location}/kontakt`}
          class="inline-flex items-center justify-center border border-primary text-primary px-8 py-4 rounded-full font-body text-xs uppercase tracking-widest hover:bg-primary hover:text-surface transition-all"
        >
          Umów wizytę
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterButtons = document.querySelectorAll('.filter-btn');
  const treatmentCards = document.querySelectorAll('.treatment-card');
  const countElement = document.getElementById('count');
  const noResultsElement = document.getElementById('no-results');
  const treatmentsGrid = document.getElementById('treatments-grid');
  const resetButton = document.getElementById('reset-filters');
  const filterBar = document.getElementById('filter-bar');

  let activeCategory = 'all';
  let searchQuery = '';

  function filterTreatments() {
    let visibleCount = 0;

    treatmentCards.forEach(card => {
      const element = card as HTMLElement;
      const title = element.dataset.title || '';
      const description = element.dataset.description || '';
      const category = element.dataset.category || '';

      const matchesSearch = searchQuery === '' || 
        title.includes(searchQuery) || 
        description.includes(searchQuery);
      
      const matchesCategory = activeCategory === 'all' || category === activeCategory;

      if (matchesSearch && matchesCategory) {
        element.style.display = '';
        visibleCount++;
      } else {
        element.style.display = 'none';
      }
    });

    if (countElement) {
      countElement.textContent = visibleCount.toString();
    }

    if (noResultsElement && treatmentsGrid) {
      if (visibleCount === 0) {
        noResultsElement.classList.remove('hidden');
        treatmentsGrid.classList.add('hidden');
      } else {
        noResultsElement.classList.add('hidden');
        treatmentsGrid.classList.remove('hidden');
      }
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
    filterTreatments();
  });

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => {
        b.classList.remove('active', 'bg-primary', 'text-surface', 'border-primary');
        b.classList.add('bg-transparent', 'text-text-muted', 'border-primary/20');
      });
      btn.classList.add('active', 'bg-primary', 'text-surface', 'border-primary');
      btn.classList.remove('bg-transparent', 'text-text-muted', 'border-primary/20');

      activeCategory = (btn as HTMLElement).dataset.category || 'all';
      filterTreatments();
    });
  });

  resetButton?.addEventListener('click', () => {
    searchQuery = '';
    activeCategory = 'all';
    if (searchInput) searchInput.value = '';
    
    filterButtons.forEach(b => {
      b.classList.remove('active', 'bg-primary', 'text-surface', 'border-primary');
      b.classList.add('bg-transparent', 'text-text-muted', 'border-primary/20');
    });
    const allBtn = document.querySelector('[data-category="all"]');
    if (allBtn) {
      allBtn.classList.add('active', 'bg-primary', 'text-surface', 'border-primary');
      allBtn.classList.remove('bg-transparent', 'text-text-muted', 'border-primary/20');
    }
    
    filterTreatments();
  });

  // Adding shadow on scroll for sticky header if needed
  window.addEventListener('scroll', () => {
    if (window.scrollY > 150) {
      filterBar?.classList.add('shadow-[0_8px_30px_rgb(0,0,0,0.04)]');
    } else {
      filterBar?.classList.remove('shadow-[0_8px_30px_rgb(0,0,0,0.04)]');
    }
  }, { passive: true });
</script>
