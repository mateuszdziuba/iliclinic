---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import locations from '../../../data/locations.json';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { location: 'pruszkow' } },
    { params: { location: 'ostroleka' } },
  ];
}

const location = Astro.params.location as 'pruszkow' | 'ostroleka';
const locationData = locations[location as keyof typeof locations];

// Get treatments available in this location
const allTreatments = await getCollection('zabiegi');
const treatments = allTreatments.filter(t => t.data.locations.includes(location));

// Get unique categories dynamically from content
const allCategories = [...new Set(treatments.map(t => t.data.category).filter(Boolean))] as string[];

// Known categories in preferred order, then add any new ones from CMS
const knownCategoryOrder = ['Medycyna Estetyczna', 'Hi-Tech / Laser', 'Pielęgnacja Twarzy', 'Inne'];
const sortedCategories = [
  ...knownCategoryOrder.filter(c => allCategories.includes(c)),
  ...allCategories.filter(c => !knownCategoryOrder.includes(c))
];

// Prepare treatments data for client-side filtering
const treatmentsData = treatments.map(t => ({
  slug: t.id,
  title: t.data.title,
  description: t.data.description,
  category: t.data.category,
  price: location === 'pruszkow' ? t.data.price_pruszkow : t.data.price_ostroleka,
  duration: t.data.duration,
  image: t.data.image,
  featured: t.data.featured,
}));
---

<BaseLayout
  title={`Zabiegi - Ili Clinic ${locationData.name}`}
  description={`Oferta zabiegów medycyny estetycznej w Ili Clinic ${locationData.name}. Botoks, kwas hialuronowy, laser, mezoterapia i więcej.`}
  location={location as 'pruszkow' | 'ostroleka'}
>

  <!-- ─── HERO ──────────────────────────────────────────────── -->
  <section class="pt-32 pb-16 lg:pt-40 lg:pb-20 bg-surface text-center">
    <div class="max-w-7xl mx-auto px-6">
      <p class="font-body text-[10px] uppercase tracking-[0.4em] text-primary mb-6 font-medium" data-hero-label>
        Ili Clinic {locationData.name}
      </p>
      <h1 class="font-heading text-5xl sm:text-7xl lg:text-8xl text-text-main mb-8 leading-[0.9] tracking-[-0.02em]" data-hero-title>
        Nasze <em class="not-italic text-primary italic">zabiegi</em>
      </h1>
      <p class="font-body text-text-muted max-w-xl mx-auto leading-relaxed font-light" data-hero-desc>
        Szeroki wachlarz usług medycyny estetycznej i kosmetologii.
        Każdy zabieg poprzedzony jest bezpłatną konsultacją.
      </p>
    </div>
  </section>

  <!-- ─── FILTERS ────────────────────────────────────────────── -->
  <div id="filter-bar" class="sticky top-[88px] z-40 px-4 py-3 flex flex-col items-center gap-2">
    <!-- Pill container -->
    <div class="bg-white/85 backdrop-blur-xl border border-white/40 shadow-[0_8px_24px_rgba(0,0,0,0.06)] rounded-full px-5 py-2.5 flex flex-wrap items-center gap-3 w-full max-w-3xl">
      <!-- Search icon -->
      <svg class="w-3.5 h-3.5 text-text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <!-- Search input -->
      <input
        type="text"
        id="search-input"
        placeholder="Szukaj zabiegu..."
        class="flex-1 min-w-[120px] bg-transparent font-body text-xs text-text-main placeholder:text-text-muted/60 focus:outline-none"
      />
      <!-- Divider -->
      <span class="w-px h-4 bg-primary/15 shrink-0"></span>
      <!-- Category filter buttons -->
      <div class="flex items-center gap-1.5 flex-wrap" id="filter-buttons">
        <button
          data-category="all"
          class="filter-btn active px-3 py-1 text-[8px] font-body tracking-[0.1em] uppercase rounded-full transition-all bg-primary text-surface border border-primary"
        >
          Wszystkie
        </button>
        {sortedCategories.map(category => (
          <button
            data-category={category}
            class="filter-btn px-3 py-1 text-[8px] font-body tracking-[0.1em] uppercase rounded-full transition-all border border-primary/20 text-text-muted hover:border-primary hover:text-text-main"
          >
            {category}
          </button>
        ))}
      </div>
    </div>
    <!-- Results count -->
    <p id="results-count" class="font-body text-[8px] uppercase tracking-widest text-text-muted/50">
      <span id="count">{treatments.length}</span> zabiegów
    </p>
  </div>

  <!-- ─── GRID ───────────────────────────────────────────────── -->
  <section class="py-12 bg-surface min-h-[50vh]">
    <div class="max-w-7xl mx-auto px-6">
      <div id="treatments-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

        {treatmentsData.map((treatment, i) => (
          <a
            href={`/${location}/zabiegi/${treatment.slug}`}
            class="treatment-card group bg-surface-dim rounded-3xl overflow-hidden hover:shadow-lg transition-all duration-500 hover:-translate-y-1 flex flex-col border border-primary/8"
            data-title={treatment.title.toLowerCase()}
            data-description={treatment.description.toLowerCase()}
            data-category={treatment.category}
            data-card-index={i}
          >
            <!-- Image -->
            <div class="relative aspect-[4/3] overflow-hidden bg-surface rounded-t-3xl">
              {treatment.image ? (
                <img
                  src={treatment.image}
                  alt={treatment.title}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full bg-primary/5 flex items-center justify-center">
                  <svg class="w-10 h-10 text-primary/20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
              )}
              <!-- Category tag -->
              <div class="absolute top-4 left-4">
                <span class="bg-surface/90 backdrop-blur-md text-primary text-[9px] uppercase tracking-[0.2em] px-3 py-1 rounded-full border border-primary/10 font-body">
                  {treatment.category}
                </span>
              </div>
              {treatment.featured && (
                <div class="absolute top-4 right-4">
                  <span class="bg-accent/90 backdrop-blur-md text-surface text-[9px] uppercase tracking-[0.2em] px-3 py-1 rounded-full font-body">
                    Polecany
                  </span>
                </div>
              )}
              <!-- Gradient overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-surface-dim/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </div>

            <!-- Content -->
            <div class="p-7 flex flex-col flex-1">
              <h3 class="font-heading text-2xl text-text-main mb-2.5 group-hover:text-primary transition-colors leading-tight font-light">
                {treatment.title}
              </h3>
              <p class="font-body text-text-muted text-sm leading-relaxed line-clamp-2 mb-5 font-light flex-1">
                {treatment.description}
              </p>
              <div class="flex items-center justify-between pt-4 border-t border-primary/10">
                {treatment.price ? (
                  <span class="font-body text-sm text-primary font-medium">
                    od {treatment.price} zł
                  </span>
                ) : <span></span>}
                <div class="flex items-center gap-3">
                  {treatment.duration && (
                    <span class="font-body text-text-muted text-[10px] tracking-wider uppercase">
                      {treatment.duration}
                    </span>
                  )}
                  <div class="w-7 h-7 rounded-full border border-primary/20 flex items-center justify-center group-hover:bg-primary group-hover:border-primary transition-all">
                    <svg class="w-3 h-3 text-primary group-hover:text-surface transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- No results -->
      <div id="no-results" class="hidden py-32 text-center">
        <p class="font-heading text-3xl text-text-muted mb-4 font-light">Nie znaleziono zabiegów</p>
        <button id="reset-filters" class="mt-4 font-body text-xs uppercase tracking-widest text-primary border-b border-primary pb-0.5 hover:text-text-main transition-colors">
          Wyczyść filtry
        </button>
      </div>
    </div>
  </section>

  <!-- ─── CTA ───────────────────────────────────────────────── -->
  <section class="py-32 bg-surface-dim border-t border-primary/5">
    <div class="max-w-4xl mx-auto px-6 text-center" data-scroll-fade>
      <span class="text-primary font-body tracking-[0.4em] uppercase text-[10px] mb-8 block font-medium">Bezpłatna konsultacja</span>
      <h2 class="font-heading text-4xl lg:text-5xl text-text-main mb-6 font-light">
        Potrzebujesz konsultacji?
      </h2>
      <p class="font-body text-text-muted mb-12 max-w-lg mx-auto leading-relaxed font-light">
        Pomożemy dobrać najlepsze rozwiązanie dopasowane do Twoich potrzeb i oczekiwań.
      </p>
      <div class="flex flex-wrap justify-center gap-5">
        <a
          href={`tel:${locationData.phone.replace(/\s/g, '')}`}
          class="inline-flex items-center justify-center gap-3 bg-primary text-surface px-10 py-4 rounded-full font-body text-xs uppercase tracking-widest hover:brightness-110 transition-all active:scale-95"
        >
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Zadzwoń do nas
        </a>
        <a
          href={`/${location}/kontakt`}
          class="inline-flex items-center justify-center border border-primary text-primary px-10 py-4 rounded-full font-body text-xs uppercase tracking-widest hover:bg-primary hover:text-surface transition-all"
        >
          Umów wizytę
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Hero entrance
  gsap.fromTo('[data-hero-label]', { opacity: 0, y: 15 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', delay: 0.1 });
  gsap.fromTo('[data-hero-title]', { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 1.1, ease: 'power3.out', delay: 0.2 });
  gsap.fromTo('[data-hero-desc]',  { opacity: 0, y: 25 }, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', delay: 0.45 });

  // Cards stagger (visible ones only on load)
  const cards = document.querySelectorAll('.treatment-card');
  gsap.fromTo(cards,
    { opacity: 0, y: 30 },
    {
      opacity: 1,
      y: 0,
      duration: 0.7,
      ease: 'power2.out',
      stagger: 0.06,
      delay: 0.55,
    }
  );

  // CTA scroll fade
  document.querySelectorAll('[data-scroll-fade]').forEach(el => {
    gsap.fromTo(el,
      { opacity: 0, y: 35 },
      {
        opacity: 1,
        y: 0,
        duration: 1.0,
        ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 88%' },
      }
    );
  });

  // ── Filter logic ──
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const filterButtons = document.querySelectorAll('.filter-btn');
  const treatmentCards = document.querySelectorAll('.treatment-card');
  const countElement = document.getElementById('count');
  const noResultsElement = document.getElementById('no-results');
  const treatmentsGrid = document.getElementById('treatments-grid');
  const resetButton = document.getElementById('reset-filters');
  const filterBar = document.getElementById('filter-bar');

  let activeCategory = 'all';
  let searchQuery = '';

  function filterTreatments() {
    let visibleCount = 0;
    treatmentCards.forEach(card => {
      const el = card as HTMLElement;
      const title = el.dataset.title || '';
      const description = el.dataset.description || '';
      const category = el.dataset.category || '';
      const matchesSearch = searchQuery === '' || title.includes(searchQuery) || description.includes(searchQuery);
      const matchesCategory = activeCategory === 'all' || category === activeCategory;
      if (matchesSearch && matchesCategory) { el.style.display = ''; visibleCount++; }
      else { el.style.display = 'none'; }
    });
    if (countElement) countElement.textContent = visibleCount.toString();
    if (noResultsElement && treatmentsGrid) {
      noResultsElement.classList.toggle('hidden', visibleCount > 0);
      treatmentsGrid.classList.toggle('hidden', visibleCount === 0);
    }
  }

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
    filterTreatments();
  });

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => {
        b.classList.remove('active', 'bg-primary', 'text-surface', 'border-primary');
        b.classList.add('bg-transparent', 'text-text-muted', 'border-primary/20');
      });
      btn.classList.add('active', 'bg-primary', 'text-surface', 'border-primary');
      btn.classList.remove('bg-transparent', 'text-text-muted', 'border-primary/20');
      activeCategory = (btn as HTMLElement).dataset.category || 'all';
      filterTreatments();
    });
  });

  resetButton?.addEventListener('click', () => {
    searchQuery = ''; activeCategory = 'all';
    if (searchInput) searchInput.value = '';
    filterButtons.forEach(b => {
      b.classList.remove('active', 'bg-primary', 'text-surface', 'border-primary');
      b.classList.add('bg-transparent', 'text-text-muted', 'border-primary/20');
    });
    const allBtn = document.querySelector('[data-category="all"]');
    if (allBtn) {
      allBtn.classList.add('active', 'bg-primary', 'text-surface', 'border-primary');
      allBtn.classList.remove('bg-transparent', 'text-text-muted', 'border-primary/20');
    }
    filterTreatments();
  });

  window.addEventListener('scroll', () => {
    filterBar?.classList.toggle('shadow-[0_4px_20px_rgb(0,0,0,0.04)]', window.scrollY > 150);
  }, { passive: true });
</script>
