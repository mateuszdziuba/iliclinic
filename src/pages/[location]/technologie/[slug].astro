---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import locations from '../../../data/locations.json';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const technologies = await getCollection('technologie');
  const paths = [];

  for (const tech of technologies) {
    for (const loc of tech.data.locations) {
      paths.push({
        params: { location: loc, slug: tech.id },
        props: { tech, location: loc },
      });
    }
  }

  return paths;
}

const { tech, location } = Astro.props;
const locationData = locations[location as keyof typeof locations];
const { Content } = await render(tech);

// Get zabiegi that use this technology (by matching name in body or linked field)
// For now we show all zabiegi in this location as "related"
const allTreatments = await getCollection('zabiegi');
const relatedTreatments = allTreatments
  .filter(t => t.data.locations.includes(location))
  .slice(0, 3);
---

<BaseLayout
  title={`${tech.data.name} - Ili Clinic ${locationData.name}`}
  description={tech.data.description}
  location={location as 'pruszkow' | 'ostroleka'}
>

  <!-- ─── BREADCRUMBS ────────────────────────────────────────── -->
  <div class="bg-surface pt-28 pb-4 border-b border-primary/10 relative z-30">
    <div class="max-w-7xl mx-auto px-6">
      <nav class="font-body text-[10px] uppercase tracking-[0.15em]">
        <ol class="flex items-center gap-3 text-text-muted">
          <li><a href={`/${location}`} class="hover:text-primary transition-colors">{locationData.name}</a></li>
          <li class="text-primary/30">/</li>
          <li><a href={`/${location}/technologie`} class="hover:text-primary transition-colors">Technologie</a></li>
          <li class="text-primary/30">/</li>
          <li class="text-text-main">{tech.data.name}</li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- ─── EDITORIAL HERO ──────────────────────────────────────── -->
  <section class="bg-surface pt-16 lg:pt-20 pb-0 overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-0 lg:gap-16 items-end">

        <!-- Left: Title block -->
        <div class="pb-12 lg:pb-16" data-hero>
          {tech.data.category && (
            <p class="font-body text-[10px] uppercase tracking-[0.4em] text-primary mb-8 font-medium">
              {tech.data.category}
            </p>
          )}
          <h1 class="font-heading text-5xl sm:text-6xl lg:text-7xl xl:text-8xl text-text-main leading-[0.92] tracking-[-0.02em] mb-10">
            {tech.data.name}
          </h1>
          <p class="font-body text-lg text-text-muted leading-relaxed max-w-lg mb-10 font-light">
            {tech.data.description}
          </p>
          <div class="flex flex-wrap gap-3">
            {tech.data.producent && (
              <span class="inline-flex items-center gap-2 bg-surface-dim px-5 py-2.5 rounded-full font-body text-[10px] tracking-widest uppercase text-text-main border border-primary/10">
                <svg class="w-3.5 h-3.5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
                {tech.data.producent}
              </span>
            )}
            <span class="inline-flex items-center gap-2 bg-primary/5 text-primary px-5 py-2.5 rounded-full font-body text-[10px] tracking-widest uppercase border border-primary/15">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              Certyfikowana technologia
            </span>
          </div>
        </div>

        <!-- Right: Hero image -->
        {tech.data.image ? (
          <div class="relative h-[50vh] lg:h-[65vh] overflow-hidden rounded-t-[40px] lg:rounded-t-[60px]" data-hero-image>
            <div class="absolute inset-0 bg-gradient-to-t from-primary/20 via-transparent to-transparent z-10 pointer-events-none"></div>
            <img
              src={tech.data.image}
              alt={tech.data.name}
              class="w-full h-full object-cover"
              loading="eager"
            />
            <div class="absolute bottom-6 left-6 z-20 bg-surface/90 backdrop-blur-sm px-4 py-2 rounded-full border border-primary/10">
              <span class="font-body text-[9px] uppercase tracking-[0.2em] text-text-muted">
                Ili Clinic · {locationData.name}
              </span>
            </div>
          </div>
        ) : (
          <div class="hidden lg:block h-[40vh] bg-surface-dim rounded-t-[60px]"></div>
        )}

      </div>
    </div>
  </section>

  <!-- ─── BENTO CONTENT GRID ──────────────────────────────────── -->
  <section class="bg-surface pb-32">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-12 gap-6 pt-8">

        <!-- ── Description — large card ── -->
        <div class="lg:col-span-8 bg-surface-dim rounded-[32px] p-8 lg:p-12 border border-primary/8" data-scroll-fade>
          <p class="font-body text-[9px] uppercase tracking-[0.3em] text-primary mb-8 font-medium">O technologii</p>
          <div class="prose prose-lg max-w-none font-body
            prose-headings:font-heading prose-headings:text-text-main prose-headings:font-light prose-headings:mt-8 prose-headings:mb-4
            prose-p:text-text-muted prose-p:leading-relaxed prose-p:mb-5 prose-p:font-light
            prose-a:text-primary prose-a:underline-offset-4
            prose-strong:text-text-main prose-strong:font-medium
            prose-ul:text-text-muted prose-ul:my-5 prose-ul:list-none prose-ul:pl-0
            prose-li:relative prose-li:pl-5 prose-li:mb-2.5
            prose-li:before:content-[''] prose-li:before:absolute prose-li:before:left-0 prose-li:before:top-[0.65em] prose-li:before:w-1.5 prose-li:before:h-1.5 prose-li:before:bg-primary prose-li:before:rounded-full
          ">
            <Content />
          </div>
        </div>

        <!-- ── Sidebar ── -->
        <div class="lg:col-span-4 flex flex-col gap-6">

          <!-- CTA card -->
          <div class="bg-text-main rounded-[32px] p-8 relative overflow-hidden group" data-scroll-fade>
            <div class="absolute inset-0 bg-primary/20 mix-blend-multiply opacity-0 group-hover:opacity-100 transition-opacity duration-700 rounded-[32px]"></div>
            <h3 class="font-heading text-2xl text-surface mb-3 relative z-10 leading-tight font-light">Poznaj efekty<br />na własnej skórze</h3>
            <p class="font-body text-surface/50 text-sm mb-7 relative z-10 font-light">
              Bezpłatna konsultacja w {locationData.name}.
            </p>
            <div class="space-y-2.5 relative z-10">
              <a
                href={`tel:${locationData.phone.replace(/\s/g, '')}`}
                class="flex items-center justify-center gap-3 bg-primary text-surface px-6 py-3.5 rounded-full font-body text-[10px] tracking-widest uppercase hover:bg-surface hover:text-primary transition-all duration-300 w-full"
              >
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                {locationData.phone}
              </a>
              <a
                href={`/${location}/zabiegi`}
                class="flex items-center justify-center border border-surface/20 text-surface px-6 py-3.5 rounded-full font-body text-[10px] tracking-widest uppercase hover:bg-surface/10 transition-colors w-full"
              >
                Zobacz zabiegi
              </a>
            </div>
          </div>

          <!-- Info card -->
          <div class="bg-surface-dim border border-primary/10 rounded-[32px] p-8" data-scroll-fade>
            <p class="font-body text-[9px] uppercase tracking-[0.3em] text-primary mb-5 pb-4 border-b border-primary/10">
              Szczegóły
            </p>
            <div class="space-y-0">
              {tech.data.producent && (
                <div class="flex justify-between items-center py-3.5 border-b border-primary/8">
                  <span class="font-body text-sm text-text-muted font-light">Producent</span>
                  <span class="font-body text-sm text-text-main font-medium">{tech.data.producent}</span>
                </div>
              )}
              {tech.data.category && (
                <div class="flex justify-between items-center py-3.5 border-b border-primary/8">
                  <span class="font-body text-sm text-text-muted font-light">Kategoria</span>
                  <span class="font-body text-sm text-text-main font-medium">{tech.data.category}</span>
                </div>
              )}
              <div class="flex justify-between items-center py-3.5">
                <span class="font-body text-sm text-text-muted font-light">Dostępna w</span>
                <span class="font-body text-sm text-text-main font-medium">{locationData.name}</span>
              </div>
            </div>
          </div>

        </div>

        <!-- ── Related treatments card ── -->
        {relatedTreatments.length > 0 && (
          <div class="lg:col-span-12 border border-primary/10 rounded-[32px] p-8 lg:p-10 bg-surface-dim" data-scroll-fade>
            <p class="font-body text-[9px] uppercase tracking-[0.3em] text-primary mb-6 font-medium">Zabiegi wykonywane tą technologią</p>
            <div class="border-t border-primary/10 flex flex-col">
              {relatedTreatments.map(t => {
                const tPrice = location === 'pruszkow' ? t.data.price_pruszkow : t.data.price_ostroleka;
                return (
                  <a
                    href={`/${location}/zabiegi/${t.id}`}
                    class="group py-6 border-b border-primary/10 flex flex-col lg:flex-row lg:items-center justify-between gap-4 hover:bg-surface/60 transition-colors px-4 -mx-4 rounded-lg"
                  >
                    <div class="flex items-center gap-5 flex-1">
                      {t.data.image && (
                        <div class="w-14 h-14 rounded-xl overflow-hidden shrink-0 hidden sm:block">
                          <img src={t.data.image} alt={t.data.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
                        </div>
                      )}
                      <div>
                        <h3 class="font-heading text-xl text-text-main group-hover:text-primary transition-colors font-light">{t.data.title}</h3>
                        <p class="font-body text-[10px] text-text-muted uppercase tracking-widest mt-0.5">{t.data.category}</p>
                      </div>
                    </div>
                    {tPrice && <span class="font-body text-sm text-primary font-medium shrink-0">od {tPrice} zł</span>}
                    <div class="hidden lg:flex w-9 h-9 rounded-full border border-primary/20 items-center justify-center group-hover:bg-primary group-hover:border-primary group-hover:text-surface transition-all shrink-0">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </div>
                  </a>
                );
              })}
            </div>
            <div class="mt-6 pt-6 border-t border-primary/10">
              <a
                href={`/${location}/zabiegi`}
                class="font-body text-[10px] uppercase tracking-widest text-primary border-b border-primary/30 pb-0.5 hover:border-primary transition-colors inline-flex items-center gap-2"
              >
                Wszystkie zabiegi
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        )}

      </div>
    </div>
  </section>

</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.fromTo('[data-hero]',
    { opacity: 0, y: 40 },
    { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out', delay: 0.15 }
  );
  gsap.fromTo('[data-hero-image]',
    { opacity: 0, y: 60, scale: 0.98 },
    { opacity: 1, y: 0, scale: 1, duration: 1.4, ease: 'power3.out', delay: 0.3 }
  );

  document.querySelectorAll('[data-scroll-fade]').forEach((el, i) => {
    gsap.fromTo(el,
      { opacity: 0, y: 35 },
      {
        opacity: 1,
        y: 0,
        duration: 1.0,
        ease: 'power3.out',
        delay: i * 0.04,
        scrollTrigger: { trigger: el, start: 'top 88%' },
      }
    );
  });
</script>
