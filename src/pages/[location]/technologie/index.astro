---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import locations from '../../../data/locations.json';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return [
    { params: { location: 'pruszkow' } },
    { params: { location: 'ostroleka' } },
  ];
}

const location = Astro.params.location as 'pruszkow' | 'ostroleka';
const locationData = locations[location as keyof typeof locations];

const allTech = await getCollection('technologie');
const technologies = allTech.filter(t => t.data.locations.includes(location));
---

<BaseLayout
  title={`Technologie - Ili Clinic ${locationData.name}`}
  description={`Poznaj zaawansowane technologie medycyny estetycznej stosowane w Ili Clinic ${locationData.name}.`}
  location={location as 'pruszkow' | 'ostroleka'}
>

  <!-- ─── HERO ──────────────────────────────────────────────── -->
  <section class="pt-32 pb-16 lg:pt-40 lg:pb-20 bg-surface">
    <div class="max-w-7xl mx-auto px-6">
      <p class="font-body text-[10px] uppercase tracking-[0.4em] text-primary mb-6 font-medium" data-hero-label>
        Ili Clinic {locationData.name}
      </p>
      <h1 class="font-heading text-5xl sm:text-7xl lg:text-8xl text-text-main mb-8 leading-[0.9] tracking-[-0.02em]" data-hero-title>
        Nasze <em class="not-italic text-primary italic">technologie</em>
      </h1>
      <p class="font-body text-text-muted max-w-xl leading-relaxed font-light mb-12" data-hero-desc>
        Stosujemy wyłącznie sprawdzone urządzenia i technologie certyfikowanych producentów.
        Twoje bezpieczeństwo i skuteczność zabiegów to nasz priorytet.
      </p>
      <a
        href={`/${location}/zabiegi`}
        class="font-body text-[10px] uppercase tracking-widest text-primary border-b border-primary/30 pb-0.5 hover:border-primary transition-colors inline-flex items-center gap-2"
        data-hero-desc
      >
        Zobacz zabiegi
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- ─── TECHNOLOGY GRID ────────────────────────────────────── -->
  <section class="pb-32 bg-surface">
    <div class="max-w-7xl mx-auto px-6">

      {technologies.length === 0 ? (
        <div class="text-center py-24 border-t border-primary/10">
          <p class="font-heading text-2xl text-text-muted font-light">Brak technologii dla tej lokalizacji.</p>
        </div>
      ) : (
        <div class="border-t border-primary/10 pt-8">
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="tech-grid">
            {technologies.map(tech => (
              <a
                href={`/${location}/technologie/${tech.id}`}
                class="group block rounded-[32px] overflow-hidden border border-primary/8 hover:border-primary/20 hover:-translate-y-1 hover:shadow-xl transition-all duration-500 bg-surface-dim"
                data-tech-card
              >
                <!-- Image -->
                <div class="aspect-[4/3] overflow-hidden bg-surface">
                  {tech.data.image ? (
                    <img
                      src={tech.data.image}
                      alt={tech.data.name}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <svg class="w-12 h-12 text-primary/20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                    </div>
                  )}
                </div>

                <!-- Info -->
                <div class="p-7">
                  {tech.data.category && (
                    <p class="font-body text-[9px] uppercase tracking-[0.3em] text-primary mb-3">{tech.data.category}</p>
                  )}
                  <h2 class="font-heading text-xl text-text-main group-hover:text-primary transition-colors font-light mb-2 leading-snug">
                    {tech.data.name}
                  </h2>
                  {tech.data.producent && (
                    <p class="font-body text-xs text-text-muted mb-3 font-light">{tech.data.producent}</p>
                  )}
                  <p class="font-body text-sm text-text-muted font-light leading-relaxed line-clamp-2">
                    {tech.data.description}
                  </p>
                  <div class="mt-5 flex items-center gap-2 font-body text-[9px] uppercase tracking-widest text-primary">
                    Dowiedz się więcej
                    <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

    </div>
  </section>

</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.fromTo('[data-hero-label]',
    { opacity: 0, y: 20 },
    { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', delay: 0.1 }
  );
  gsap.fromTo('[data-hero-title]',
    { opacity: 0, y: 50 },
    { opacity: 1, y: 0, duration: 1.2, ease: 'power3.out', delay: 0.2 }
  );
  gsap.fromTo('[data-hero-desc]',
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 1.0, ease: 'power3.out', delay: 0.4 }
  );

  const cards = document.querySelectorAll('[data-tech-card]');
  cards.forEach((card, i) => {
    gsap.fromTo(card,
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: 'power3.out',
        delay: i * 0.06,
        scrollTrigger: { trigger: card, start: 'top 90%' },
      }
    );
  });
</script>
